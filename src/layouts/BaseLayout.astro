---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CloudflareAnalytics from "../components/analytics/CloudflareAnalytics.astro";
import { siteConfig } from "../config/site";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props { title?: string; description?: string; noindex?: boolean; ogImage?: string; ogImageAlt?: string; }
const { title = siteConfig.name, description = siteConfig.description, noindex = false, ogImage = "/og/default.png", ogImageAlt = title } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
const ogImageUrl = new URL(ogImage, siteConfig.url).toString();
const webSiteJson = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteConfig.url,
  inLanguage: "ja-JP",
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b5bd3" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-v3-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-v3-16x16.png?v=3" />
    <link rel="shortcut icon" href="/favicon-v3.ico?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(webSiteJson)} />
  </head>
  <body><Header /><main><slot /></main><Footer /><CloudflareAnalytics /></body>
</html>
