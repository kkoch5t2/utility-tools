---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tools } from "../../config/tools";
import { categoryMeta, type CategoryMeta } from "../../config/categories";
import { siteConfig } from "../../config/site";
import { gameMeta } from "../../config/games";
import popularDataRaw from "../../data/popular-tools.json";

export function getStaticPaths() {
  return categoryMeta.map((category) => ({
    params: { category: category.key },
    props: { category },
  }));
}

interface Props { category: CategoryMeta; }
const { category } = Astro.props;
const categoryTools = tools.filter((tool) => tool.status === "available" && tool.category === category.key);
const canonical = new URL(`/category/${category.key}/`, siteConfig.url).toString();
const relatedCategoryKeys: Record<CategoryMeta["key"], CategoryMeta["key"][]> = {
  image: ["pdf", "qr", "video"],
  csv: ["json", "developer", "text"],
  json: ["csv", "developer", "text"],
  text: ["japanese", "developer", "json"],
  pdf: ["image", "qr", "text"],
  qr: ["image", "developer", "text"],
  video: ["image", "developer", "pdf"],
  japanese: ["text", "date", "developer"],
  date: ["calculator", "share", "japanese"],
  calculator: ["date", "share", "developer"],
  developer: ["security", "json", "text"],
  security: ["developer", "text", "pdf"],
  japan: ["japanese", "date", "calculator"],
  office: ["text", "date", "calculator"],
  game: ["calculator", "share", "text"],
  share: ["date", "calculator", "text"],
};
const relatedCategories = relatedCategoryKeys[category.key]
  .map((key) => categoryMeta.find((item) => item.key === key))
  .filter((item): item is CategoryMeta => Boolean(item));

const gameCards = gameMeta
  .map((info) => {
    const tool = categoryTools.find((candidate) => candidate.id === info.id);
    return tool ? { ...info, tool } : null;
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

const popularData = popularDataRaw as { periodDays: number; items: Array<{ path: string }> };
const popularGames = popularData.items
  .map((item) => gameCards.find((game) => game.href === item.path))
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .slice(0, 3);
const gameSpotlight = popularGames.length ? popularGames : gameCards.filter((game) => game.featured).slice(0, 3);

const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: siteConfig.url + "/" },
    { "@type": "ListItem", position: 2, name: category.label, item: canonical },
  ],
};

const collectionJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: category.title,
  url: canonical,
  description: category.description,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: categoryTools.length,
    itemListElement: categoryTools.map((tool, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: tool.name,
      url: new URL(tool.href, siteConfig.url).toString(),
    })),
  },
};
---
<BaseLayout title={category.title} description={category.description} ogImage={`/og/${category.key}.png`} ogImageAlt={`${category.label}ツール｜${siteConfig.name}`}>
  <div class:list={["shell","category-page",{ "game-category-page": category.key === "game" }]}>
    <nav class="breadcrumbs" aria-label="パンくず">
      <a href="/">ホーム</a><span>/</span><span>{category.label}</span>
    </nav>

    {category.key === "game" ? (
      <>
        <header class="game-hub-hero">
          <div class="game-hub-copy">
            <p class="game-hub-kicker">PLAY IN YOUR BROWSER</p>
            <h1>無料ブラウザゲーム</h1>
            <p>インストール不要。スマホでもPCでも、開いたらすぐ遊べるミニゲームを集めました。</p>
            <div class="game-hub-summary">
              <span><strong>{gameCards.length}</strong> GAMES</span>
              <span>登録不要</span>
              <span>スマホ対応</span>
            </div>
          </div>
          <a class="game-hero-play" href="/game/lumo-sky-run/">
            <img src="/og/game-lumo-sky-run.png" alt="" width="1200" height="630" />
            <div>
              <span>FEATURED · ACTION</span>
              <strong>Lumo's Sky Run</strong>
              <p>3ステージの横スクロールアクション</p>
              <b>PLAY NOW →</b>
            </div>
          </a>
        </header>

        <section class="game-recent" data-recent-games hidden aria-labelledby="game-recent-title">
          <div class="game-section-heading">
            <div><p>CONTINUE</p><h2 id="game-recent-title">最近遊んだゲーム</h2></div>
            <button type="button" data-clear-recent-games>履歴を消す</button>
          </div>
          <div class="game-mini-grid" data-recent-game-grid></div>
        </section>

        <section class="game-spotlight" aria-labelledby="game-popular-title">
          <div class="game-section-heading">
            <div><p>HOT GAMES</p><h2 id="game-popular-title">{popularGames.length ? "人気ゲーム" : "おすすめゲーム"}</h2></div>
            {popularGames.length > 0 && <span>過去{popularData.periodDays}日</span>}
          </div>
          <div class="spotlight-grid">
            {gameSpotlight.map((game, index) => (
              <a class="spotlight-card" href={game.href}>
                <img src={game.thumbnail} alt="" width="1200" height="630" loading="eager" />
                <div class="spotlight-copy">
                  <span>{popularGames.length ? `#${index + 1} · ${game.genre}` : game.genre}</span>
                  <strong>{game.name}</strong>
                  <p>{game.tagline}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="all-games" aria-labelledby="all-games-title">
          <div class="game-section-heading">
            <div><p>ALL GAMES</p><h2 id="all-games-title">ゲームを選ぶ</h2></div>
            <span>{gameCards.length}本</span>
          </div>
          <div class="game-filter-chips" aria-label="ゲームジャンル">
            <button type="button" data-game-filter="all" aria-pressed="true">すべて</button>
            {[...new Set(gameCards.map((game) => game.genre))].map((genre) => <button type="button" data-game-filter={genre} aria-pressed="false">{genre}</button>)}
          </div>
          <div class="game-card-grid" data-game-grid>
            {gameCards.map((game) => (
              <article class="game-hub-card" data-game-card data-genre={game.genre}>
                <a class="game-card-image" href={game.href}>
                  <img src={game.thumbnail} alt="" width="1200" height="630" loading="lazy" />
                  <span class="play-badge">PLAY</span>
                </a>
                <div class="game-card-body">
                  <div class="game-meta-row"><span>{game.genre}</span><span>{game.playTime}</span></div>
                  <h3>{game.name}</h3>
                  <p>{game.tagline}</p>
                  <div class="game-control">{game.control}</div>
                  <a class="game-open" href={game.href}>ゲームを開く <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
        </section>
      </>
    ) : (
      <>
        <header class="category-heading">
          <p class="eyebrow">{category.key.toUpperCase()}</p>
          <h1>{category.label}ツール一覧</h1>
          <p>{category.description}</p>
          <div class="category-summary">
            <strong>{categoryTools.length}</strong>
            <span>種類のツール</span>
            <span class="dot">•</span>
            <span>無料・登録不要</span>
          </div>
        </header>

        <section class="category-usecases" aria-labelledby="category-usecases-title">
          <h2 id="category-usecases-title">{category.label}ツールはこんなときに便利</h2>
          <ul>{category.useCases.map((useCase) => <li>{useCase}</li>)}</ul>
        </section>

        <section aria-labelledby="category-tools-title">
          <h2 id="category-tools-title" class="visually-hidden">{category.label}ツール</h2>
          <div class="category-grid">
            {categoryTools.map((tool) => (
              <article class="category-card">
                <div>
                  <span class="category-tag">{category.key.toUpperCase()}</span>
                  <h3>{tool.name}</h3>
                  <p>{tool.description}</p>
                </div>
                <a href={tool.href} aria-label={`${tool.name}を開く`}>ツールを開く <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        </section>

        <section class="related-categories" aria-labelledby="related-categories-title">
          <h2 id="related-categories-title">関連カテゴリ</h2>
          <div class="related-category-grid">
            {relatedCategories.map((item) => (
              <a href={`/category/${item.key}/`}>
                <strong>{item.label}</strong>
                <span>{item.description}</span>
              </a>
            ))}
          </div>
        </section>
      </>
    )}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJson)} />

  {category.key === "game" && (
    <script define:vars={{ gameClientMeta: gameCards.map(({ id, href, name, genre, playTime, thumbnail }) => ({ id, href, name, genre, playTime, thumbnail })) }}>
      const recentKey = "utility-tools:recent";
      const meta = gameClientMeta;
      const section = document.querySelector("[data-recent-games]");
      const grid = document.querySelector("[data-recent-game-grid]");
      const clear = document.querySelector("[data-clear-recent-games]");
      function renderRecentGames() {
        if (!section || !grid) return;
        let saved = [];
        try { saved = JSON.parse(localStorage.getItem(recentKey) || "[]"); } catch {}
        const games = Array.isArray(saved)
          ? saved.map((item) => meta.find((game) => game.id === item?.id)).filter(Boolean).slice(0, 4)
          : [];
        section.hidden = games.length === 0;
        grid.innerHTML = games.map((game) =>
          '<a href="' + game.href + '"><img src="' + game.thumbnail + '" alt=""><span><b>' + game.name + '</b><small>' + game.genre + ' · ' + game.playTime + '</small></span></a>'
        ).join("");
      }
      renderRecentGames();
      clear?.addEventListener("click", () => {
        try {
          const saved = JSON.parse(localStorage.getItem(recentKey) || "[]");
          const keep = Array.isArray(saved) ? saved.filter((item) => !meta.some((game) => game.id === item?.id)) : [];
          localStorage.setItem(recentKey, JSON.stringify(keep));
        } catch {}
        renderRecentGames();
      });

      const filterButtons = document.querySelectorAll("[data-game-filter]");
      const gameCards = document.querySelectorAll("[data-game-card]");
      filterButtons.forEach((button) => button.addEventListener("click", () => {
        const genre = button.getAttribute("data-game-filter") || "all";
        filterButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        gameCards.forEach((card) => {
          card.hidden = genre !== "all" && card.getAttribute("data-genre") !== genre;
        });
      }));
    </script>
  )}
</BaseLayout>
<style>
  .category-page { padding-top: 32px; }
  .category-heading { max-width: 820px; margin: 26px 0 34px; }
  .category-heading h1 { margin: 4px 0 12px; font-size: clamp(30px, 5vw, 44px); line-height: 1.25; letter-spacing: -0.03em; }
  .category-heading > p:not(.eyebrow) { margin: 0; color: var(--muted); font-size: 17px; }
  .category-summary { display: flex; align-items: baseline; gap: 7px; margin-top: 16px; color: var(--muted); font-size: 13px; font-weight: 700; }
  .category-summary strong { color: var(--text); font-size: 20px; }
  .category-summary .dot { color: var(--line); margin-inline: 3px; }
  .category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .category-card { display: flex; flex-direction: column; min-height: 215px; padding: 20px; border: 1px solid var(--line); border-radius: 15px; background: var(--surface); box-shadow: 0 2px 8px rgba(15,23,42,.035); }
  .category-card > div { flex: 1; }.category-tag { display: inline-flex; padding: 3px 8px; border-radius: 999px; background: #eef5ff; color: var(--accent); font-size: 10px; font-weight: 900; letter-spacing: .05em; }
  .category-card h3 { margin: 10px 0 7px; font-size: 18px; line-height: 1.45; }.category-card p { margin: 0 0 18px; color: var(--muted); font-size: 14px; }.category-card a { display: inline-flex; align-items: center; gap: 7px; align-self: flex-start; font-size: 13px; font-weight: 800; text-decoration: none; }.category-card:hover { border-color: #c3d1e4; box-shadow: 0 10px 24px rgba(15,23,42,.06); }
  .category-usecases { margin: 0 0 34px; padding: 20px; border: 1px solid var(--line); border-radius: 15px; background: var(--surface-muted); }.category-usecases h2 { margin: 0 0 12px; font-size: 20px; }.category-usecases ul { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }.category-usecases li { position: relative; padding-left: 19px; color: var(--muted); font-size: 14px; }.category-usecases li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); font-weight: 900; }
  .related-categories { margin-top: 48px; }.related-categories h2 { margin-bottom: 14px; font-size: 22px; }.related-category-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }.related-category-grid a { display: flex; flex-direction: column; gap: 5px; padding: 16px; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); color: var(--text); text-decoration: none; }.related-category-grid a:hover { border-color: #b8c8dc; box-shadow: 0 8px 20px rgba(15,23,42,.06); }.related-category-grid strong { font-size: 15px; }.related-category-grid span { color: var(--muted); font-size: 12px; line-height: 1.6; }

  .game-category-page{padding-bottom:40px}.game-hub-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);gap:22px;align-items:stretch;margin:22px 0 38px;padding:26px;border:1px solid #1e293b;border-radius:24px;background:radial-gradient(circle at 20% 20%,rgba(34,211,238,.12),transparent 36%),linear-gradient(145deg,#07111f,#111827);color:#fff;box-shadow:0 24px 60px rgba(15,23,42,.16)}.game-hub-copy{display:flex;flex-direction:column;justify-content:center}.game-hub-kicker{margin:0 0 6px;color:#67e8f9;font-size:11px;font-weight:950;letter-spacing:.16em}.game-hub-copy h1{margin:0;font-size:clamp(36px,6vw,60px);letter-spacing:-.05em;line-height:1}.game-hub-copy>p:not(.game-hub-kicker){max-width:620px;margin:14px 0 0;color:#a9bfd4;font-size:16px;line-height:1.75}.game-hub-summary{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.game-hub-summary span{padding:7px 10px;border:1px solid rgba(148,163,184,.18);border-radius:999px;background:rgba(15,23,42,.55);color:#b9cbe0;font-size:11px;font-weight:800}.game-hub-summary strong{color:#67e8f9}
  .game-hero-play{position:relative;overflow:hidden;min-height:280px;border:1px solid rgba(103,232,249,.23);border-radius:18px;background:#020617;color:#fff;text-decoration:none}.game-hero-play>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.56;transition:transform .25s}.game-hero-play:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 18%,rgba(2,6,23,.94) 92%)}.game-hero-play>div{position:absolute;z-index:2;left:18px;right:18px;bottom:18px}.game-hero-play span{color:#67e8f9;font-size:9px;font-weight:950;letter-spacing:.11em}.game-hero-play strong{display:block;margin-top:3px;font-size:25px}.game-hero-play p{margin:4px 0 12px;color:#c0d2e5;font-size:12px}.game-hero-play b{font-size:11px;letter-spacing:.08em}.game-hero-play:hover img{transform:scale(1.035)}
  .game-section-heading{display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:13px}.game-section-heading p{margin:0 0 3px;color:#0b5bd3;font-size:10px;font-weight:950;letter-spacing:.14em}.game-section-heading h2{margin:0;font-size:24px}.game-section-heading>span,.game-section-heading>button{color:var(--muted);font-size:11px;font-weight:800}.game-section-heading>button{border:0;background:none;cursor:pointer}
  .game-recent,.game-spotlight,.all-games{margin:0 0 36px}.game-mini-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
  :global(.game-mini-grid a){display:grid;grid-template-columns:82px minmax(0,1fr);align-items:center;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--text);text-decoration:none}
  :global(.game-mini-grid img){display:block;width:82px;height:58px;object-fit:cover}
  :global(.game-mini-grid span){display:flex;min-width:0;flex-direction:column;padding:8px}
  :global(.game-mini-grid b){overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}
  :global(.game-mini-grid small){overflow:hidden;color:var(--muted);font-size:9px;text-overflow:ellipsis;white-space:nowrap}
  .spotlight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.spotlight-card{position:relative;overflow:hidden;min-height:225px;border-radius:17px;background:#020617;color:#fff;text-decoration:none;box-shadow:0 10px 30px rgba(15,23,42,.11)}.spotlight-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.74;transition:transform .2s}.spotlight-card:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(2,6,23,.02),rgba(2,6,23,.9))}.spotlight-copy{position:absolute;z-index:2;left:15px;right:15px;bottom:14px}.spotlight-copy span{color:#67e8f9;font-size:9px;font-weight:950}.spotlight-copy strong{display:block;margin:3px 0;font-size:18px}.spotlight-copy p{margin:0;color:#b9cce0;font-size:11px}.spotlight-card:hover img{transform:scale(1.04)}
  .game-filter-chips{display:flex;gap:7px;overflow-x:auto;margin-bottom:14px;padding-bottom:3px;scrollbar-width:none}.game-filter-chips::-webkit-scrollbar{display:none}.game-filter-chips button{flex:0 0 auto;padding:7px 11px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--muted);font-size:11px;font-weight:850;cursor:pointer}.game-filter-chips button[aria-pressed="true"]{border-color:#0b5bd3;background:#0b5bd3;color:#fff}.game-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.game-hub-card{overflow:hidden;border:1px solid var(--line);border-radius:17px;background:var(--surface);box-shadow:0 4px 16px rgba(15,23,42,.045)}.game-hub-card[hidden]{display:none}.game-card-image{position:relative;display:block;overflow:hidden;background:#020617}.game-card-image img{display:block;width:100%;aspect-ratio:1200/630;object-fit:cover;transition:transform .18s}.game-card-image:hover img{transform:scale(1.035)}.play-badge{position:absolute;right:10px;bottom:9px;padding:5px 8px;border-radius:999px;background:rgba(2,8,23,.78);color:#67e8f9;font-size:9px;font-weight:950;letter-spacing:.08em;backdrop-filter:blur(5px)}.game-card-body{padding:14px}.game-meta-row{display:flex;justify-content:space-between;gap:8px;color:#0b5bd3;font-size:9px;font-weight:900}.game-card-body h3{margin:5px 0 5px;font-size:18px}.game-card-body>p{min-height:36px;margin:0;color:var(--muted);font-size:12px;line-height:1.55}.game-control{display:inline-flex;margin-top:10px;padding:4px 7px;border-radius:7px;background:var(--surface-muted);color:var(--muted);font-size:9px;font-weight:800}.game-open{display:flex;justify-content:space-between;margin-top:12px;color:var(--accent);font-size:12px;font-weight:900;text-decoration:none}
  @media(max-width:900px){.category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.category-usecases ul{grid-template-columns:1fr}.game-hub-hero{grid-template-columns:1fr}.game-hero-play{min-height:250px}.spotlight-grid,.game-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.game-mini-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:640px){.category-grid,.related-category-grid{grid-template-columns:1fr}.category-card{min-height:0}.game-hub-hero{margin-top:15px;padding:16px;border-radius:18px}.game-hub-copy h1{font-size:38px}.game-hub-copy>p:not(.game-hub-kicker){font-size:13px}.game-hero-play{min-height:220px}.spotlight-grid,.game-card-grid{grid-template-columns:1fr}.game-mini-grid{grid-template-columns:1fr}.spotlight-card{min-height:205px}.game-section-heading h2{font-size:21px}.game-card-body>p{min-height:0}}
</style>
