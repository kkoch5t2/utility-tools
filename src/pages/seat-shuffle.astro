---
import ToolLayout from "../components/layout/ToolLayout.astro";
const title="席決め・座席表ジェネレーター｜ランダム席替え";
const description="参加者名と縦横の席数を入力して、席をランダムに決める無料ツールです。固定席や離したい組み合わせにも対応します。";
const faqs=[["固定席は指定できますか？","「名前=席番号」の形式で固定できます。"],["離したい人を指定できますか？","「名前,名前」の形式で指定すると、上下左右で隣り合わない配置を最大1000回試行します。"]] as const;
---
<ToolLayout title={title} description={description} name="席決め・座席表ジェネレーター" category="共有・調整" faqs={faqs}>
  <section class="tool-card seat-tool">
    <div class="field"><label for="seat-names">参加者 <span>1行に1人</span></label><textarea id="seat-names" rows="9" placeholder="田中&#10;鈴木&#10;佐藤&#10;高橋"></textarea></div>
    <div class="field-row"><div class="field"><label for="seat-rows">行</label><input id="seat-rows" type="number" min="1" max="20" value="3" /></div><div class="field"><label for="seat-cols">列</label><input id="seat-cols" type="number" min="1" max="20" value="4" /></div></div>
    <details><summary>詳細設定</summary><div class="field"><label for="seat-fixed">固定席</label><textarea id="seat-fixed" rows="3" placeholder="田中=1&#10;鈴木=8"></textarea><small>席番号は左上から1,2,3…</small></div><div class="field"><label for="seat-avoid">離したい組み合わせ</label><textarea id="seat-avoid" rows="3" placeholder="田中,鈴木&#10;佐藤,高橋"></textarea></div></details>
    <button class="button button-primary" type="button" data-run>席を決める</button><p class="error" data-error hidden></p>
    <div class="seat-grid" data-grid hidden></div>
  </section>
</ToolLayout>
<script>
const namesEl=document.querySelector<HTMLTextAreaElement>("#seat-names"),rowsEl=document.querySelector<HTMLInputElement>("#seat-rows"),colsEl=document.querySelector<HTMLInputElement>("#seat-cols"),fixedEl=document.querySelector<HTMLTextAreaElement>("#seat-fixed"),avoidEl=document.querySelector<HTMLTextAreaElement>("#seat-avoid"),grid=document.querySelector<HTMLElement>("[data-grid]"),error=document.querySelector<HTMLElement>("[data-error]");
function adjacent(a:number,b:number,cols:number){const ar=Math.floor(a/cols),ac=a%cols,br=Math.floor(b/cols),bc=b%cols;return Math.abs(ar-br)+Math.abs(ac-bc)===1}
document.querySelector("[data-run]")?.addEventListener("click",()=>{if(!namesEl||!rowsEl||!colsEl||!grid||!error)return;const names=[...new Set(namesEl.value.split(/\r?\n/).map(v=>v.trim()).filter(Boolean))].slice(0,200);const rows=Math.max(1,Math.min(20,Number(rowsEl.value)||1)),cols=Math.max(1,Math.min(20,Number(colsEl.value)||1)),seats=rows*cols;if(!names.length){error.textContent="参加者を入力してください。";error.hidden=false;return}if(names.length>seats){error.textContent="参加者数より席数が少ないです。";error.hidden=false;return}const fixed=new Map<number,string>();const fixedNames=new Set<string>();for(const line of fixedEl?.value.split(/\r?\n/)??[]){const [name,num]=line.split("=").map(v=>v.trim());const idx=Number(num)-1;if(!name)continue;if(!names.includes(name)||!Number.isInteger(idx)||idx<0||idx>=seats||fixed.has(idx)||fixedNames.has(name)){error.textContent="固定席の指定を確認してください。";error.hidden=false;return}fixed.set(idx,name);fixedNames.add(name)}const avoid=(avoidEl?.value.split(/\r?\n/)??[]).map(line=>line.split(",").map(v=>v.trim())).filter(pair=>pair.length===2&&pair[0]&&pair[1]);const freeNames=names.filter(n=>!fixedNames.has(n));const freeSeats=Array.from({length:seats},(_,i)=>i).filter(i=>!fixed.has(i));let final:string[]=[];let ok=false;for(let attempt=0;attempt<1000;attempt++){const shuffled=[...freeNames];for(let i=shuffled.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[shuffled[i],shuffled[j]]=[shuffled[j],shuffled[i]]}const arr=Array(seats).fill("");for(const [i,n] of fixed)arr[i]=n;freeSeats.forEach((seat,i)=>arr[seat]=shuffled[i]??"");const pos=new Map<string,number>();arr.forEach((n,i)=>{if(n)pos.set(n,i)});if(avoid.every(([a,b])=>!pos.has(a)||!pos.has(b)||!adjacent(pos.get(a)!,pos.get(b)!,cols))){final=arr;ok=true;break}}if(!ok){error.textContent="条件を満たす配置が見つかりませんでした。固定席・離す条件を減らしてください。";error.hidden=false;return}error.hidden=true;grid.style.gridTemplateColumns=`repeat(${cols}, minmax(0,1fr))`;grid.replaceChildren();final.forEach((name,i)=>{const seat=document.createElement("div");seat.className="seat";const no=document.createElement("small");no.textContent="席 "+(i+1);const strong=document.createElement("strong");strong.textContent=name||"空席";seat.append(no,strong);grid.append(seat)});grid.hidden=false});
</script>
<style>
.field{display:grid;gap:7px;margin-bottom:16px}.field label{font-size:13px;font-weight:800}.field label span,.field small{color:var(--muted);font-size:11px}.field textarea,.field input{width:100%;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--text);font:inherit}.field textarea{padding:11px 12px;resize:vertical}.field input{height:44px;padding:0 12px}.field-row{display:grid;grid-template-columns:repeat(2,minmax(0,160px));gap:12px}details{margin-bottom:16px;border:1px solid var(--line);border-radius:11px;padding:11px 13px}summary{cursor:pointer;font-weight:800;font-size:12px}details[open] summary{margin-bottom:14px}.error{color:#b42318;font-size:12px}.seat-grid{display:grid;gap:8px;margin-top:18px;overflow:auto}.seat{min-width:92px;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--surface-muted);text-align:center}.seat small{display:block;color:var(--muted);font-size:9px}.seat strong{display:block;margin-top:3px;font-size:12px}@media(max-width:620px){.field-row{grid-template-columns:1fr 1fr}.seat{min-width:76px}}
</style>