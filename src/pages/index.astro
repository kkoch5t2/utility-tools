---
import BaseLayout from "../layouts/BaseLayout.astro";
import PopularTools from "../components/home/PopularTools.astro";
import { tools, type ToolDefinition } from "../config/tools";
import { siteConfig } from "../config/site";
import { useCasePages } from "../config/use-cases";

const categories: Array<{ key: "all" | ToolDefinition["category"]; label: string }> = [
  { key: "all", label: "すべて" },
  { key: "image", label: "IMAGE" },
  { key: "csv", label: "CSV" },
  { key: "json", label: "JSON" },
  { key: "text", label: "TEXT" },
  { key: "pdf", label: "PDF" },
  { key: "qr", label: "QR" },
  { key: "video", label: "VIDEO" },
  { key: "japanese", label: "JAPANESE" },
  { key: "date", label: "DATE" },
  { key: "calculator", label: "CALCULATOR" },
  { key: "developer", label: "DEVELOPER" },
  { key: "share", label: "SHARE" },
];

const counts = new Map<string, number>();
for (const tool of tools) counts.set(tool.category, (counts.get(tool.category) ?? 0) + 1);
---
<BaseLayout title={siteConfig.homeTitle} description={siteConfig.description}>
  <div class="shell home">
    <header class="home-intro">
      <h1>必要な処理を、ブラウザですぐに。</h1>
      <p>無料・登録不要。ファイル処理は原則端末内、共有ツールは必要なデータだけ保存します。</p>
    </header>

    <section class="recent-tools" data-recent-tools aria-labelledby="recent-tools-title" hidden>
      <div class="recent-heading">
        <div>
          <p class="eyebrow">RECENT</p>
          <h2 id="recent-tools-title">最近使ったツール</h2>
        </div>
        <button type="button" data-recent-clear>履歴を消す</button>
      </div>
      <div class="recent-grid" data-recent-grid></div>
    </section>

    <PopularTools />

    <section class="purpose-links" aria-labelledby="purpose-links-title">
      <div class="purpose-links-heading">
        <div>
          <p class="eyebrow">BY PURPOSE</p>
          <h2 id="purpose-links-title">目的から探す</h2>
        </div>
        <a href="/use-case/">一覧を見る →</a>
      </div>
      <div class="purpose-links-grid">
        {useCasePages.map((item) => (
          <a href={`/use-case/${item.slug}/`}>
            <strong>{item.label}</strong>
            <span>{item.bullets[0]}</span>
            <em aria-hidden="true">→</em>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="tools-title">
      <div class="tools-heading">
        <h2 id="tools-title">ツール一覧</h2>
        <span class="visible-count" data-visible-count aria-live="polite">{tools.length}件</span>
      </div>

      <div class="tool-search-row">
        <label class="tool-search" for="tool-search">
          <span class="visually-hidden">ツールを検索</span>
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input id="tool-search" data-tool-search type="search" placeholder="ツール名・説明から検索" autocomplete="off" />
          <button type="button" class="search-clear" data-search-clear aria-label="検索をクリア" hidden>×</button>
        </label>
        <button class="favorites-toggle" type="button" data-favorites-only aria-pressed="false">☆ お気に入り</button>
      </div>

      <div class="filter-select-wrap">
        <label for="category-filter">カテゴリ</label>
        <select id="category-filter" data-filter-select aria-label="ツールのカテゴリで絞り込む">
          {categories.map((category) => (
            <option value={category.key}>
              {category.label}（{category.key === "all" ? tools.length : (counts.get(category.key) ?? 0)}）
            </option>
          ))}
        </select>
      </div>

      <div class="tool-grid" data-tool-grid>
        {tools.map((tool) => (
          <article
            class:list={["home-tool", tool.status === "planned" && "is-planned"]}
            data-tool-card
            data-tool-id={tool.id}
            data-tool-search-text={(tool.name + " " + tool.description).toLocaleLowerCase("ja")}
            data-category={tool.category}
          >
            <div class="tool-card-top">
              <p class="category">{tool.category.toUpperCase()}</p>
              <button class="favorite-button" type="button" data-favorite aria-label={tool.name + "をお気に入りに追加"} aria-pressed="false">☆</button>
            </div>
            <h3>{tool.name}</h3>
            <p>{tool.description}</p>
            {tool.status === "available"
              ? <a class="tool-open" href={tool.href}><span>ツールを開く</span><span aria-hidden="true">→</span></a>
              : <span class="planned">準備中</span>}
          </article>
        ))}
      </div>

      <nav class="pagination" data-pagination aria-label="ツール一覧のページ" hidden>
        <button class="page-button page-nav" type="button" data-page-prev>← 前へ</button>
        <div class="page-numbers" data-page-numbers></div>
        <button class="page-button page-nav" type="button" data-page-next>次へ →</button>
      </nav>

      <p class="no-results" data-no-results hidden>このカテゴリのツールはまだありません。</p>
    </section>
  </div>
</BaseLayout>

<script>
  const PAGE_SIZE = 12;
  const filterSelect = document.querySelector<HTMLSelectElement>("[data-filter-select]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-tool-card]"));
  const searchInput = document.querySelector<HTMLInputElement>("[data-tool-search]");
  const searchClear = document.querySelector<HTMLButtonElement>("[data-search-clear]");
  const favoritesOnlyButton = document.querySelector<HTMLButtonElement>("[data-favorites-only]");
  const count = document.querySelector<HTMLElement>("[data-visible-count]");
  const empty = document.querySelector<HTMLElement>("[data-no-results]");
  const pagination = document.querySelector<HTMLElement>("[data-pagination]");
  const pageNumbers = document.querySelector<HTMLElement>("[data-page-numbers]");
  const prev = document.querySelector<HTMLButtonElement>("[data-page-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-page-next]");
  const recentSection = document.querySelector<HTMLElement>("[data-recent-tools]");
  const recentGrid = document.querySelector<HTMLElement>("[data-recent-grid]");
  const recentClear = document.querySelector<HTMLButtonElement>("[data-recent-clear]");

  const FAVORITES_KEY = "utility-tools:favorites";
  const RECENT_KEY = "utility-tools:recent";
  let currentCategory = "all";
  let currentPage = 1;
  let currentQuery = "";
  let favoritesOnly = false;
  let favorites = new Set<string>();

  try {
    favorites = new Set(JSON.parse(localStorage.getItem(FAVORITES_KEY) ?? "[]"));
  } catch {
    favorites = new Set();
  }

  function normalized(value: string) {
    return value.toLocaleLowerCase("ja").normalize("NFKC").trim();
  }

  function matchingCards(category: string) {
    const query = normalized(currentQuery);
    return cards.filter((card) => {
      if (category !== "all" && card.dataset.category !== category) return false;
      if (favoritesOnly && !favorites.has(card.dataset.toolId ?? "")) return false;
      if (query && !normalized(card.dataset.toolSearchText ?? "").includes(query)) return false;
      return true;
    });
  }

  function syncFavoriteButtons() {
    for (const card of cards) {
      const id = card.dataset.toolId ?? "";
      const button = card.querySelector<HTMLButtonElement>("[data-favorite]");
      if (!button) continue;
      const active = favorites.has(id);
      button.textContent = active ? "★" : "☆";
      button.setAttribute("aria-pressed", String(active));
      const name = card.querySelector("h3")?.textContent ?? "このツール";
      button.setAttribute("aria-label", name + (active ? "をお気に入りから削除" : "をお気に入りに追加"));
    }
  }

  function updateUrl(push = false) {
    const url = new URL(window.location.href);
    if (currentCategory === "all") url.searchParams.delete("category");
    else url.searchParams.set("category", currentCategory);
    if (currentQuery) url.searchParams.set("q", currentQuery);
    else url.searchParams.delete("q");
    if (favoritesOnly) url.searchParams.set("favorites", "1");
    else url.searchParams.delete("favorites");
    if (currentPage === 1) url.searchParams.delete("page");
    else url.searchParams.set("page", String(currentPage));
    history[push ? "pushState" : "replaceState"](null, "", url);
  }

  function render(updateHistory = true, push = false) {
    const matched = matchingCards(currentCategory);
    const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
    currentPage = Math.min(Math.max(1, currentPage), totalPages);
    const start = (currentPage - 1) * PAGE_SIZE;
    const visibleCards = new Set(matched.slice(start, start + PAGE_SIZE));

    for (const card of cards) card.hidden = !visibleCards.has(card);
    if (filterSelect) filterSelect.value = currentCategory;
    if (searchInput && searchInput.value !== currentQuery) searchInput.value = currentQuery;
    if (searchClear) searchClear.hidden = !currentQuery;
    if (favoritesOnlyButton) favoritesOnlyButton.setAttribute("aria-pressed", String(favoritesOnly));
    syncFavoriteButtons();

    if (count) count.textContent = matched.length + "件";
    if (empty) empty.hidden = matched.length !== 0;

    if (pagination && pageNumbers && prev && next) {
      pagination.hidden = totalPages <= 1;
      prev.disabled = currentPage <= 1;
      next.disabled = currentPage >= totalPages;
      pageNumbers.replaceChildren();

      const isMobile = window.matchMedia("(max-width: 760px)").matches;
      const pageItems: Array<number | "ellipsis"> = [];
      if (!isMobile || totalPages <= 6) {
        for (let page = 1; page <= totalPages; page++) pageItems.push(page);
      } else if (currentPage <= 3) {
        pageItems.push(1, 2, 3, "ellipsis", totalPages);
      } else if (currentPage >= totalPages - 2) {
        pageItems.push(1, "ellipsis", totalPages - 2, totalPages - 1, totalPages);
      } else {
        pageItems.push(1, "ellipsis", currentPage, "ellipsis", totalPages);
      }

      for (const item of pageItems) {
        if (item === "ellipsis") {
          const ellipsis = document.createElement("span");
          ellipsis.className = "page-ellipsis";
          ellipsis.textContent = "…";
          ellipsis.setAttribute("aria-hidden", "true");
          pageNumbers.append(ellipsis);
          continue;
        }

        const button = document.createElement("button");
        button.type = "button";
        button.className = "page-button page-number";
        button.textContent = String(item);
        button.dataset.page = String(item);
        button.setAttribute("aria-label", item + "ページ目");
        if (item === currentPage) {
          button.setAttribute("aria-current", "page");
          button.disabled = true;
        }
        button.addEventListener("click", () => {
          currentPage = item;
          render(true, true);
        });
        pageNumbers.append(button);
      }
    }

    if (updateHistory) updateUrl(push);
  }

  filterSelect?.addEventListener("change", () => {
    currentCategory = filterSelect.value;
    currentPage = 1;
    render(true, true);
  });

  searchInput?.addEventListener("input", () => {
    currentQuery = searchInput.value;
    currentPage = 1;
    render(true);
  });

  searchClear?.addEventListener("click", () => {
    currentQuery = "";
    if (searchInput) {
      searchInput.value = "";
      searchInput.focus();
    }
    currentPage = 1;
    render(true, true);
  });

  favoritesOnlyButton?.addEventListener("click", () => {
    favoritesOnly = !favoritesOnly;
    currentPage = 1;
    render(true, true);
  });

  for (const card of cards) {
    const favoriteButton = card.querySelector<HTMLButtonElement>("[data-favorite]");
    favoriteButton?.addEventListener("click", () => {
      const id = card.dataset.toolId ?? "";
      if (!id) return;
      if (favorites.has(id)) favorites.delete(id);
      else favorites.add(id);
      localStorage.setItem(FAVORITES_KEY, JSON.stringify([...favorites]));
      render(false);
    });
  }

  prev?.addEventListener("click", () => {
    if (currentPage <= 1) return;
    currentPage--;
    render(true, true);
  });

  next?.addEventListener("click", () => {
    const totalPages = Math.max(1, Math.ceil(matchingCards(currentCategory).length / PAGE_SIZE));
    if (currentPage >= totalPages) return;
    currentPage++;
    render(true, true);
  });

  function renderRecent() {
    if (!recentSection || !recentGrid) return;
    let saved: Array<{ id?: string; href?: string; name?: string; category?: string }> = [];
    try {
      const parsed = JSON.parse(localStorage.getItem(RECENT_KEY) ?? "[]");
      if (Array.isArray(parsed)) saved = parsed;
    } catch {}
    const validIds = new Set(cards.map((card) => card.dataset.toolId ?? ""));
    const recent = saved.filter((item) => item?.id && validIds.has(item.id)).slice(0, 6);
    recentGrid.replaceChildren();
    for (const item of recent) {
      const link = document.createElement("a");
      link.className = "recent-card";
      link.href = item.href ?? "/";
      const copy = document.createElement("span");
      copy.className = "recent-copy";
      const strong = document.createElement("strong");
      strong.textContent = item.name ?? "ツール";
      const small = document.createElement("small");
      small.textContent = (item.category ?? "").toUpperCase();
      copy.append(strong, small);
      const arrow = document.createElement("span");
      arrow.className = "recent-arrow";
      arrow.setAttribute("aria-hidden", "true");
      arrow.textContent = "→";
      link.append(copy, arrow);
      recentGrid.append(link);
    }
    recentSection.hidden = recent.length === 0;
  }

  recentClear?.addEventListener("click", () => {
    localStorage.removeItem(RECENT_KEY);
    renderRecent();
  });

  function applyFromUrl() {
    const url = new URL(window.location.href);
    const category = url.searchParams.get("category") ?? "all";
    currentCategory = Array.from(filterSelect?.options ?? []).some((option) => option.value === category) ? category : "all";
    currentQuery = url.searchParams.get("q") ?? "";
    favoritesOnly = url.searchParams.get("favorites") === "1";
    const page = Number.parseInt(url.searchParams.get("page") ?? "1", 10);
    currentPage = Number.isFinite(page) && page > 0 ? page : 1;
    render(false);
  }

  window.addEventListener("popstate", applyFromUrl);
  window.matchMedia("(max-width: 760px)").addEventListener("change", () => render(false));
  renderRecent();
  applyFromUrl();
</script>

<style>
  .home { padding-top: 48px; }
  .home-intro { max-width: none; margin-bottom: 40px; }
  h1 { font-size: clamp(22px, 5.2vw, 52px); line-height: 1.2; letter-spacing: -0.04em; white-space: nowrap; margin: 0 0 14px; }
  .home-intro p { color: var(--muted); font-size: 18px; }

  .recent-tools { margin: 0 0 34px; }
  .recent-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .recent-heading h2 { margin: 0; font-size: 22px; }
  .recent-heading button { border: 0; background: transparent; color: var(--muted); font-size: 12px; font-weight: 800; cursor: pointer; }
  .recent-heading button:hover { color: var(--accent); }
  .recent-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; }
  .recent-card { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 13px 14px; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); color: var(--text); text-decoration: none; }
  .recent-card:hover { border-color: #b8c8dc; box-shadow: 0 8px 20px rgba(15,23,42,.06); transform: translateY(-1px); }
  .recent-copy { display: grid; flex: 1; min-width: 0; gap: 2px; }
  .recent-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; }
  .recent-copy small { color: var(--muted); font-size: 10px; font-weight: 800; letter-spacing: .04em; }
  .recent-arrow { color: var(--accent); font-weight: 900; }

  .purpose-links { margin: 0 0 42px; }
  .purpose-links-heading { display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:14px; }
  .purpose-links-heading h2 { margin:0;font-size:24px; }
  .purpose-links-heading>a { font-size:12px;font-weight:800;text-decoration:none; }
  .purpose-links-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px; }
  .purpose-links-grid>a { position:relative;display:flex;flex-direction:column;gap:4px;min-height:104px;padding:15px 42px 15px 15px;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--text);text-decoration:none; }
  .purpose-links-grid>a:hover { border-color:#b8c8dc;box-shadow:0 8px 20px rgba(15,23,42,.06);transform:translateY(-1px); }
  .purpose-links-grid strong { font-size:14px;line-height:1.4; }
  .purpose-links-grid span { color:var(--muted);font-size:11px;line-height:1.55; }
  .purpose-links-grid em { position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--accent);font-style:normal;font-weight:900; }

  .tools-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .tools-heading h2 { margin-bottom: 12px; }
  .visible-count { color: var(--muted); font-size: 14px; font-weight: 700; }

  .tool-search-row { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; }
  .tool-search { position: relative; display: flex; align-items: center; flex: 1 1 auto; max-width: 620px; }
  .tool-search input { width: 100%; min-height: 44px; padding: 9px 42px 9px 40px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--text); }
  .tool-search input:focus { border-color: var(--accent); }
  .search-icon { position: absolute; left: 14px; color: var(--muted); font-size: 20px; line-height: 1; pointer-events: none; }
  .search-clear { position: absolute; right: 8px; width: 30px; height: 30px; border: 0; border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer; font-size: 20px; }
  .search-clear:hover { background: var(--surface-muted); color: var(--text); }
  .favorites-toggle { min-height: 44px; padding: 8px 13px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--text); font-weight: 800; cursor: pointer; white-space: nowrap; }
  .favorites-toggle[aria-pressed="true"] { border-color: #d59b00; background: #fff8dc; color: #8a5d00; }

  .filter-select-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
  }
  .filter-select-wrap label {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }
  .filter-select-wrap select {
    width: min(100%, 320px);
    min-height: 42px;
    padding: 8px 38px 8px 12px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    cursor: pointer;
  }
  .filter-select-wrap select:focus {
    border-color: var(--accent);
  }

  .tool-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .home-tool {
    display: flex;
    flex-direction: column;
    min-height: 230px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, .035);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .home-tool:hover {
    transform: translateY(-3px);
    border-color: #c3d1e4;
    box-shadow: 0 12px 28px rgba(15, 23, 42, .08);
  }
  .home-tool[hidden] { display: none; }
  .tool-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .favorite-button { width: 34px; height: 34px; flex: 0 0 34px; border: 0; border-radius: 9px; background: transparent; color: #9a7211; cursor: pointer; font-size: 23px; line-height: 1; }
  .favorite-button:hover { background: #fff8dc; }
  .favorite-button[aria-pressed="true"] { color: #c58b00; }
  .home-tool h3 { margin: 8px 0 8px; line-height: 1.4; font-size: 19px; }
  .home-tool > p:not(.category) { color: var(--muted); margin-bottom: 18px; flex: 1; }
  .category {
    width: fit-content;
    margin: 0;
    padding: 3px 9px;
    border-radius: 999px;
    background: #eef5ff;
    color: var(--accent) !important;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: .04em;
  }
  .tool-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 9px;
    width: fit-content;
    min-height: 38px;
    padding: 8px 13px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .tool-open:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 5px 14px rgba(0, 94, 184, .22); }
  .tool-open span:last-child { font-size: 16px; line-height: 1; transition: transform .15s ease; }
  .tool-open:hover span:last-child { transform: translateX(3px); }
  .is-planned { opacity: .72; }
  .planned { color: var(--muted); font-weight: 700; }
  .pagination {
    width: fit-content;
    max-width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 30px auto 0;
  }
  .pagination[hidden] { display: none; }
  .page-numbers { display: flex; align-items: center; justify-content: center; gap: 4px; min-width: 0; }
  :global(.page-ellipsis) {
    width: 24px;
    text-align: center;
    color: var(--muted);
    font-size: 14px;
    font-weight: 800;
    line-height: 34px;
    flex: 0 0 auto;
  }
  .page-button {
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease, color .15s ease, transform .15s ease;
  }
  .page-nav { min-width: 72px; padding: 7px 12px; }
  .page-button:hover:not(:disabled) { border-color: #b7c6da; background: #f8fafc; color: var(--text); transform: translateY(-1px); }
  .page-button:disabled { cursor: default; opacity: .35; }

  :global(.page-number) {
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    line-height: 34px;
    text-align: center;
    cursor: pointer;
    transition: background .15s ease, color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  :global(.page-number:hover:not(:disabled)) { background: #eef3f8; color: var(--text); transform: translateY(-1px); }
  :global(.page-number[aria-current="page"]) {
    background: var(--text);
    color: #fff;
    box-shadow: 0 4px 12px rgba(15, 23, 42, .16);
  }
