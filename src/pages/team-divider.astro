---
import ToolLayout from "../components/layout/ToolLayout.astro";
const title="ランダムチーム分けツール｜名前を均等にグループ分け";
const description="名前を貼り付けてチーム数を指定するだけで、参加者をランダムかつ均等にグループ分けする無料ツールです。";
const faqs=[["何人まで使えますか？","最大200人まで分けられます。"],["同じ人数にできますか？","人数が割り切れない場合でも、チーム間の人数差が1人以内になるように分けます。"]] as const;
---
<ToolLayout title={title} description={description} name="ランダムチーム分け" category="共有・調整" faqs={faqs}>
  <section class="tool-card team-tool">
    <div class="field"><label for="team-names">参加者 <span>1行に1人</span></label><textarea id="team-names" rows="10" placeholder="田中&#10;鈴木&#10;佐藤&#10;高橋"></textarea></div>
    <div class="field-row">
      <div class="field"><label for="team-count">チーム数</label><input id="team-count" type="number" min="2" max="20" value="2" /></div>
      <div class="field"><label for="team-seed">固定用メモ（任意）</label><input id="team-seed" maxlength="60" placeholder="再現したい場合のメモ" /></div>
    </div>
    <button class="button button-primary" type="button" data-run>チーム分けする</button>
    <p class="error" data-error hidden></p>
    <div class="team-results" data-results hidden></div>
  </section>
</ToolLayout>
<script>
  const names = document.querySelector<HTMLTextAreaElement>("#team-names");
  const count = document.querySelector<HTMLInputElement>("#team-count");
  const seedInput = document.querySelector<HTMLInputElement>("#team-seed");
  const error = document.querySelector<HTMLElement>("[data-error]");
  const results = document.querySelector<HTMLElement>("[data-results]");
  function hashSeed(s:string){let h=2166136261;for(const ch of s){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0}
  function rng(seed:number){return()=>{seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  document.querySelector("[data-run]")?.addEventListener("click",()=>{
    if(!names||!count||!results||!error)return;
    const list=[...new Set(names.value.split(/\r?\n/).map(v=>v.trim()).filter(Boolean))].slice(0,200);
    const n=Math.max(2,Math.min(20,Number(count.value)||2));
    if(list.length<n){error.textContent="参加者数以上のチーム数にはできません。";error.hidden=false;results.hidden=true;return}
    error.hidden=true;
    const rand=seedInput?.value.trim()?rng(hashSeed(seedInput.value.trim())):Math.random;
    for(let i=list.length-1;i>0;i--){const j=Math.floor(rand()*(i+1));[list[i],list[j]]=[list[j],list[i]]}
    const teams=Array.from({length:n},()=>[] as string[]);
    list.forEach((name,i)=>teams[i%n].push(name));
    results.replaceChildren();
    teams.forEach((team,i)=>{const card=document.createElement("div");card.className="team-result";const h=document.createElement("h3");h.textContent="チーム "+(i+1)+"（"+team.length+"人）";const ul=document.createElement("ul");team.forEach(name=>{const li=document.createElement("li");li.textContent=name;ul.append(li)});card.append(h,ul);results.append(card)});
    results.hidden=false;
  });
</script>
<style>
.field{display:grid;gap:7px;margin-bottom:16px}.field label{font-size:13px;font-weight:800}.field label span{color:var(--muted);font-size:11px}.field textarea,.field input{width:100%;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--text);font:inherit}.field textarea{padding:11px 12px;resize:vertical}.field input{height:44px;padding:0 12px}.field-row{display:grid;grid-template-columns:160px 1fr;gap:12px}.error{color:#b42318;font-size:12px}.team-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}.team-result{padding:14px;border:1px solid var(--line);border-radius:12px;background:var(--surface-muted)}.team-result h3{margin:0 0 9px;font-size:14px}.team-result ul{margin:0;padding-left:20px}.team-result li{margin:4px 0;font-size:13px}@media(max-width:620px){.field-row,.team-results{grid-template-columns:1fr}}
</style>