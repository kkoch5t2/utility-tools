---
import { extraTools, type ExtraToolMeta } from "../config/extra-tools";
import ImageQuickTool from "../components/tools/ImageQuickTool.astro";
import CsvQuickTool from "../components/tools/CsvQuickTool.astro";
import TextQuickTool from "../components/tools/TextQuickTool.astro";
import PdfQuickTool from "../components/tools/PdfQuickTool.astro";
import QrQuickTool from "../components/tools/QrQuickTool.astro";
import VideoQuickTool from "../components/tools/VideoQuickTool.astro";
import UtilityQuickTool from "../components/tools/UtilityQuickTool.astro";
import UtilityPlusTool from "../components/tools/UtilityPlusTool.astro";
import CsvMoreTool from "../components/tools/CsvMoreTool.astro";
import GeneralMoreTool from "../components/tools/GeneralMoreTool.astro";
import DeveloperQuickTool from "../components/tools/DeveloperQuickTool.astro";
import SpecialQuickTool from "../components/tools/SpecialQuickTool.astro";
import SecurityQuickTool from "../components/tools/SecurityQuickTool.astro";
import JapanQuickTool from "../components/tools/JapanQuickTool.astro";
import OfficeQuickTool from "../components/tools/OfficeQuickTool.astro";

export function getStaticPaths() {
  return extraTools.map((meta) => ({
    params: { tool: meta.href.replace(/^\/|\/$/g, "") },
    props: { meta },
  }));
}

interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
const Component =
  meta.family === "image" ? ImageQuickTool :
  meta.family === "csv" ? CsvQuickTool :
  meta.family === "text" ? TextQuickTool :
  meta.family === "pdf" ? PdfQuickTool :
  meta.family === "qr" ? QrQuickTool :
  meta.family === "video" ? VideoQuickTool :
  meta.family === "utility" ? UtilityQuickTool :
  meta.family === "utilityplus" ? UtilityPlusTool :
  meta.family === "csvmore" ? CsvMoreTool :
  meta.family === "generalmore" ? GeneralMoreTool :
  meta.family === "special" ? SpecialQuickTool :
  meta.family === "security" ? SecurityQuickTool :
  meta.family === "japan" ? JapanQuickTool :
  meta.family === "office" ? OfficeQuickTool :
  DeveloperQuickTool;
---
<Component meta={meta} />

