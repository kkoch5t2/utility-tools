---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useCasePages } from "../../config/use-cases";
import { siteConfig } from "../../config/site";

const title = "目的から探す｜無料Web便利ツール集";
const description = "画像を軽くしたい、CSVを整理したい、PDFをまとめたいなど、やりたいことから無料Webツールを探せます。";
const canonical = new URL("/use-case/", siteConfig.url).toString();
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: siteConfig.url + "/" },
    { "@type": "ListItem", position: 2, name: "目的から探す", item: canonical },
  ],
};
const collectionJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  url: canonical,
  description,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: useCasePages.length,
    itemListElement: useCasePages.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      url: new URL(`/use-case/${item.slug}/`, siteConfig.url).toString(),
    })),
  },
};
---
<BaseLayout title={title} description={description}>
  <div class="shell purpose-index">
    <nav class="breadcrumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><span aria-current="page">目的から探す</span></nav>
    <header>
      <p class="eyebrow">BY PURPOSE</p>
      <h1>やりたいことから探す</h1>
      <p>カテゴリ名が分からなくても大丈夫。作業の目的から使えるツールをまとめて探せます。</p>
    </header>
    <div class="purpose-grid">
      {useCasePages.map((item, index) => (
        <a class="purpose-card" href={`/use-case/${item.slug}/`}>
          <span class="number">{String(index + 1).padStart(2, "0")}</span>
          <strong>{item.label}</strong>
          <span>{item.description}</span>
          <em>見る →</em>
        </a>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJson)} />
</BaseLayout>

<style>
  .purpose-index{padding-top:32px}.purpose-index header{max-width:820px;margin:26px 0 34px}
  .purpose-index h1{margin:4px 0 12px;font-size:clamp(30px,5vw,46px);letter-spacing:-.035em}
  .purpose-index header>p:not(.eyebrow){margin:0;color:var(--muted);font-size:17px;line-height:1.8}
  .purpose-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .purpose-card{display:flex;flex-direction:column;min-height:225px;padding:20px;border:1px solid var(--line);border-radius:15px;background:var(--surface);color:var(--text);text-decoration:none;box-shadow:0 2px 8px rgba(15,23,42,.035)}
  .purpose-card:hover{transform:translateY(-2px);border-color:#b8c8dc;box-shadow:0 10px 24px rgba(15,23,42,.06)}
  .number{color:var(--accent);font-size:11px;font-weight:900;letter-spacing:.08em}.purpose-card strong{margin:14px 0 8px;font-size:20px}
  .purpose-card>span:nth-of-type(2){flex:1;color:var(--muted);font-size:13px;line-height:1.7}.purpose-card em{margin-top:18px;color:var(--accent);font-size:13px;font-style:normal;font-weight:900}
  @media(max-width:900px){.purpose-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:640px){.purpose-grid{grid-template-columns:1fr}.purpose-card{min-height:0}}
</style>
