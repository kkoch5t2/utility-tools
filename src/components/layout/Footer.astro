---
import { siteConfig } from "../../config/site";
import { categoryMeta } from "../../config/categories";
---
<footer class="site-footer">
  <div class="shell footer-wrap">
    <div class="footer-inner">
      <div>
        <strong>{siteConfig.name}</strong><br />
        <span>ファイルを外部サーバーへ送信しない、軽量なWebツール集。</span>
      </div>
      <nav class="footer-links" aria-label="フッターナビゲーション">
        <a href="/use-case/">目的から探す</a>
        <a href="/privacy/">プライバシー</a>
        <a class="github-link" href="https://github.com/kkoch5t2/utility-tools" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.3c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1.1.1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.3 11.3 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z"/>
          </svg>
          <span>GitHub</span>
          <span class="external-mark" aria-hidden="true">↗</span>
        </a>
      </nav>
    </div>

    <div class="footer-related">
      <span>関連リンク</span>
      <div class="footer-related-links">
        <a class="related-link related-link-datlume" href="https://datlume.com/" target="_blank" rel="noopener noreferrer">
          <span class="related-logo"><img src="/brand/datlume.svg" alt="" width="22" height="22" /></span>
          <span class="related-copy"><strong>Datlume</strong><small>日本の公開データを見やすく可視化</small></span>
          <span class="external-mark" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <nav class="footer-categories" aria-label="ツールカテゴリ">
      {categoryMeta.map((category) => (
        <a href={`/category/${category.key}/`}>{category.label}</a>
      ))}
    </nav>
  </div>
</footer>
