---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IssueReport from "../feedback/IssueReport.astro";
import RelatedTools from "../tools/RelatedTools.astro";
import { tools } from "../../config/tools";
import { siteConfig } from "../../config/site";

interface Props {
  title: string;
  description: string;
  name: string;
  category: string;
  faqs: readonly (readonly [string, string])[];
}

const { title, description, name, category, faqs } = Astro.props;
const currentHref = Astro.url.pathname;
const currentTool = tools.find((tool) => tool.href === currentHref);
const categoryKey = currentTool?.category ?? "developer";
const toolJson = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name,
  url: new URL(currentHref, siteConfig.url).toString(),
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: siteConfig.url + "/" },
    { "@type": "ListItem", position: 2, name: category, item: `${siteConfig.url}/?category=${categoryKey}` },
    { "@type": "ListItem", position: 3, name, item: new URL(currentHref, siteConfig.url).toString() },
  ],
};
const faqJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---
<BaseLayout title={title} description={description}>
  <div class="shell page-shell">
    <nav class="breadcrumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><span>{category}</span></nav>
    <header class="tool-heading">
      <p class="eyebrow">{category}ツール</p>
      <h1>{name}</h1>
      <p>{description}</p>
    </header>
    <slot />
    <section class="content-section">
      <h2>入力内容が送信されない仕組み</h2>
      <p>選択したファイルや入力したテキストはブラウザ内で処理します。このツールから内容を外部APIへ送信する処理はありません。</p>
    </section>
    <section class="content-section">
      <h2>よくある質問</h2>
      <div class="faq-list">
        {faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </section>
    <RelatedTools currentHref={currentHref} />
    <IssueReport toolName={name} />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(toolJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJson)} />
</BaseLayout>
