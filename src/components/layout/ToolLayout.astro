---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IssueReport from "../feedback/IssueReport.astro";
import RelatedTools from "../tools/RelatedTools.astro";
import { tools } from "../../config/tools";
import { siteConfig } from "../../config/site";
import { prioritySeoContent } from "../../config/seo-content";

interface Props {
  title: string;
  description: string;
  name: string;
  category: string;
  faqs: readonly (readonly [string, string])[];
}

const { title, description, name, category, faqs } = Astro.props;
const currentHref = Astro.url.pathname;
const currentTool = tools.find((tool) => tool.href === currentHref);
const categoryKey = currentTool?.category ?? "developer";
const seoContent = prioritySeoContent[currentHref];
const inputGuide: Record<string, string> = {
  image: "画像ファイルを選び、必要なサイズや形式を設定します。",
  csv: "CSVファイルを選ぶか、対象データを入力して条件を設定します。",
  json: "JSONを貼り付け、必要に応じて変換・抽出条件を設定します。",
  text: "処理したいテキストを入力し、必要なオプションを設定します。",
  pdf: "PDFファイルを選び、対象ページや処理条件を設定します。",
  qr: "URL・テキスト・画像など、処理対象を入力または選択します。",
  video: "動画ファイルを選び、出力形式や処理条件を設定します。",
  japanese: "変換したい日本語テキストや値を入力します。",
  developer: "変換・解析したい文字列や値を入力し、必要な形式を選びます。",
  security: "確認したい文字列・URL・ファイルを入力または選択します。",
  japan: "日本向けの番号・住所・日付など、確認したい値を入力します。",
  office: "仕事・事務で整理したい内容や計算条件を入力します。",
  date: "日付や期間など、計算に必要な値を入力します。",
  calculator: "計算に必要な数値と条件を入力します。",
  share: "参加者名や条件など、分ける・並べるために必要な内容を入力します。",
};
const guideSteps = [
  inputGuide[categoryKey] ?? "処理したい内容を入力または選択します。",
  "「処理する」「変換」「生成」などの実行ボタンを押します。",
  "結果欄やプレビューを確認し、対応している場合はコピーまたはダウンロードします。",
];
const toolJson = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name,
  url: new URL(currentHref, siteConfig.url).toString(),
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript",
  offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: siteConfig.url + "/" },
    { "@type": "ListItem", position: 2, name: category, item: `${siteConfig.url}/category/${categoryKey}/` },
    { "@type": "ListItem", position: 3, name, item: new URL(currentHref, siteConfig.url).toString() },
  ],
};
const faqJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---
<BaseLayout title={title} description={description} ogImage={`/og/${categoryKey}.png`} ogImageAlt={`${category}ツール｜${siteConfig.name}`}>
  <div class="shell page-shell">
    <nav class="breadcrumbs" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href={`/category/${categoryKey}/`}>{category}</a><span>/</span><span aria-current="page">{name}</span></nav>
    <header class="tool-heading">
      <p class="eyebrow">{category}ツール</p>
      <h1>{name}</h1>
      <p>{description}</p>
    </header>
    {currentTool && (
      <span
        data-recent-tool
        data-tool-id={currentTool.id}
        data-tool-href={currentTool.href}
        data-tool-name={currentTool.name}
        data-tool-category={currentTool.category}
        hidden
      ></span>
    )}
    <slot />
    <section class="content-section tool-guide" aria-labelledby="tool-guide-title">
      <h2 id="tool-guide-title">{name}の使い方</h2>
      <ol>
        {guideSteps.map((step, index) => <li><span>{index + 1}</span><p>{step}</p></li>)}
      </ol>
    </section>

    {seoContent && (
      <section class="content-section seo-detail" aria-labelledby="seo-detail-title">
        <h2 id="seo-detail-title">{name}を使う場面</h2>
        <p class="seo-lead">{seoContent.lead}</p>
        <div class="seo-usecases">
          {seoContent.useCases.map((item) => <div><span aria-hidden="true">✓</span><p>{item}</p></div>)}
        </div>

        <h3>入力・出力例</h3>
        <div class="seo-example">
          <div><span>入力例</span><code>{seoContent.example.input}</code></div>
          <div><span>出力例</span><code>{seoContent.example.output}</code></div>
        </div>

        <h3>使うときのポイント</h3>
        <ul class="seo-tips">
          {seoContent.tips.map((tip) => <li>{tip}</li>)}
        </ul>
      </section>
    )}

    <section class="content-section">
      <h2>入力内容が送信されない仕組み</h2>
      <p>選択したファイルや入力したテキストはブラウザ内で処理します。このツールから内容を外部APIへ送信する処理はありません。</p>
    </section>
    <section class="content-section">
      <h2>よくある質問</h2>
      <div class="faq-list">
        {faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </section>
    <RelatedTools currentHref={currentHref} />
    <IssueReport toolName={name} />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(toolJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJson)} />
  <script>
    const recentEl = document.querySelector<HTMLElement>("[data-recent-tool]");
    if (recentEl?.dataset.toolId) {
      const key = "utility-tools:recent";
      try {
        const current = {
          id: recentEl.dataset.toolId,
          href: recentEl.dataset.toolHref ?? "",
          name: recentEl.dataset.toolName ?? "",
          category: recentEl.dataset.toolCategory ?? "",
        };
        const saved = JSON.parse(localStorage.getItem(key) ?? "[]");
        const items = Array.isArray(saved) ? saved.filter((item) => item?.id !== current.id) : [];
        localStorage.setItem(key, JSON.stringify([current, ...items].slice(0, 6)));
      } catch {}
    }
  </script>
</BaseLayout>
