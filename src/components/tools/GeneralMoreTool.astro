---
import ToolLayout from "../layout/ToolLayout.astro";
import ErrorMessage from "../feedback/ErrorMessage.astro";
import SuccessMessage from "../feedback/SuccessMessage.astro";
import type { ExtraToolMeta } from "../../config/extra-tools";
import "../../styles/tool.css";
interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
const noTextModes = ["weekday","iso-week","percentage","discount","bytes-converter","aspect-ratio","ulid","semver-compare","month-difference","time-duration","leap-year","day-of-year","quarter","tax-calculator","compound-interest","temperature"];
---
<ToolLayout title={meta.title} description={meta.description} name={meta.name} category={meta.category} faqs={meta.faqs}>
  <section class="tool-card" data-general-more data-mode={meta.mode}>
    <div class="privacy-note"><span>🔒</span><div><strong>ブラウザ内だけで処理</strong><br />入力内容は外部サーバーへ送信しません。</div></div>

    {meta.mode === "json-array-sort" && <div class="field"><label for="array-sort">並び順</label><select id="array-sort" data-action><option value="asc">昇順</option><option value="desc">降順</option></select></div>}
    {meta.mode === "json-path" && <div class="field"><label for="json-path">取得パス</label><input id="json-path" data-a type="text" placeholder="例: user.profile.name または items.0.id" /></div>}
    {meta.mode === "json-string-codec" && <div class="field"><label for="json-string-action">処理</label><select id="json-string-action" data-action><option value="escape">JSON文字列へエスケープ</option><option value="unescape">JSON文字列を復元</option></select></div>}
    {meta.mode === "unicode-escape" && <div class="field"><label for="unicode-action">処理</label><select id="unicode-action" data-action><option value="encode">文字列 → Unicodeエスケープ</option><option value="decode">Unicodeエスケープ → 文字列</option></select></div>}
    {meta.mode === "base64url" && <div class="field"><label for="base64url-action">処理</label><select id="base64url-action" data-action><option value="encode">エンコード</option><option value="decode">デコード</option></select></div>}
    {meta.mode === "find-replace" && <div class="settings-grid">
      <div class="field"><label for="find-text">検索文字列</label><input id="find-text" data-a type="text" /></div>
      <div class="field"><label for="replace-text">置換文字列</label><input id="replace-text" data-b type="text" /></div>
    </div>}
    {meta.mode === "line-ending" && <div class="field"><label for="line-ending-action">変換先</label><select id="line-ending-action" data-action><option value="lf">LF (Unix)</option><option value="crlf">CRLF (Windows)</option><option value="cr">CR</option></select></div>}
    {meta.mode === "normalize-slashes" && <div class="field"><label for="slash-action">変換方向</label><select id="slash-action" data-action><option value="unix">\ → /</option><option value="windows">/ → \</option></select></div>}
    {meta.mode === "sort-lines-by-length" && <div class="field"><label for="length-sort-action">並び順</label><select id="length-sort-action" data-action><option value="asc">短い順</option><option value="desc">長い順</option></select></div>}
    {meta.mode === "join-lines" && <div class="field"><label for="join-delimiter">区切り文字</label><input id="join-delimiter" data-a type="text" value=", " /></div>}
    {meta.mode === "split-delimiter" && <div class="field"><label for="split-delimiter">区切り文字</label><input id="split-delimiter" data-a type="text" value="," /></div>}
    {meta.mode === "pad-lines" && <div class="settings-grid">
      <div class="field"><label for="pad-width">文字幅</label><input id="pad-width" data-a type="number" min="1" max="10000" value="20" /></div>
      <div class="field"><label for="pad-direction">方向</label><select id="pad-direction" data-action><option value="right">右側を空白で埋める</option><option value="left">左側を空白で埋める</option></select></div>
    </div>}
    {meta.mode === "json-pick-keys" && <div class="field"><label for="json-pick-keys">残すキー（カンマ区切り）</label><input id="json-pick-keys" data-a type="text" placeholder="name,email,status" /></div>}
    {meta.mode === "punctuation-normalize" && <div class="field"><label for="punctuation-action">変換方向</label><select id="punctuation-action" data-action><option value="ascii">日本語記号 → ASCII寄り</option><option value="japanese">ASCII記号 → 日本語寄り</option></select></div>}
    {meta.mode === "space-normalize" && <div class="field"><label for="space-action">処理</label><select id="space-action" data-action><option value="collapse">連続空白を1つに</option><option value="remove">空白をすべて削除</option><option value="half">全角空白を半角へ</option></select></div>}
    {meta.mode === "querystring" && <div class="field"><label for="query-action">処理</label><select id="query-action" data-action><option value="parse">クエリ文字列 → JSON</option><option value="build">JSON → クエリ文字列</option></select></div>}
    {meta.mode === "base-converter" && <div class="settings-grid">
      <div class="field"><label for="from-base">変換元の基数</label><input id="from-base" data-a type="number" min="2" max="36" value="10" /></div>
      <div class="field"><label for="to-base">変換先の基数</label><input id="to-base" data-b type="number" min="2" max="36" value="16" /></div>
    </div>}
    {meta.mode === "ulid" && <div class="field"><label for="ulid-count">生成数</label><input id="ulid-count" data-a type="number" min="1" max="1000" value="10" /></div>}
    {meta.mode === "hex-text" && <div class="field"><label for="hex-action">変換方向</label><select id="hex-action" data-action><option value="text-hex">テキスト → HEX</option><option value="hex-text">HEX → テキスト</option></select></div>}
    {meta.mode === "identifier-case" && <div class="field"><label for="identifier-action">変換形式</label><select id="identifier-action" data-action><option value="camel">camelCase</option><option value="pascal">PascalCase</option><option value="snake">snake_case</option><option value="kebab">kebab-case</option><option value="constant">CONSTANT_CASE</option></select></div>}
    {meta.mode === "semver-compare" && <div class="settings-grid">
      <div class="field"><label for="semver-a">Version A</label><input id="semver-a" data-a type="text" placeholder="1.2.3" /></div>
      <div class="field"><label for="semver-b">Version B</label><input id="semver-b" data-b type="text" placeholder="2.0.0" /></div>
    </div>}
    {meta.mode === "weekday" && <div class="field"><label for="weekday-date">日付</label><input id="weekday-date" data-a type="date" /></div>}
    {meta.mode === "leap-year" && <div class="field"><label for="leap-year-value">西暦</label><input id="leap-year-value" data-a type="number" min="1" max="9999" step="1" placeholder="例: 2028" /></div>}
    {meta.mode === "day-of-year" && <div class="field"><label for="day-of-year-date">日付</label><input id="day-of-year-date" data-a type="date" /></div>}
    {meta.mode === "quarter" && <div class="field"><label for="quarter-date">日付</label><input id="quarter-date" data-a type="date" /></div>}
    {meta.mode === "iso-week" && <div class="field"><label for="iso-week-date">日付</label><input id="iso-week-date" data-a type="date" /></div>}
    {meta.mode === "month-difference" && <div class="settings-grid">
      <div class="field"><label for="month-start">開始日</label><input id="month-start" data-a type="date" /></div>
      <div class="field"><label for="month-end">終了日</label><input id="month-end" data-b type="date" /></div>
    </div>}
    {meta.mode === "percentage" && <div class="settings-grid">
      <div class="field"><label for="part-value">値</label><input id="part-value" data-a type="number" step="any" /></div>
      <div class="field"><label for="whole-value">全体</label><input id="whole-value" data-b type="number" step="any" /></div>
    </div>}
    {meta.mode === "discount" && <div class="settings-grid">
      <div class="field"><label for="original-price">元の価格</label><input id="original-price" data-a type="number" step="any" min="0" /></div>
      <div class="field"><label for="discount-rate">割引率 (%)</label><input id="discount-rate" data-b type="number" step="any" min="0" max="100" /></div>
    </div>}
    {meta.mode === "tax-calculator" && <div class="settings-grid">
      <div class="field"><label for="tax-mode">計算方向</label><select id="tax-mode" data-action><option value="exclusive">税抜 → 税込</option><option value="inclusive">税込 → 税抜</option></select></div>
      <div class="field"><label for="tax-price">金額</label><input id="tax-price" data-a type="number" step="any" min="0" /></div>
      <div class="field"><label for="tax-rate">税率 (%)</label><input id="tax-rate" data-b type="number" step="any" min="0" value="10" /></div>
    </div>}
    {meta.mode === "compound-interest" && <div class="settings-grid">
      <div class="field"><label for="compound-principal">元本</label><input id="compound-principal" data-a type="number" step="any" min="0" /></div>
      <div class="field"><label for="compound-rate">年利 (%)</label><input id="compound-rate" data-b type="number" step="any" /></div>
      <div class="field"><label for="compound-years">運用年数</label><input id="compound-years" data-c type="number" step="any" min="0" /></div>
    </div>}
    {meta.mode === "temperature" && <div class="settings-grid">
      <div class="field"><label for="temperature-value">温度</label><input id="temperature-value" data-a type="number" step="any" /></div>
      <div class="field"><label for="temperature-from">変換元</label><select id="temperature-from" data-action><option value="C">摂氏 (℃)</option><option value="F">華氏 (℉)</option><option value="K">ケルビン (K)</option></select></div>
      <div class="field"><label for="temperature-to">変換先</label><select id="temperature-to" data-unit><option value="F">華氏 (℉)</option><option value="C">摂氏 (℃)</option><option value="K">ケルビン (K)</option></select></div>
    </div>}
    {meta.mode === "bytes-converter" && <div class="settings-grid">
      <div class="field"><label for="byte-value">値</label><input id="byte-value" data-a type="number" step="any" min="0" /></div>
      <div class="field"><label for="byte-from">変換元</label><select id="byte-from" data-action><option>B</option><option>KB</option><option selected>MB</option><option>GB</option><option>TB</option></select></div>
      <div class="field"><label for="byte-to">変換先</label><select id="byte-to" data-unit><option>B</option><option selected>KB</option><option>MB</option><option>GB</option><option>TB</option></select></div>
    </div>}
    {meta.mode === "aspect-ratio" && <div class="settings-grid">
      <div class="field"><label for="ratio-width">幅</label><input id="ratio-width" data-a type="number" step="1" min="1" /></div>
      <div class="field"><label for="ratio-height">高さ</label><input id="ratio-height" data-b type="number" step="1" min="1" /></div>
    </div>}
    {meta.mode === "time-duration" && <div class="settings-grid">
      <div class="field"><label for="time-start">開始時刻</label><input id="time-start" data-a type="time" /></div>
      <div class="field"><label for="time-end">終了時刻</label><input id="time-end" data-b type="time" /></div>
    </div>}
    {!noTextModes.includes(meta.mode) && <div class="field" style="margin-top:16px"><label for="general-more-source">入力</label><textarea id="general-more-source" class="textarea" data-source placeholder="ここに入力"></textarea></div>}
    <div class="field" style="margin-top:16px"><label for="general-more-result">結果</label><textarea id="general-more-result" class="textarea" data-result readonly></textarea></div>
    <div class="actions">
      <button class="button button-primary" type="button" data-run>処理する</button>
      <button class="button button-secondary" type="button" data-clear>クリア</button>
      <button class="button button-secondary" type="button" data-copy>結果をコピー</button>
    </div>
    <ErrorMessage /><SuccessMessage />
    <p class="inline-note" data-info></p>
  </section>
</ToolLayout>

<script>
  const root=document.querySelector<HTMLElement>("[data-general-more]")!;
  const mode=root.dataset.mode!;
  const source=root.querySelector<HTMLTextAreaElement>("[data-source]");
  const result=root.querySelector<HTMLTextAreaElement>("[data-result]")!;
  const action=root.querySelector<HTMLSelectElement>("[data-action]");
  const a=root.querySelector<HTMLInputElement>("[data-a]");
  const b=root.querySelector<HTMLInputElement>("[data-b]");
  const c=root.querySelector<HTMLInputElement>("[data-c]");
  const unit=root.querySelector<HTMLSelectElement>("[data-unit]");
  const run=root.querySelector<HTMLButtonElement>("[data-run]")!;
  const clear=root.querySelector<HTMLButtonElement>("[data-clear]")!;
  const copy=root.querySelector<HTMLButtonElement>("[data-copy]")!;
  const errorBox=root.querySelector<HTMLElement>("[data-error-box]")!;
  const successBox=root.querySelector<HTMLElement>("[data-success-box]")!;
  const info=root.querySelector<HTMLElement>("[data-info]")!;
  const setMsg=(el:HTMLElement,msg="")=>{el.textContent=msg;el.hidden=!msg;};
  const splitLines=(value:string)=>value.split(/\r\n|\r|\n/);
  function gcd(x:number,y:number){x=Math.abs(Math.round(x));y=Math.abs(Math.round(y));while(y){const t=y;y=x%y;x=t;}return x||1;}
  function secureRandomInt(max:number){const arr=new Uint32Array(1);crypto.getRandomValues(arr);return arr[0]%max;}
  function shuffle<T>(input:T[]){const arr=[...input];for(let i=arr.length-1;i>0;i--){const j=secureRandomInt(i+1);[arr[i],arr[j]]=[arr[j],arr[i]];}return arr;}
  function parsePath(obj:any,path:string){
    if(!path.trim())return obj;
    return path.split(".").reduce((cur,key)=>cur==null?undefined:cur[key],obj);
  }
  const C32="0123456789ABCDEFGHJKMNPQRSTVWXYZ";
  function encodeTime(time:number,length=10){let out="";for(let i=0;i<length;i++){out=C32[time%32]+out;time=Math.floor(time/32);}return out;}
  function randomChars(length:number){let out="";for(let i=0;i<length;i++)out+=C32[secureRandomInt(32)];return out;}
  function ulid(){return encodeTime(Date.now())+randomChars(16);}
  function parseDate(value:string){if(!value)throw new Error("日付を入力してください。");const d=new Date(value+"T00:00:00");if(Number.isNaN(d.getTime()))throw new Error("日付を確認してください。");return d;}
  function getIsoWeek(date:Date){
    const d=new Date(Date.UTC(date.getFullYear(),date.getMonth(),date.getDate()));
    const day=d.getUTCDay()||7;d.setUTCDate(d.getUTCDate()+4-day);
    const yearStart=new Date(Date.UTC(d.getUTCFullYear(),0,1));
    const week=Math.ceil((((d.getTime()-yearStart.getTime())/86400000)+1)/7);
    return {year:d.getUTCFullYear(),week};
  }
  function median(nums:number[]){const s=[...nums].sort((x,y)=>x-y),m=Math.floor(s.length/2);return s.length%2?s[m]:(s[m-1]+s[m])/2;}
  function stddev(nums:number[]){const avg=nums.reduce((s,n)=>s+n,0)/nums.length;return Math.sqrt(nums.reduce((s,n)=>s+(n-avg)**2,0)/nums.length);}
  function unicodeEscapeEncode(value:string){return Array.from(value).map(ch=>{const code=ch.codePointAt(0)!;if(code>=0x20&&code<=0x7e)return ch;if(code<=0xffff)return "\\u"+code.toString(16).toUpperCase().padStart(4,"0");const n=code-0x10000,hi=0xd800+(n>>10),lo=0xdc00+(n&0x3ff);return "\\u"+hi.toString(16).toUpperCase()+"\\u"+lo.toString(16).toUpperCase();}).join("");}
  function unicodeEscapeDecode(value:string){return value.replace(/\\u([0-9a-fA-F]{4})/g,(_,hex)=>String.fromCharCode(parseInt(hex,16)));}
  function base64UrlEncode(value:string){const bytes=new TextEncoder().encode(value);let binary="";for(const byte of bytes)binary+=String.fromCharCode(byte);return btoa(binary).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");}
  function base64UrlDecode(value:string){const normalized=value.trim().replace(/-/g,"+").replace(/_/g,"/");const padded=normalized+"=".repeat((4-normalized.length%4)%4);const binary=atob(padded);return new TextDecoder().decode(Uint8Array.from(binary,ch=>ch.charCodeAt(0)));}
  function textToHex(value:string){return Array.from(new TextEncoder().encode(value)).map(b=>b.toString(16).padStart(2,"0")).join(" ");}
  function hexToText(value:string){
    const clean=value.replace(/0x/gi,"").replace(/[^0-9a-f]/gi,"");
    if(!clean||clean.length%2)throw new Error("偶数桁の16進数を入力してください。");
    const bytes=new Uint8Array(clean.match(/.{2}/g)!.map(pair=>parseInt(pair,16)));
    return new TextDecoder().decode(bytes);
  }
  function crc32(value:string){
    let crc=0xffffffff;
    const bytes=new TextEncoder().encode(value);
    for(const byte of bytes){crc^=byte;for(let i=0;i<8;i++)crc=(crc>>>1)^((crc&1)?0xedb88320:0);}
    return ((crc^0xffffffff)>>>0).toString(16).toUpperCase().padStart(8,"0");
  }
  function identifierWords(value:string){
    return value.trim().replace(/([a-z0-9])([A-Z])/g,"$1 $2").replace(/[^A-Za-z0-9]+/g," ").trim().split(/\s+/).filter(Boolean).map(w=>w.toLowerCase());
  }
  function compareSemver(aValue:string,bValue:string){
    const parse=(v:string)=>{const m=v.trim().replace(/^v/i,"").match(/^(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$/);if(!m)throw new Error("x.y.z 形式のバージョンを入力してください。");return {nums:[+m[1],+m[2],+m[3]],pre:m[4]?.split(".")??[]};};
    const x=parse(aValue),y=parse(bValue);
    for(let i=0;i<3;i++){if(x.nums[i]!==y.nums[i])return x.nums[i]>y.nums[i]?1:-1;}
    if(!x.pre.length&&!y.pre.length)return 0;if(!x.pre.length)return 1;if(!y.pre.length)return -1;
    const len=Math.max(x.pre.length,y.pre.length);
    for(let i=0;i<len;i++){if(x.pre[i]===undefined)return -1;if(y.pre[i]===undefined)return 1;if(x.pre[i]===y.pre[i])continue;const xn=/^\d+$/.test(x.pre[i]),yn=/^\d+$/.test(y.pre[i]);if(xn&&yn)return Number(x.pre[i])>Number(y.pre[i])?1:-1;if(xn!==yn)return xn?-1:1;return x.pre[i]>y.pre[i]?1:-1;}
    return 0;
  }
  run.addEventListener("click",()=>{
    setMsg(errorBox);setMsg(successBox);info.textContent="";
    try{
      const value=source?.value??"";
      if(mode==="json-array-dedupe"){
        const arr=JSON.parse(value);if(!Array.isArray(arr))throw new Error("JSON配列を入力してください。");
        const seen=new Set<string>();const out=arr.filter(item=>{const key=JSON.stringify(item);if(seen.has(key))return false;seen.add(key);return true;});
        result.value=JSON.stringify(out,null,2);info.textContent=(arr.length-out.length)+"件の重複を削除";
      }else if(mode==="json-array-sort"){
        const arr=JSON.parse(value);if(!Array.isArray(arr))throw new Error("JSON配列を入力してください。");
        if(arr.some(item=>item!==null&&typeof item==="object"))throw new Error("文字列・数値などの単純な配列に対応しています。");
        arr.sort((x,y)=>typeof x==="number"&&typeof y==="number"?x-y:String(x).localeCompare(String(y),"ja",{numeric:true}));
        if(action?.value==="desc")arr.reverse();result.value=JSON.stringify(arr,null,2);
      }else if(mode==="json-path"){
        const parsed=JSON.parse(value),found=parsePath(parsed,a?.value??"");if(found===undefined)throw new Error("指定パスが見つかりません。");
        result.value=typeof found==="string"?found:JSON.stringify(found,null,2);
      }else if(mode==="json-string-codec"){
        if(action?.value==="escape")result.value=JSON.stringify(value);
        else{const parsed=JSON.parse(value);if(typeof parsed!=="string")throw new Error("JSON文字列を入力してください。");result.value=parsed;}
      }else if(mode==="json-pick-keys"){
        const parsed=JSON.parse(value),keys=(a?.value??"").split(",").map(k=>k.trim()).filter(Boolean);
        if(!keys.length)throw new Error("残すキーを入力してください。");
        const pick=(obj:any)=>Object.fromEntries(keys.filter(key=>Object.prototype.hasOwnProperty.call(obj,key)).map(key=>[key,obj[key]]));
        if(Array.isArray(parsed)){if(parsed.some(item=>!item||typeof item!=="object"||Array.isArray(item)))throw new Error("オブジェクト配列を入力してください。");result.value=JSON.stringify(parsed.map(pick),null,2);}
        else{if(!parsed||typeof parsed!=="object")throw new Error("JSONオブジェクトを入力してください。");result.value=JSON.stringify(pick(parsed),null,2);}
      }else if(mode==="trim-each-line"){
        result.value=splitLines(value).map(line=>line.trim()).join("\n");
      }else if(mode==="collapse-blank-lines"){
        const lines=splitLines(value),out:string[]=[];let blank=false;
        for(const line of lines){const isBlank=line.trim()==="";if(isBlank){if(!blank)out.push("");blank=true;}else{out.push(line);blank=false;}}
        result.value=out.join("\n");
      }else if(mode==="extract-emails"){
        const matches=value.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi)??[];
        result.value=[...new Set(matches)].join("\n");info.textContent=result.value?matches.length+"件検出":"0件";
      }else if(mode==="extract-urls"){
        const matches=value.match(/https?:\/\/[^\s<>"']+/gi)??[];
        result.value=[...new Set(matches.map(url=>url.replace(/[),.;!?]+$/,"")))].join("\n");info.textContent=result.value?matches.length+"件検出":"0件";
      }else if(mode==="remove-html-tags"){
        result.value=value.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi,"").replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi,"").replace(/<[^>]+>/g,"").replace(/&nbsp;/gi," ");
      }else if(mode==="regex-escape"){
        result.value=value.replace(/[.*+?^${}()|[\]\\]/g,"\\$&");
      }else if(mode==="quote-lines"){
        result.value=splitLines(value).map(line=>"\""+line.replace(/\\/g,"\\\\").replace(/\"/g,"\\\"")+"\"").join("\n");
      }else if(mode==="unquote-lines"){
        result.value=splitLines(value).map(line=>line.startsWith("\"")&&line.endsWith("\"")?line.slice(1,-1).replace(/\\\"/g,"\"").replace(/\\\\/g,"\\"):line).join("\n");
      }else if(mode==="normalize-slashes"){
        result.value=action?.value==="windows"?value.replace(/\//g,"\\"):value.replace(/\\/g,"/");
      }else if(mode==="sort-lines-by-length"){
        const lines=splitLines(value).map((line,index)=>({line,index}));
        lines.sort((x,y)=>((action?.value==="desc"?y.line.length-x.line.length:x.line.length-y.line.length)||x.index-y.index));
        result.value=lines.map(item=>item.line).join("\n");
      }else if(mode==="find-replace"){
        const find=a?.value??"";if(!find)throw new Error("検索文字列を入力してください。");
        result.value=value.split(find).join(b?.value??"");
      }else if(mode==="reverse-lines"){
        result.value=splitLines(value).reverse().join("\n");
      }else if(mode==="shuffle-lines"){
        result.value=shuffle(splitLines(value)).join("\n");
      }else if(mode==="word-frequency"){
        const words=(value.toLocaleLowerCase().match(/[\p{L}\p{N}_]+/gu)??[]),counts=new Map<string,number>();
        for(const word of words)counts.set(word,(counts.get(word)??0)+1);
        result.value=Array.from(counts.entries()).sort((x,y)=>y[1]-x[1]||x[0].localeCompare(y[0],"ja")).map(([word,count])=>word+"\t"+count).join("\n");
        info.textContent=words.length+"語 / "+counts.size+"種類";
      }else if(mode==="line-ending"){
        const normalized=value.replace(/\r\n|\r|\n/g,"\n"),sep=action?.value==="crlf"?"\r\n":action?.value==="cr"?"\r":"\n";
        result.value=normalized.split("\n").join(sep);
      }else if(mode==="join-lines"){
        const delimiter=a?.value??",";result.value=splitLines(value).join(delimiter);
      }else if(mode==="split-delimiter"){
        const delimiter=a?.value??",";if(delimiter==="")throw new Error("区切り文字を入力してください。");
        result.value=value.split(delimiter).map(v=>v.trim()).join("\n");
      }else if(mode==="extract-numbers"){
        const matches=value.match(/-?(?:\d+(?:\.\d+)?|\.\d+)/g)??[];result.value=matches.join("\n");info.textContent=matches.length+"件抽出";
      }else if(mode==="extract-hashtags"){
        const matches=value.match(/#[\p{L}\p{N}_ー]+/gu)??[];const unique=[...new Set(matches)];result.value=unique.join("\n");info.textContent=unique.length+"件抽出";
      }else if(mode==="pad-lines"){
        const width=Math.max(1,Math.min(10000,Number(a?.value)||20));
        result.value=splitLines(value).map(line=>action?.value==="left"?line.padStart(width):line.padEnd(width)).join("\n");
      }else if(mode==="kana-normalize"){
        result.value=value.normalize("NFKC");
      }else if(mode==="punctuation-normalize"){
        const toAscii:Record<string,string>={"、":",","。":".","！":"!","？":"?","：":":","；":";","（":"(", "）":")","［":"[","］":"]","｛":"{","｝":"}"};
        const toJa:Record<string,string>={",":"、",".":"。","!":"！","?":"？",":":"：",";":"；","(":"（",")":"）","[":"［","]":"］","{":"｛","}":"｝"};
        const map=action?.value==="japanese"?toJa:toAscii;result.value=Array.from(value).map(ch=>map[ch]??ch).join("");
      }else if(mode==="space-normalize"){
        result.value=action?.value==="remove"?value.replace(/[\s\u3000]+/g,""):action?.value==="half"?value.replace(/\u3000/g," "):value.replace(/[ \t\u3000]+/g," ");
      }else if(mode==="japanese-char-count"){
        let hira=0,kata=0,kanji=0,latin=0,digit=0,space=0,other=0;
        for(const ch of value){if(/[\u3040-\u309f]/.test(ch))hira++;else if(/[\u30a0-\u30ff\uff66-\uff9f]/.test(ch))kata++;else if(/[\u3400-\u4dbf\u4e00-\u9fff]/.test(ch))kanji++;else if(/[A-Za-z]/.test(ch))latin++;else if(/[0-9]/.test(ch))digit++;else if(/\s|\u3000/.test(ch))space++;else other++;}
        result.value="ひらがな: "+hira+"\nカタカナ: "+kata+"\n漢字: "+kanji+"\n英字: "+latin+"\n数字: "+digit+"\n空白: "+space+"\nその他: "+other;
      }else if(mode==="unicode-escape"){
        result.value=action?.value==="decode"?unicodeEscapeDecode(value):unicodeEscapeEncode(value);
      }else if(mode==="base64url"){
        result.value=action?.value==="decode"?base64UrlDecode(value):base64UrlEncode(value);
      }else if(mode==="querystring"){
        if(action?.value==="parse"){const q=value.trim().replace(/^\?/,"");result.value=JSON.stringify(Object.fromEntries(new URLSearchParams(q).entries()),null,2);}
        else{const obj=JSON.parse(value);if(!obj||Array.isArray(obj)||typeof obj!=="object")throw new Error("JSONオブジェクトを入力してください。");result.value=new URLSearchParams(Object.entries(obj).map(([k,v])=>[k,String(v)])).toString();}
      }else if(mode==="base-converter"){
        const from=Number(a?.value),to=Number(b?.value);if(from<2||from>36||to<2||to>36)throw new Error("基数は2〜36で指定してください。");
        const text=value.trim();if(!text)throw new Error("数値を入力してください。");
        const parsed=parseInt(text,from);if(Number.isNaN(parsed)||parsed.toString(from).toLowerCase()!==text.replace(/^\+/,"").toLowerCase().replace(/^0+(?=.)/,"")){if(!/^[0-9a-z]+$/i.test(text))throw new Error("入力値を確認してください。");}
        result.value=parsed.toString(to).toUpperCase();
      }else if(mode==="uuid-validate"){
        const v=value.trim(),ok=/^[0-9a-f]{8}-[0-9a-f]{4}-([1-8])[0-9a-f]{3}-([89ab])[0-9a-f]{3}-[0-9a-f]{12}$/i.test(v);
        result.value=ok?"有効なUUIDです。":"UUID形式ではありません。";
        if(ok){const m=v.match(/^[^-]+-[^-]+-([0-9a-f])/) ;if(m)info.textContent="version "+m[1];}
      }else if(mode==="ulid"){
        const count=Math.max(1,Math.min(1000,Number(a?.value)||10));result.value=Array.from({length:count},()=>ulid()).join("\n");
      }else if(mode==="hex-text"){
        result.value=action?.value==="hex-text"?hexToText(value):textToHex(value);
      }else if(mode==="crc32"){
        result.value=crc32(value);
      }else if(mode==="identifier-case"){
        const words=identifierWords(value);if(!words.length)throw new Error("英数字を含む識別子を入力してください。");
        const cap=(w:string)=>w.charAt(0).toUpperCase()+w.slice(1);
        result.value=action?.value==="pascal"?words.map(cap).join(""):action?.value==="snake"?words.join("_"):action?.value==="kebab"?words.join("-"):action?.value==="constant"?words.join("_").toUpperCase():words[0]+words.slice(1).map(cap).join("");
      }else if(mode==="semver-compare"){
        const av=a?.value??"",bv=b?.value??"",cmp=compareSemver(av,bv);
        result.value=cmp===0?av+" = "+bv:cmp>0?av+" > "+bv:av+" < "+bv;
      }else if(mode==="weekday"){
        const date=parseDate(a?.value??"");const ja=["日曜日","月曜日","火曜日","水曜日","木曜日","金曜日","土曜日"],en=["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
        result.value=ja[date.getDay()]+" ("+en[date.getDay()]+")";
      }else if(mode==="leap-year"){
        const year=Number(a?.value);if(!Number.isInteger(year)||year<1||year>9999)throw new Error("1〜9999の西暦を入力してください。");
        const leap=year%400===0||(year%4===0&&year%100!==0);result.value=year+"年は"+(leap?"うるう年です。":"平年です。");
      }else if(mode==="day-of-year"){
        const date=parseDate(a?.value??"");const start=new Date(date.getFullYear(),0,1);const day=Math.floor((date.getTime()-start.getTime())/86400000)+1;
        result.value=date.getFullYear()+"年の"+day+"日目です。";
      }else if(mode==="quarter"){
        const date=parseDate(a?.value??"");const quarter=Math.floor(date.getMonth()/3)+1;const starts=[1,4,7,10],ends=[3,6,9,12];
        result.value="第"+quarter+"四半期 ("+starts[quarter-1]+"月〜"+ends[quarter-1]+"月)";
      }else if(mode==="iso-week"){
        const date=parseDate(a?.value??""),iso=getIsoWeek(date);result.value=String(iso.year)+"-W"+String(iso.week).padStart(2,"0");
      }else if(mode==="month-difference"){
        let start=parseDate(a?.value??""),end=parseDate(b?.value??""),sign=1;if(start>end){[start,end]=[end,start];sign=-1;}
        let months=(end.getFullYear()-start.getFullYear())*12+(end.getMonth()-start.getMonth());
        let anchor=new Date(start);anchor.setMonth(anchor.getMonth()+months);
        if(anchor>end){months--;anchor=new Date(start);anchor.setMonth(anchor.getMonth()+months);}
        const days=Math.round((end.getTime()-anchor.getTime())/86400000);
        const prefix=sign<0?"-":"";
        result.value=prefix+months+"か月 "+days+"日\n合計月数(概算): "+prefix+(months+days/30.436875).toFixed(2);
      }else if(mode==="percentage"){
        const part=Number(a?.value),whole=Number(b?.value);if(!Number.isFinite(part)||!Number.isFinite(whole)||whole===0)throw new Error("全体は0以外の数値にしてください。");
        result.value=(part/whole*100).toFixed(2)+"%";
      }else if(mode==="discount"){
        const price=Number(a?.value),rate=Number(b?.value);if(!Number.isFinite(price)||!Number.isFinite(rate)||price<0||rate<0||rate>100)throw new Error("価格と0〜100%の割引率を入力してください。");
        const off=price*rate/100,after=price-off;result.value="割引後: "+after.toLocaleString(undefined,{maximumFractionDigits:2})+"\n値引額: "+off.toLocaleString(undefined,{maximumFractionDigits:2});
      }else if(mode==="tax-calculator"){
        const price=Number(a?.value),rate=Number(b?.value);if(!Number.isFinite(price)||!Number.isFinite(rate)||price<0||rate<0)throw new Error("0以上の金額と税率を入力してください。");
        if(action?.value==="inclusive"){const base=price/(1+rate/100),tax=price-base;result.value="税抜価格: "+base.toLocaleString(undefined,{maximumFractionDigits:2})+"\n税額: "+tax.toLocaleString(undefined,{maximumFractionDigits:2})+"\n税込価格: "+price.toLocaleString(undefined,{maximumFractionDigits:2});}
        else{const tax=price*rate/100,total=price+tax;result.value="税抜価格: "+price.toLocaleString(undefined,{maximumFractionDigits:2})+"\n税額: "+tax.toLocaleString(undefined,{maximumFractionDigits:2})+"\n税込価格: "+total.toLocaleString(undefined,{maximumFractionDigits:2});}
      }else if(mode==="compound-interest"){
        const principal=Number(a?.value),rate=Number(b?.value),years=Number(c?.value);if(!Number.isFinite(principal)||!Number.isFinite(rate)||!Number.isFinite(years)||principal<0||years<0)throw new Error("元本・年利・運用年数を確認してください。");
        const future=principal*(1+rate/100)**years,gain=future-principal;result.value="将来金額: "+future.toLocaleString(undefined,{maximumFractionDigits:2})+"\n増加額: "+gain.toLocaleString(undefined,{maximumFractionDigits:2});info.textContent="年1回複利で計算";
      }else if(mode==="temperature"){
        const input=Number(a?.value);if(!Number.isFinite(input))throw new Error("温度を入力してください。");const from=action?.value??"C",to=unit?.value??"F";
        const celsius=from==="C"?input:from==="F"?(input-32)*5/9:input-273.15;if(celsius<-273.15-1e-9)throw new Error("絶対零度より低い温度は指定できません。");
        const converted=to==="C"?celsius:to==="F"?celsius*9/5+32:celsius+273.15;const suffix=to==="C"?" ℃":to==="F"?" ℉":" K";result.value=converted.toLocaleString(undefined,{maximumFractionDigits:6})+suffix;
      }else if(mode==="stats"){
        const nums=value.split(/[\s,]+/).filter(Boolean).map(Number);if(!nums.length||nums.some(n=>!Number.isFinite(n)))throw new Error("数値を改行・空白・カンマ区切りで入力してください。");
        const sum=nums.reduce((s,n)=>s+n,0),avg=sum/nums.length;result.value="件数: "+nums.length+"\n合計: "+sum+"\n平均: "+avg+"\n中央値: "+median(nums)+"\n最小: "+Math.min(...nums)+"\n最大: "+Math.max(...nums)+"\n標準偏差(母): "+stddev(nums);
      }else if(mode==="bytes-converter"){
        const n=Number(a?.value);if(!Number.isFinite(n)||n<0)throw new Error("0以上の数値を入力してください。");
        const factors:Record<string,number>={B:1,KB:1024,MB:1024**2,GB:1024**3,TB:1024**4};const from=action?.value??"MB",to=unit?.value??"KB";
        const converted=n*factors[from]/factors[to];result.value=converted.toLocaleString(undefined,{maximumFractionDigits:10})+" "+to;info.textContent="1 KB = 1024 B で計算";
      }else if(mode==="aspect-ratio"){
        const w=Number(a?.value),h=Number(b?.value);if(!Number.isFinite(w)||!Number.isFinite(h)||w<=0||h<=0)throw new Error("0より大きい幅と高さを入力してください。");
        const g=gcd(w,h);result.value=(Math.round(w)/g)+":"+(Math.round(h)/g)+"\n幅÷高さ = "+(w/h).toFixed(6);
      }else if(mode==="time-duration"){
        const parseTime=(v:string)=>{const m=v.match(/^(\d{2}):(\d{2})$/);if(!m)throw new Error("開始・終了時刻を入力してください。");return Number(m[1])*60+Number(m[2]);};
        const start=parseTime(a?.value??""),end=parseTime(b?.value??"");let minutes=end-start;let overnight=false;if(minutes<0){minutes+=1440;overnight=true;}
        const hours=Math.floor(minutes/60),mins=minutes%60;result.value=hours+"時間 "+mins+"分\n合計: "+minutes+"分";if(overnight)info.textContent="終了時刻を翌日として計算しました。";
      }
      setMsg(successBox,"処理しました。");
    }catch(error){setMsg(errorBox,error instanceof Error?error.message:"処理に失敗しました。");}
  });
  copy.addEventListener("click",async()=>{if(!result.value)return;try{await navigator.clipboard.writeText(result.value);setMsg(successBox,"コピーしました。");}catch{setMsg(errorBox,"コピーできませんでした。");}});
  clear.addEventListener("click",()=>{if(source)source.value="";result.value="";info.textContent="";setMsg(errorBox);setMsg(successBox);});
</script>
