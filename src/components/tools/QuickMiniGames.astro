---
import ToolLayout from "../layout/ToolLayout.astro";
import type { ExtraToolMeta } from "../../config/extra-tools";
import "../../styles/tool.css";
interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
const snake = meta.mode === "neon-snake";
const reaction = meta.mode === "reaction-zero";
const orbit = meta.mode === "orbit-catch";
---
<ToolLayout title={meta.title} description={meta.description} name={meta.name} category={meta.category} faqs={meta.faqs}>
  {snake && (
    <section class="quick-game" data-quick-game data-mode="neon-snake" data-state="ready" data-head-x="8" data-head-y="10">
      <div class="qg-head"><div><p class="qg-kicker">SWIPE & SURVIVE</p><h2>Neon Snake</h2><p>光るフードを食べて伸び続けよう。壁か自分の体にぶつかるまでスコアを伸ばします。</p></div><div class="qg-best"><span>BEST</span><strong data-best>0</strong></div></div>
      <div class="qg-stats"><div><span>SCORE</span><strong data-score>0</strong></div><div><span>LENGTH</span><strong data-length>3</strong></div><div><span>SPEED</span><strong data-speed>1</strong></div></div>
      <div class="snake-wrap">
        <canvas data-snake width="420" height="420" aria-label="Neon Snake ゲーム画面"></canvas>
        <div class="qg-overlay" data-overlay><div><p>NEON GRID</p><h3>スワイプして進もう</h3><span>スマホ：上下左右スワイプ / PC：矢印・WASD</span><button class="button button-primary" data-start type="button">ゲーム開始</button></div></div>
      </div>
    </section>
  )}

  {reaction && (
    <section class="quick-game" data-quick-game data-mode="reaction-zero" data-state="ready">
      <div class="qg-head"><div><p class="qg-kicker">REACTION TEST</p><h2>Reaction Zero</h2><p>画面が青く光った瞬間にタップ。5回の平均反応速度と自己ベストを測ります。</p></div><div class="qg-best"><span>BEST</span><strong data-best>--- ms</strong></div></div>
      <div class="qg-stats"><div><span>ROUND</span><strong data-round>0 / 5</strong></div><div><span>AVERAGE</span><strong data-average>--- ms</strong></div><div><span>LAST</span><strong data-last>--- ms</strong></div></div>
      <button type="button" class="reaction-pad" data-reaction-pad aria-label="反応速度ゲーム画面">
        <span class="reaction-icon">◎</span><strong data-reaction-text>STARTを押してください</strong><small data-reaction-sub>光る前に押すとフライング</small>
      </button>
      <div class="qg-actions"><button class="button button-primary" type="button" data-start>START</button></div>
    </section>
  )}

  {orbit && (
    <section class="quick-game" data-quick-game data-mode="orbit-catch" data-state="ready">
      <div class="qg-head"><div><p class="qg-kicker">ONE TAP TIMING</p><h2>Orbit Catch</h2><p>円周を回る光点が黄色いゾーンに重なった瞬間にSTOP。10回の合計スコアを競います。</p></div><div class="qg-best"><span>BEST</span><strong data-best>0</strong></div></div>
      <div class="qg-stats"><div><span>SCORE</span><strong data-score>0</strong></div><div><span>TRIES</span><strong data-tries>0 / 10</strong></div><div><span>COMBO</span><strong data-combo>×0</strong></div></div>
      <div class="orbit-wrap">
        <canvas data-orbit width="460" height="460" aria-label="Orbit Catch タイミングゲーム画面"></canvas>
        <div class="orbit-center"><strong data-orbit-status>READY</strong><span>黄色でSTOP</span></div>
      </div>
      <div class="qg-actions"><button class="button button-primary orbit-stop" type="button" data-start>ゲーム開始</button><button class="button button-secondary" type="button" data-stop disabled>STOP</button></div>
    </section>
  )}
</ToolLayout>

<script>
const root=document.querySelector<HTMLElement>("[data-quick-game]")!;
const mode=root.dataset.mode!;

if(mode==="neon-snake"){
  const canvas=root.querySelector<HTMLCanvasElement>("[data-snake]")!,ctx=canvas.getContext("2d")!;
  const overlay=root.querySelector<HTMLElement>("[data-overlay]")!,start=root.querySelector<HTMLButtonElement>("[data-start]")!;
  const scoreEl=root.querySelector<HTMLElement>("[data-score]")!,lengthEl=root.querySelector<HTMLElement>("[data-length]")!,speedEl=root.querySelector<HTMLElement>("[data-speed]")!,bestEl=root.querySelector<HTMLElement>("[data-best]")!;
  const KEY="utility-tools:neon-snake:best",N=20,C=21;
  let snake=[{x:8,y:10},{x:7,y:10},{x:6,y:10}],dir={x:1,y:0},next={x:1,y:0},food={x:14,y:10},score=0,running=false,timer=0,touchX=0,touchY=0;
  let best=0;try{best=Number(localStorage.getItem(KEY)||"0")||0}catch{};bestEl.textContent=String(best);

  function placeFood(){for(let i=0;i<200;i++){const p={x:Math.floor(Math.random()*N),y:Math.floor(Math.random()*N)};if(!snake.some(s=>s.x===p.x&&s.y===p.y)){food=p;return}}}
  function draw(){ctx.fillStyle="#020617";ctx.fillRect(0,0,420,420);ctx.strokeStyle="rgba(56,189,248,.07)";ctx.lineWidth=1;for(let i=0;i<=N;i++){ctx.beginPath();ctx.moveTo(i*C,0);ctx.lineTo(i*C,420);ctx.stroke();ctx.beginPath();ctx.moveTo(0,i*C);ctx.lineTo(420,i*C);ctx.stroke()}ctx.shadowBlur=18;ctx.shadowColor="#facc15";ctx.fillStyle="#facc15";ctx.beginPath();ctx.arc(food.x*C+C/2,food.y*C+C/2,7,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;snake.forEach((s,i)=>{ctx.fillStyle=i===0?"#22d3ee":"#0ea5e9";ctx.fillRect(s.x*C+2,s.y*C+2,C-4,C-4)})}
  function stats(){scoreEl.textContent=String(score);lengthEl.textContent=String(snake.length);speedEl.textContent=String(1+Math.floor(score/5));root.dataset.headX=String(snake[0].x);root.dataset.headY=String(snake[0].y)}
  function finish(){running=false;window.clearTimeout(timer);root.dataset.state="gameover";if(score>best){best=score;bestEl.textContent=String(best);try{localStorage.setItem(KEY,String(best))}catch{}}overlay.innerHTML='<div><p>GAME OVER</p><h3>SCORE '+score+'</h3><span>長さ '+snake.length+'</span><button class="button button-primary" data-again type="button">もう一度</button></div>';overlay.classList.remove("hide");overlay.querySelector<HTMLButtonElement>("[data-again]")?.addEventListener("click",begin)}
  function tick(){if(!running)return;dir=next;const h={x:snake[0].x+dir.x,y:snake[0].y+dir.y};if(h.x<0||h.y<0||h.x>=N||h.y>=N||snake.some(s=>s.x===h.x&&s.y===h.y)){finish();return}snake.unshift(h);if(h.x===food.x&&h.y===food.y){score++;placeFood()}else snake.pop();stats();draw();timer=window.setTimeout(tick,Math.max(70,150-score*3))}
  function begin(){snake=[{x:8,y:10},{x:7,y:10},{x:6,y:10}];dir={x:1,y:0};next={x:1,y:0};score=0;placeFood();running=true;root.dataset.state="running";overlay.classList.add("hide");stats();draw();window.clearTimeout(timer);timer=window.setTimeout(tick,140)}
  function turn(x:number,y:number){if(x===-dir.x&&y===-dir.y)return;next={x,y}}
  window.addEventListener("keydown",e=>{if(["ArrowUp","KeyW"].includes(e.code))turn(0,-1);if(["ArrowDown","KeyS"].includes(e.code))turn(0,1);if(["ArrowLeft","KeyA"].includes(e.code))turn(-1,0);if(["ArrowRight","KeyD"].includes(e.code))turn(1,0)});
  canvas.addEventListener("pointerdown",e=>{touchX=e.clientX;touchY=e.clientY;canvas.setPointerCapture(e.pointerId)});
  canvas.addEventListener("pointerup",e=>{const dx=e.clientX-touchX,dy=e.clientY-touchY;if(Math.abs(dx)<18&&Math.abs(dy)<18)return;if(Math.abs(dx)>Math.abs(dy))turn(dx>0?1:-1,0);else turn(0,dy>0?1:-1)});
  start.addEventListener("click",begin);draw();stats();
}
if(mode==="reaction-zero"){
  const pad=root.querySelector<HTMLButtonElement>("[data-reaction-pad]")!,start=root.querySelector<HTMLButtonElement>("[data-start]")!;
  const textEl=root.querySelector<HTMLElement>("[data-reaction-text]")!,subEl=root.querySelector<HTMLElement>("[data-reaction-sub]")!,roundEl=root.querySelector<HTMLElement>("[data-round]")!,avgEl=root.querySelector<HTMLElement>("[data-average]")!,lastEl=root.querySelector<HTMLElement>("[data-last]")!,bestEl=root.querySelector<HTMLElement>("[data-best]")!;
  const KEY="utility-tools:reaction-zero:best";let round=0,results:number[]=[],goAt=0,timeout=0,state:"idle"|"waiting"|"go"="idle";
  let best=0;try{best=Number(localStorage.getItem(KEY)||"0")||0}catch{};bestEl.textContent=best?best+" ms":"--- ms";
  function update(){roundEl.textContent=round+" / 5";avgEl.textContent=results.length?Math.round(results.reduce((a,b)=>a+b,0)/results.length)+" ms":"--- ms";lastEl.textContent=results.length?results[results.length-1]+" ms":"--- ms"}
  function prepare(){if(round>=5){finish();return}state="waiting";root.dataset.state="waiting";pad.className="reaction-pad waiting";textEl.textContent="WAIT…";subEl.textContent="まだ押さない";window.clearTimeout(timeout);timeout=window.setTimeout(()=>{state="go";root.dataset.state="go";goAt=performance.now();pad.className="reaction-pad go";textEl.textContent="TAP!";subEl.textContent="今！"},1100+Math.random()*1400)}
  function finish(){state="idle";root.dataset.state="complete";const avg=Math.round(results.reduce((a,b)=>a+b,0)/results.length);pad.className="reaction-pad done";textEl.textContent=avg+" ms";subEl.textContent="5回の平均";if(!best||avg<best){best=avg;bestEl.textContent=best+" ms";try{localStorage.setItem(KEY,String(best))}catch{}}start.textContent="もう一度";update()}
  function begin(){round=0;results=[];update();start.disabled=true;prepare()}
  function hit(){if(state==="waiting"){window.clearTimeout(timeout);pad.className="reaction-pad false";textEl.textContent="TOO EARLY";subEl.textContent="フライング！ もう一度待って";state="idle";root.dataset.state="false-start";setTimeout(prepare,700);return}if(state!=="go")return;const ms=Math.max(1,Math.round(performance.now()-goAt));results.push(ms);round++;update();pad.className="reaction-pad hit";textEl.textContent=ms+" ms";subEl.textContent=ms<200?"FAST!":ms<280?"GOOD!":"KEEP TRYING";state="idle";root.dataset.state="hit";setTimeout(()=>round>=5?(start.disabled=false,finish()):prepare(),650)}
  pad.addEventListener("click",hit);start.addEventListener("click",()=>{start.disabled=true;begin()});update();
}

if(mode==="orbit-catch"){
  const canvas=root.querySelector<HTMLCanvasElement>("[data-orbit]")!,ctx=canvas.getContext("2d")!,start=root.querySelector<HTMLButtonElement>("[data-start]")!,stop=root.querySelector<HTMLButtonElement>("[data-stop]")!;
  const scoreEl=root.querySelector<HTMLElement>("[data-score]")!,triesEl=root.querySelector<HTMLElement>("[data-tries]")!,comboEl=root.querySelector<HTMLElement>("[data-combo]")!,bestEl=root.querySelector<HTMLElement>("[data-best]")!,status=root.querySelector<HTMLElement>("[data-orbit-status]")!;
  const KEY="utility-tools:orbit-catch:best";let score=0,tries=0,combo=0,angle=0,target=0,speed=1.6,running=false,last=0,raf=0;
  let best=0;try{best=Number(localStorage.getItem(KEY)||"0")||0}catch{};bestEl.textContent=String(best);
  const norm=(a:number)=>{a%=Math.PI*2;return a<0?a+Math.PI*2:a};
  const diff=(a:number,b:number)=>Math.abs(Math.atan2(Math.sin(a-b),Math.cos(a-b)));
  function stats(){scoreEl.textContent=String(score);triesEl.textContent=tries+" / 10";comboEl.textContent="×"+combo;root.dataset.tries=String(tries);root.dataset.score=String(score)}
  function draw(){const w=460,c=230,r=145;ctx.clearRect(0,0,w,w);const g=ctx.createRadialGradient(c,c,30,c,c,230);g.addColorStop(0,"#111827");g.addColorStop(1,"#020617");ctx.fillStyle=g;ctx.fillRect(0,0,w,w);ctx.strokeStyle="#334155";ctx.lineWidth=18;ctx.beginPath();ctx.arc(c,c,r,0,Math.PI*2);ctx.stroke();ctx.strokeStyle="#facc15";ctx.lineWidth=20;ctx.beginPath();ctx.arc(c,c,r,target-.18,target+.18);ctx.stroke();const x=c+Math.cos(angle)*r,y=c+Math.sin(angle)*r;ctx.shadowBlur=24;ctx.shadowColor="#22d3ee";ctx.fillStyle="#67e8f9";ctx.beginPath();ctx.arc(x,y,12,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0}
  function loop(now:number){if(!running)return;const dt=Math.min(.033,(now-last)/1000||0);last=now;angle=norm(angle+speed*dt);draw();raf=requestAnimationFrame(loop)}
  function newTarget(){target=Math.random()*Math.PI*2;speed=(Math.random()<.5?-1:1)*(1.55+tries*.12);status.textContent="GO";draw()}
  function begin(){score=0;tries=0;combo=0;angle=0;running=true;root.dataset.state="running";start.disabled=true;stop.disabled=false;stats();newTarget();last=performance.now();cancelAnimationFrame(raf);raf=requestAnimationFrame(loop)}
  function finish(){running=false;cancelAnimationFrame(raf);root.dataset.state="complete";stop.disabled=true;start.disabled=false;start.textContent="もう一度";status.textContent="FINISH";if(score>best){best=score;bestEl.textContent=String(best);try{localStorage.setItem(KEY,String(best))}catch{}}}
  function hit(){if(!running)return;const d=diff(angle,target);let pts=0;if(d<.07){pts=1000;combo++}else if(d<.18){pts=500;combo++}else if(d<.35){pts=150;combo=0}else combo=0;score+=pts*(1+Math.min(combo,5)*.2);score=Math.round(score);tries++;status.textContent=pts>=1000?"PERFECT":pts>=500?"GREAT":pts?"CLOSE":"MISS";stats();if(tries>=10){setTimeout(finish,350);return}setTimeout(newTarget,320)}
  start.addEventListener("click",begin);stop.addEventListener("click",hit);canvas.addEventListener("click",hit);stats();newTarget();
}
</script>
<style>
.quick-game{display:grid;gap:14px;padding:20px;border:1px solid #dbe5f0;border-radius:22px;background:linear-gradient(180deg,#07111f,#0b1220);box-shadow:0 18px 48px rgba(15,23,42,.17);color:#f8fafc}.qg-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.qg-head h2{margin:0;color:#fff;font-size:clamp(28px,4.5vw,43px);line-height:1}.qg-head p:not(.qg-kicker){max-width:650px;margin:8px 0 0;color:#a8bdd2;font-size:14px;line-height:1.7}.qg-kicker{margin:0 0 5px;color:#67e8f9;font-size:10px;font-weight:900;letter-spacing:.15em}.qg-best{flex:0 0 112px;padding:11px;border:1px solid rgba(103,232,249,.24);border-radius:14px;background:rgba(15,23,42,.65);text-align:center}.qg-best span{display:block;color:#7dd3fc;font-size:9px;font-weight:900;letter-spacing:.1em}.qg-best strong{font-size:21px}.qg-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.qg-stats>div{padding:9px 10px;border:1px solid rgba(148,163,184,.14);border-radius:11px;background:rgba(15,23,42,.62)}.qg-stats span{display:block;color:#7f95ad;font-size:8px;font-weight:900;letter-spacing:.1em}.qg-stats strong{font-size:18px}.snake-wrap{position:relative;width:min(100%,520px);margin:auto;overflow:hidden;border-radius:18px;border:1px solid rgba(103,232,249,.18);background:#020617;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}.snake-wrap canvas{display:block;width:100%;height:auto;touch-action:none}.qg-overlay{position:absolute;inset:0;display:grid;place-items:center;padding:18px;background:rgba(2,8,23,.68);transition:opacity .18s}.qg-overlay.hide{opacity:0;pointer-events:none}.qg-overlay>div{text-align:center;padding:20px;border:1px solid rgba(148,163,184,.22);border-radius:16px;background:rgba(8,21,38,.9)}.qg-overlay p{margin:0;color:#67e8f9;font-size:10px;font-weight:900;letter-spacing:.13em}.qg-overlay h3{margin:5px 0;color:#fff;font-size:26px}.qg-overlay span{display:block;margin-bottom:14px;color:#a8bdd2;font-size:12px}.reaction-pad{display:grid;place-items:center;gap:8px;min-height:360px;width:100%;border:1px solid rgba(148,163,184,.16);border-radius:20px;background:#111827;color:#fff;touch-action:manipulation;-webkit-user-select:none;user-select:none;transition:background .12s,transform .08s}.reaction-pad:active{transform:scale(.995)}.reaction-pad.waiting{background:#7f1d1d}.reaction-pad.go{background:#0369a1;box-shadow:inset 0 0 90px rgba(34,211,238,.28)}.reaction-pad.false{background:#9f1239}.reaction-pad.hit{background:#065f46}.reaction-pad.done{background:#312e81}.reaction-icon{font-size:62px;opacity:.75}.reaction-pad strong{font-size:clamp(25px,6vw,48px)}.reaction-pad small{color:rgba(255,255,255,.72)}.qg-actions{display:flex;justify-content:center;gap:8px}.orbit-wrap{position:relative;width:min(100%,480px);margin:auto;-webkit-user-select:none;user-select:none}.orbit-wrap canvas{display:block;width:100%;height:auto;touch-action:manipulation}.orbit-center{position:absolute;inset:0;display:grid;place-content:center;text-align:center;pointer-events:none}.orbit-center strong{font-size:28px}.orbit-center span{color:#8fa7be;font-size:11px}.orbit-stop{min-width:140px}
@media(max-width:640px){.quick-game{padding:12px;border-radius:16px}.qg-head{align-items:center}.qg-head p:not(.qg-kicker){font-size:12px}.qg-best{flex-basis:92px}.qg-stats{gap:4px}.qg-stats>div{padding:7px 6px}.qg-stats strong{font-size:14px}.reaction-pad{min-height:330px}.snake-wrap{max-width:390px}.orbit-wrap{max-width:390px}}
@media(max-width:420px){.qg-best{display:none}.qg-head h2{font-size:29px}.reaction-pad{min-height:310px}}
</style>
