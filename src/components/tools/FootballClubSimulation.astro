function autoLineup(){const used=new Set<string>(),out:string[]=[];for(const [slot] of slots()){const candidates=[...s.squad].filter((p:Player)=>healthy(p)&&!used.has(p.id)).sort((a:Player,b:Player)=>slotRating(b,slot)-slotRating(a,slot));const pick=candidates[0]||s.squad.find((p:Player)=>!used.has(p.id));out.push(pick.id);used.add(pick.id)}s.lineup=out;syncBench()}
function syncBench(){const valid=(s.bench||[]).filter((id:string)=>!s.lineup.includes(id)&&s.squad.some((p:Player)=>p.id===id));const rest=s.squad.filter((p:Player)=>!s.lineup.includes(p.id)&&!valid.includes(p.id)).sort((a:Player,b:Player)=>(healthy(b)?1:0)-(healthy(a)?1:0)||b.ovr-a.ovr).map((p:Player)=>p.id);s.bench=[...valid,...rest].slice(0,7)}
function lineStats(){let attack:number[]=[],mid:number[]=[],def:number[]=[],fit=0,form=0;slots().forEach(([slot],i)=>{const p=playerById(s.lineup[i]);if(!p)return;const r=slotRating(p,slot);fit+=compatibility(p,slot);form+=p.form;const g=positionGroup(slot);if(g==="FW")attack.push(r);else if(g==="MF")mid.push(r);else def.push(r)});const avg=(a:number[])=>a.length?a.reduce((x,y)=>x+y,0)/a.length:50,a=avg(attack),m=avg(mid),d=avg(def);return{attack:a*.8+m*.2,mid:m*.75+(a+d)*.125,def:d*.82+m*.18,ovr:(a+m+d)/3,fit:fit/11*100,fitness:s.lineup.reduce((x:number,id:string)=>x+playerById(id).fit,0)/11,form:form/11}}
