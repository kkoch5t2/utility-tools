function seeded(seed:number){return()=>{seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function newSeasonSeed(){try{const a=new Uint32Array(1);crypto.getRandomValues(a);return a[0]||Date.now()}catch{return Date.now()+Math.floor(Math.random()*1e7)}}
function buildSeasonPlayers(seed:number){
 const rnd=seeded(seed),used=new Set<string>();
 const rr=(a:number,b:number)=>Math.floor(a+rnd()*(b-a+1)),pick=<T,>(a:T[])=>a[Math.floor(rnd()*a.length)];
 const make=(templates:Player[],prefix:string,isMarket:boolean)=>templates.map((t,i)=>{
   let name="";do{name=pick(firstNames)+" "+pick(lastNames)}while(used.has(name));used.add(name);
   const ovr=clamp(t.ovr+rr(-2,2),58,82),age=clamp(t.age+rr(-3,3),18,34);
   const vary=(v:number)=>clamp(v+rr(-4,4),8,94);
   const ageFactor=age<=21?1.08:age>=30?.82:1;
   const qualityFactor=.82+(ovr-65)*.045;
   const price=isMarket?Math.max(30000000,Math.round((t.price||65000000)*qualityFactor*ageFactor*(.9+rnd()*.2)/1000000)*1000000):0;
   return{id:prefix+i,name,nation:pick(nations),age,pos:[...t.pos],ovr,pac:vary(t.pac),sho:vary(t.sho),pas:vary(t.pas),dri:vary(t.dri),def:vary(t.def),phy:vary(t.phy),price};
 });
 return{squad:make(squadTemplates,"s",false),market:make(marketTemplates,"m",true)};
}
