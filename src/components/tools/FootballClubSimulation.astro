---
import ToolLayout from "../layout/ToolLayout.astro";
import type { ExtraToolMeta } from "../../config/extra-tools";
interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
---

<ToolLayout title={meta.title} description={meta.description} name={meta.name} category={meta.category} faqs={meta.faqs}>
<section class="sim-shell football-sim football-deep football-career" data-sim-game data-mode="football-club-sim" data-state="ready">
  <header class="sim-top"><div><p class="sim-kicker">20 CLUBS / 38 MATCHES / EUROPEAN TRANSFERS</p><h2>Harbor City FC</h2><p class="sim-sub">20クラブ38試合のリーグを戦いながら、欧州各国の架空クラブをスカウト。移籍金・年俸・契約年数を交渉し、他クラブの選手成績まで追えるクラブ経営シミュレーションです。</p></div><div class="sim-best"><span>BEST SEASON</span><strong data-best>0 pt</strong></div></header>
  <div class="sim-kpis">
    <div class="sim-kpi"><span>SEASON / MATCH</span><strong data-season>1年目</strong><small data-week>1 / 38</small></div>
    <div class="sim-kpi"><span>POINTS</span><strong data-points>0</strong><small data-rank>順位 --</small></div>
    <div class="sim-kpi"><span>BUDGET</span><strong data-budget>¥500,000,000</strong><small data-finance-note>給与/節 ¥0</small></div>
    <div class="sim-kpi"><span>STARTING XI</span><strong data-quality>67.0</strong><small data-chemistry>適性 100%</small></div>
    <div class="sim-kpi"><span>SUPPORTERS</span><strong data-fans>18,000</strong><small data-record>0勝 0分 0敗</small></div>
  </div>

  <div class="sim-intro" data-intro>
    <div><h3>1シーズン38試合。本格クラブキャリアへ</h3><p>国内20クラブは全選手・全成績を保持。スペイン、イタリア、ドイツ、フランス、ポルトガル、オランダの架空クラブからも獲得できます。試合をじっくり進めるか、クイックシミュレーションで一気に進めるかも選べます。</p><div class="sim-actions"><button class="button button-primary" type="button" data-start>新しいクラブで始める</button><button class="button button-secondary" type="button" data-continue hidden>保存データから続ける</button></div></div>
    <ul><li>20クラブ・ホーム＆アウェー38試合</li><li>国内＋欧州6か国、800人超の架空選手データ</li><li>他クラブの所属・OVR・出場・得点・アシスト・評価点</li><li>移籍金交渉 → 選手との年俸・契約年数交渉</li><li>契約更新、契約満了、移籍リスト、他クラブからのオファー</li><li>通常試合とクイックシミュレーションを選択</li></ul>
  </div>

  <div class="sim-play" data-play hidden>
    <div class="sim-grid">      <section class="sim-card">
        <div class="sim-card-head"><h3>TACTICAL BOARD</h3><span data-opponent-badge>vs Northbridge United</span></div>
        <div class="football-pitch football-lineup-pitch" data-pitch-lineup></div>
        <div class="club-lines"><div><span>ATTACK</span><strong data-attack>0.0</strong></div><div><span>MIDFIELD</span><strong data-midfield>0.0</strong></div><div><span>DEFENSE</span><strong data-defense>0.0</strong></div></div>
      </section>
      <section class="sim-card">
        <div class="sim-card-head"><h3>次節の準備</h3><span data-opponent-level>相手 OVR 69</span></div>
        <div class="football-control-grid">
          <label>フォーメーション<select data-formation><option value="433">4-3-3</option><option value="4231">4-2-3-1</option><option value="343">3-4-3</option><option value="532">5-3-2</option></select></label>
          <label>戦術<select data-tactic><option value="balanced">バランス</option><option value="possession">ポゼッション</option><option value="counter">カウンター</option><option value="press">ハイプレス</option><option value="block">ローブロック</option></select></label>
          <label class="wide-control">今週の練習<select data-training><option value="balanced">総合練習</option><option value="attack">攻撃連携</option><option value="defense">守備組織</option><option value="fitness">フィジカル</option><option value="recovery">リカバリー</option></select></label>
        </div>
        <div class="sim-progress"><span>XI FITNESS</span><progress data-fitness max="100" value="90"></progress><b data-fitness-text>90</b></div>
        <div class="sim-progress"><span>XI FORM</span><progress data-morale max="100" value="60"></progress><b data-morale-text>3.0</b></div>
        <div class="sim-event" data-scout>相手分析：バランス型。</div>
        <div class="match-action-grid"><button class="sim-primary" type="button" data-match>キックオフ</button><button class="sim-secondary quick-sim" type="button" data-quick-match>クイックシミュレーション</button></div>
        <div class="sim-result" data-result>スタメンと戦術を確認しよう。</div>
        <div class="halftime-box" data-halftime hidden>
          <div class="halftime-title"><strong>HALF TIME</strong><span data-halftime-score>0 - 0</span></div>
          <p>戦術変更も可能。ベンチから最大3人まで交代できます。</p>
          <div class="sub-controls"><label>OUT<select data-sub-out></select></label><label>IN<select data-sub-in></select></label><button class="sim-secondary" type="button" data-make-sub>交代する</button></div>
          <small data-sub-count>交代 0 / 3</small>
        </div>
      </section>
    </div>

    <div class="sim-grid football-squad-grid">
      <section class="sim-card">
        <div class="sim-card-head"><h3>スタメン編成</h3><button class="sim-secondary compact" type="button" data-auto-lineup>ベストXI自動選出</button></div>
        <p class="football-help">ポジション適性・能力・調子・体力まで試合計算に反映。負傷中の選手は起用できません。</p>        <div class="lineup-editor" data-lineup-editor></div>
        <div class="sim-card-head bench-heading"><h3>ベンチ</h3><span>7 players</span></div>
        <div class="bench-editor" data-bench-editor></div>
      </section>
      <section class="sim-card player-detail-card">
        <div class="sim-card-head"><h3>PLAYER PROFILE</h3><span data-player-owned>所属選手</span></div>
        <div data-player-detail></div>
      </section>
    </div>

    <nav class="football-management-tabs" data-football-tabs aria-label="クラブ管理メニュー">
      <button type="button" class="active" data-football-tab="squad">所属選手</button>
      <button type="button" data-football-tab="market">移籍市場</button>
      <button type="button" data-football-tab="world">他クラブ</button>
      <button type="button" data-football-tab="club">クラブ運営</button>
      <button type="button" data-football-tab="stats">成績</button>
    </nav>

    <section class="sim-card football-panel" data-football-panel="squad">
      <div class="sim-card-head"><h3>所属選手</h3><span data-squad-count>22 players</span></div>
      <div class="football-table-wrap">
        <table class="player-table player-table-deep"><thead><tr><th>PLAYER</th><th>POS</th><th>AGE</th><th>OVR</th><th>POT</th><th>FORM</th><th>FIT</th><th>APP</th><th>G</th><th>A</th><th>AVG</th><th>VALUE</th><th>契約</th><th></th></tr></thead><tbody data-squad-table></tbody></table>
      </div>
    </section>

    <section class="sim-card football-panel" data-football-panel="market" hidden>
      <div class="sim-card-head market-heading"><div><h3>欧州移籍市場</h3><span data-market-window>SUMMER WINDOW OPEN</span></div><button class="sim-secondary compact" type="button" data-market-refresh>移籍候補を更新 ¥5,000,000</button></div>
      <div class="transfer-window-strip"><span data-window-status>OPEN</span><b data-market-count>0 players</b><small>移籍期間外でも閲覧・スカウトは可能です。</small></div>
      <div class="football-browser-controls market-browser-controls">
        <label>COUNTRY<select data-market-country></select></label><label>CLUB<select data-market-club></select></label><label>POS<select data-market-filter><option value="ALL">ALL</option><option value="GK">GK</option><option value="DF">DF</option><option value="MF">MF</option><option value="FW">FW</option></select></label><label>SORT<select data-market-sort><option value="ovr">OVR順</option><option value="pot">POT順</option><option value="price">市場価値順</option><option value="age">年齢順</option></select></label>
      </div>      <p class="football-help">一覧は移籍リスト入り選手を中心に最大48人表示。クラブを指定すると所属全選手を確認できます。詳細能力はスカウト、OVR・成績・契約状況は常時確認できます。</p>
      <div class="football-transfer-market" data-transfer-market></div>
      <div class="negotiation-panel" data-negotiation hidden></div>
    </section>

    <section class="sim-card football-panel" data-football-panel="world" hidden>
      <div class="sim-card-head"><div><h3>CLUB & PLAYER DATABASE</h3><span>国内19クラブ＋欧州6か国</span></div><b data-world-club-summary>---</b></div>
      <div class="football-browser-controls"><label>COUNTRY<select data-world-country></select></label><label>CLUB<select data-world-club></select></label></div>
      <div class="football-table-wrap">
        <table class="player-table club-roster-table"><thead><tr><th>PLAYER</th><th>POS</th><th>AGE</th><th>OVR</th><th>POT</th><th>APP</th><th>G</th><th>A</th><th>AVG</th><th>契約</th><th>VALUE</th><th></th></tr></thead><tbody data-world-roster></tbody></table>
      </div>
    </section>

    <div class="sim-grid football-panel" data-football-panel="club" hidden>
      <section class="sim-card">
        <div class="sim-card-head"><h3>クラブ施設</h3><span data-facility-count>0 / 4</span></div>
        <div class="facility-grid">
          <div class="facility-card"><strong>トレーニングセンター</strong><small>試合・練習で得る成長XP +40%</small><button type="button" data-facility="training">¥100,000,000</button></div>
          <div class="facility-card"><strong>リカバリー室</strong><small>試合後の体力回復 +6</small><button type="button" data-facility="recovery">¥80,000,000</button></div>
          <div class="facility-card"><strong>ユースアカデミー</strong><small>オフに高POT若手2名加入、若手成長UP</small><button type="button" data-facility="academy">¥120,000,000</button></div>
          <div class="facility-card"><strong>スタジアム改修</strong><small>ホーム戦収入・ファン増加量UP</small><button type="button" data-facility="stadium">¥150,000,000</button></div>
        </div>
        <div class="finance-strip"><span>選手給与/節 <b data-payroll>¥0</b></span><span>前節収支 <b data-net-income>¥0</b></span><span>市場価値合計 <b data-squad-value>¥0</b></span></div>
      </section>
      <section class="sim-card"><div class="sim-card-head"><h3>移籍オファー</h3><span data-offer-count>0 pending</span></div><div class="offer-list" data-transfer-offers><p>現在オファーはありません。</p></div></section>
      <section class="sim-card"><div class="sim-card-head"><h3>マッチセンター</h3><span data-scoreline>-- - --</span></div><div class="match-feed" data-match-feed><div>キックオフすると試合経過が表示されます。</div></div><ul class="sim-log" data-log></ul></section>
    </div>    <div class="sim-grid equal football-panel" data-football-panel="stats" hidden>
      <section class="sim-card"><div class="sim-card-head"><h3>リーグテーブル</h3><span data-table-note>第0節終了</span></div><div class="football-table-wrap"><table class="league-table league-table-wide"><thead><tr><th>#</th><th>CLUB</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>GD</th><th>PTS</th></tr></thead><tbody data-league-table></tbody></table></div></section>
      <section class="sim-card"><div class="sim-card-head"><h3>リーグ個人成績</h3><span>TOP SCORERS</span></div><div class="player-leaders" data-player-leaders></div></section>
    </div>
    <div class="sim-grid equal football-panel" data-football-panel="stats" hidden>
      <section class="sim-card"><div class="sim-card-head"><h3>移籍履歴</h3><span data-transfer-history-count>0 deals</span></div><div class="transfer-history" data-transfer-history><p>まだ移籍はありません。</p></div></section>
      <section class="sim-card season-history-card"><div class="sim-card-head"><h3>クラブヒストリー</h3><span data-history-count>0 seasons</span></div><div class="season-history" data-season-history><p>まだ完了したシーズンはありません。</p></div></section>
    </div>

    <div class="game-over" data-game-over hidden>
      <span>SEASON COMPLETE</span><strong data-final-points>0 pt</strong><p data-final-comment></p>
      <div class="season-reward" data-season-reward></div>
      <button class="button button-primary" type="button" data-next-season>クラブを引き継いで次シーズンへ</button>
    </div>
    <div class="sim-bottom"><button type="button" data-restart>クラブを完全リセット</button></div>
  </div>
</section>
</ToolLayout>

<script>
  const footballRoot = document.querySelector<HTMLElement>('[data-mode="football-club-sim"]');
  const startButton = footballRoot?.querySelector<HTMLButtonElement>('[data-start]');
  const continueButton = footballRoot?.querySelector<HTMLButtonElement>('[data-continue]');
  if (continueButton) {
    try {
      continueButton.hidden = !(localStorage.getItem('utility-tools:sim:football-club-sim:v5') || localStorage.getItem('utility-tools:sim:football-club-sim:v4'));
    } catch {}
  }
  let footballLoaded = false;
  let footballLoading = false;
  const loadFootball = async (event: Event) => {
    if (footballLoaded || footballLoading) return;
    event.preventDefault();
    footballLoading = true;
    const button = event.currentTarget as HTMLButtonElement;
    const originalText = button.textContent || '';
    if (footballRoot) { footballRoot.dataset.loading = 'true'; footballRoot.setAttribute('aria-busy', 'true'); }
    button.disabled = true;
    button.textContent = '読み込み中…';
    try {
      const { bootFootball } = await import('../../scripts/football-club-sim');
      footballLoaded = true;
      button.disabled = false;
      bootFootball(button === continueButton);
    } finally {
      footballLoading = false;
      button.disabled = false;
      button.textContent = originalText;
      if (footballRoot) { delete footballRoot.dataset.loading; footballRoot.removeAttribute('aria-busy'); }
    }
  };
  startButton?.addEventListener('click', loadFootball);
  continueButton?.addEventListener('click', loadFootball);
</script>
