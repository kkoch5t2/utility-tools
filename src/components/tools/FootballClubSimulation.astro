function applyResult(a:any,b:any,ga:number,gb:number){a.p++;b.p++;a.gf+=ga;a.ga+=gb;b.gf+=gb;b.ga+=ga;if(ga>gb){a.w++;b.l++;a.pts+=3}else if(ga<gb){b.w++;a.l++;b.pts+=3}else{a.d++;b.d++;a.pts++;b.pts++}}
function poisson(lambda:number){let L=Math.exp(-lambda),p=1,k=0;do{k++;p*=Math.random()}while(p>L&&k<9);return k-1}
function weighted<T>(arr:T[],weight:(x:T)=>number){let sum=arr.reduce((a,x)=>a+Math.max(.1,weight(x)),0),r=Math.random()*sum;for(const x of arr){r-=Math.max(.1,weight(x));if(r<=0)return x}return arr[arr.length-1]}
