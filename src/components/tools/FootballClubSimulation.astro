---
import ToolLayout from "../layout/ToolLayout.astro";
import type { ExtraToolMeta } from "../../config/extra-tools";
interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
---

<ToolLayout title={meta.title} description={meta.description} name={meta.name} category={meta.category} faqs={meta.faqs}>
<section class="sim-shell football-sim football-deep" data-sim-game data-mode="football-club-sim" data-state="ready">
  <header class="sim-top"><div><p class="sim-kicker">MULTI SEASON / CLUB MANAGEMENT</p><h2>Harbor City FC</h2><p class="sim-sub">補強、起用、育成、交代、施設、財政まで管理するクラブ経営。若手は伸び、ベテランは衰え、移籍市場はシーズン中も動きます。</p></div><div class="sim-best"><span>BEST SEASON</span><strong data-best>0 pt</strong></div></header>
  <div class="sim-kpis">
    <div class="sim-kpi"><span>SEASON / MATCH</span><strong data-season>1年目</strong><small data-week>1 / 14</small></div>
    <div class="sim-kpi"><span>POINTS</span><strong data-points>0</strong><small data-rank>順位 --</small></div>
    <div class="sim-kpi"><span>BUDGET</span><strong data-budget>¥500,000,000</strong><small data-finance-note>給与/節 ¥0</small></div>
    <div class="sim-kpi"><span>STARTING XI</span><strong data-quality>67.0</strong><small data-chemistry>適性 100%</small></div>
    <div class="sim-kpi"><span>SUPPORTERS</span><strong data-fans>18,000</strong><small data-record>0勝 0分 0敗</small></div>
  </div>

  <div class="sim-intro" data-intro>
    <div><h3>クラブの時間が進む、本格キャリアへ</h3><p>各選手には能力、POT、調子、体力、年俸相当コスト、個人成績があります。試合は前半→ハーフタイム→後半で進み、最大3人まで途中交代可能。14節を終えてもクラブを引き継いで次シーズンへ進めます。</p><div class="sim-actions"><button class="button button-primary" type="button" data-start>新しいクラブで始める</button><button class="button button-secondary" type="button" data-continue hidden>保存データから続ける</button></div></div>
    <ul><li>18人の初期スカッド＋毎ウィンドウ20人の移籍候補</li><li>POT・成長・加齢・衰退・市場価値</li><li>得点 / アシスト / 出場 / MOM / 調子</li><li>ベンチ7人・ハーフタイム最大3人交代</li><li>4節ごとに移籍市場更新、スカウトで詳細能力開示</li><li>シーズンを跨いで選手・施設・資金を引き継ぎ</li></ul>
  </div>

  <div class="sim-play" data-play hidden>
    <div class="sim-grid">
      <section class="sim-card">
        <div class="sim-card-head"><h3>TACTICAL BOARD</h3><span data-opponent-badge>vs Northbridge United</span></div>
        <div class="football-pitch football-lineup-pitch" data-pitch-lineup></div>
        <div class="club-lines"><div><span>ATTACK</span><strong data-attack>0.0</strong></div><div><span>MIDFIELD</span><strong data-midfield>0.0</strong></div><div><span>DEFENSE</span><strong data-defense>0.0</strong></div></div>
      </section>

      <section class="sim-card">
        <div class="sim-card-head"><h3>次節の準備</h3><span data-opponent-level>相手 OVR 69</span></div>
        <div class="football-control-grid">
          <label>フォーメーション<select data-formation><option value="433">4-3-3</option><option value="4231">4-2-3-1</option><option value="343">3-4-3</option><option value="532">5-3-2</option></select></label>
          <label>戦術<select data-tactic><option value="balanced">バランス</option><option value="possession">ポゼッション</option><option value="counter">カウンター</option><option value="press">ハイプレス</option><option value="block">ローブロック</option></select></label>
          <label class="wide-control">今週の練習<select data-training><option value="balanced">総合練習</option><option value="attack">攻撃連携</option><option value="defense">守備組織</option><option value="fitness">フィジカル</option><option value="recovery">リカバリー</option></select></label>
        </div>
        <div class="sim-progress"><span>XI FITNESS</span><progress data-fitness max="100" value="90"></progress><b data-fitness-text>90</b></div>
        <div class="sim-progress"><span>XI FORM</span><progress data-morale max="100" value="60"></progress><b data-morale-text>3.0</b></div>
        <div class="sim-event" data-scout>相手分析：バランス型。</div>
        <button class="sim-primary" type="button" data-match>キックオフ</button>
        <div class="sim-result" data-result>スタメンと戦術を確認しよう。</div>

        <div class="halftime-box" data-halftime hidden>
          <div class="halftime-title"><strong>HALF TIME</strong><span data-halftime-score>0 - 0</span></div>
          <p>戦術変更も可能。ベンチから最大3人まで交代できます。</p>
          <div class="sub-controls"><label>OUT<select data-sub-out></select></label><label>IN<select data-sub-in></select></label><button class="sim-secondary" type="button" data-make-sub>交代する</button></div>
          <small data-sub-count>交代 0 / 3</small>
        </div>
      </section>
    </div>

    <div class="sim-grid football-squad-grid">
      <section class="sim-card">
        <div class="sim-card-head"><h3>スタメン編成</h3><button class="sim-secondary compact" type="button" data-auto-lineup>ベストXI自動選出</button></div>
        <p class="football-help">ポジション適性・能力・調子・体力まで試合計算に反映。負傷中の選手は起用できません。</p>
        <div class="lineup-editor" data-lineup-editor></div>
        <div class="sim-card-head bench-heading"><h3>ベンチ</h3><span>7 players</span></div>
        <div class="bench-editor" data-bench-editor></div>
      </section>

      <section class="sim-card player-detail-card">
        <div class="sim-card-head"><h3>PLAYER PROFILE</h3><span data-player-owned>所属選手</span></div>
        <div data-player-detail></div>
      </section>
    </div>

    <nav class="football-management-tabs" data-football-tabs aria-label="クラブ管理メニュー">
      <button type="button" class="active" data-football-tab="squad">所属選手</button>
      <button type="button" data-football-tab="market">移籍市場</button>
      <button type="button" data-football-tab="club">クラブ運営</button>
      <button type="button" data-football-tab="stats">成績</button>
    </nav>

    <section class="sim-card football-panel" data-football-panel="squad">
      <div class="sim-card-head"><h3>所属選手</h3><span data-squad-count>18 players</span></div>
      <div class="football-table-wrap">
        <table class="player-table player-table-deep"><thead><tr><th>PLAYER</th><th>POS</th><th>AGE</th><th>OVR</th><th>POT</th><th>FORM</th><th>FIT</th><th>APP</th><th>G</th><th>A</th><th>MOM</th><th>VALUE</th><th></th></tr></thead><tbody data-squad-table></tbody></table>
      </div>
    </section>

    <section class="sim-card football-panel" data-football-panel="market" hidden>
      <div class="sim-card-head market-heading"><div><h3>移籍市場</h3><span data-market-window>WINDOW 1 / 次回自動更新 第5節</span></div><div class="market-actions"><button class="sim-secondary compact" type="button" data-market-refresh>市場を更新 ¥5,000,000</button><div class="market-filters"><label>POS<select data-market-filter><option value="ALL">ALL</option><option value="GK">GK</option><option value="DF">DF</option><option value="MF">MF</option><option value="FW">FW</option></select></label><label>SORT<select data-market-sort><option value="ovr">OVR順</option><option value="pot">POT順</option><option value="price">価格順</option><option value="age">年齢順</option></select></label></div></div></div>
      <p class="football-help">詳細能力とPOTはスカウト済み選手のみ表示。毎ウィンドウ数人は事前スカウト済みで、若手の逸材が混ざることもあります。</p>
      <div class="football-transfer-market" data-transfer-market></div>
    </section>

    <div class="sim-grid football-panel" data-football-panel="club" hidden>
      <section class="sim-card">
        <div class="sim-card-head"><h3>クラブ施設</h3><span data-facility-count>0 / 4</span></div>
        <div class="facility-grid">
          <div class="facility-card"><strong>トレーニングセンター</strong><small>試合・練習で得る成長XP +40%</small><button type="button" data-facility="training">¥100,000,000</button></div>
          <div class="facility-card"><strong>リカバリー室</strong><small>試合後の体力回復 +6</small><button type="button" data-facility="recovery">¥80,000,000</button></div>
          <div class="facility-card"><strong>ユースアカデミー</strong><small>オフに高POT若手2名加入、若手成長UP</small><button type="button" data-facility="academy">¥120,000,000</button></div>
          <div class="facility-card"><strong>スタジアム改修</strong><small>ホーム戦収入・ファン増加量UP</small><button type="button" data-facility="stadium">¥150,000,000</button></div>
        </div>
        <div class="finance-strip"><span>選手給与/節 <b data-payroll>¥0</b></span><span>前節収支 <b data-net-income>¥0</b></span><span>市場価値合計 <b data-squad-value>¥0</b></span></div>
      </section>
      <section class="sim-card"><div class="sim-card-head"><h3>マッチセンター</h3><span data-scoreline>-- - --</span></div><div class="match-feed" data-match-feed><div>キックオフすると試合経過が表示されます。</div></div><ul class="sim-log" data-log></ul></section>
    </div>

    <div class="sim-grid equal football-panel" data-football-panel="stats" hidden>
      <section class="sim-card"><div class="sim-card-head"><h3>リーグテーブル</h3><span data-table-note>第0節終了</span></div><table class="league-table"><thead><tr><th>#</th><th>CLUB</th><th>P</th><th>GD</th><th>PTS</th></tr></thead><tbody data-league-table></tbody></table></section>
      <section class="sim-card"><div class="sim-card-head"><h3>個人成績</h3><span>クラブ内ランキング</span></div><div class="player-leaders" data-player-leaders></div></section>
    </div>

    <section class="sim-card season-history-card football-panel" data-football-panel="stats" hidden><div class="sim-card-head"><h3>クラブヒストリー</h3><span data-history-count>0 seasons</span></div><div class="season-history" data-season-history><p>まだ完了したシーズンはありません。</p></div></section>

    <div class="game-over" data-game-over hidden>
      <span>SEASON COMPLETE</span><strong data-final-points>0 pt</strong><p data-final-comment></p>
      <div class="season-reward" data-season-reward></div>
      <button class="button button-primary" type="button" data-next-season>クラブを引き継いで次シーズンへ</button>
    </div>
    <div class="sim-bottom"><button type="button" data-restart>クラブを完全リセット</button></div>
  </div>
</section>
</ToolLayout>

<script>
type Player={
 id:string;name:string;nation:string;age:number;pos:string[];ovr:number;pot:number;
 pac:number;sho:number;pas:number;dri:number;def:number;phy:number;price:number;value:number;wage:number;
 form:number;fit:number;dev:number;apps:number;starts:number;goals:number;assists:number;mom:number;injury:number;
 scouted:boolean;trait:string;
};
const root=document.querySelector<HTMLElement>('[data-mode="football-club-sim"]')!,intro=root.querySelector<HTMLElement>("[data-intro]")!,play=root.querySelector<HTMLElement>("[data-play]")!;
const KEY="utility-tools:sim:football-club-sim:v4",BEST="utility-tools:sim:football-club-sim:best";
const yen=(n:number)=>"¥"+Math.round(n).toLocaleString("ja-JP"),clamp=(n:number,a:number,b:number)=>Math.max(a,Math.min(b,n)),ri=(a:number,b:number)=>Math.floor(a+Math.random()*(b-a+1));
const q=(x:string)=>root.querySelector<HTMLElement>(x)!,qb=(x:string)=>root.querySelector<HTMLButtonElement>(x)!,qs=(x:string)=>root.querySelector<HTMLSelectElement>(x)!;
const baseTemplates:any[]=[
 {pos:["GK"],ovr:69,pac:42,sho:12,pas:61,dri:46,def:18,phy:70},{pos:["LB","LWB"],ovr:67,pac:75,sho:42,pas:65,dri:68,def:66,phy:64},
 {pos:["CB"],ovr:69,pac:61,sho:28,pas:57,dri:50,def:73,phy:76},{pos:["CB","RB"],ovr:68,pac:68,sho:31,pas:60,dri:58,def:70,phy:72},
 {pos:["RB","RWB"],ovr:67,pac:78,sho:40,pas:63,dri:67,def:64,phy:62},{pos:["CM","DM"],ovr:69,pac:65,sho:61,pas:74,dri:71,def:65,phy:66},
 {pos:["CM","AM"],ovr:68,pac:70,sho:65,pas:72,dri:73,def:48,phy:59},{pos:["CM","DM"],ovr:67,pac:62,sho:55,pas:70,dri:66,def:67,phy:69},
 {pos:["LW","RW"],ovr:70,pac:82,sho:69,pas:66,dri:78,def:31,phy:58},{pos:["ST"],ovr:71,pac:75,sho:77,pas:58,dri:70,def:25,phy:71},
 {pos:["RW","LW"],ovr:69,pac:81,sho:68,pas:64,dri:76,def:29,phy:56},{pos:["GK"],ovr:64,pac:37,sho:10,pas:57,dri:40,def:16,phy:65},
 {pos:["CB"],ovr:65,pac:55,sho:26,pas:54,dri:46,def:69,phy:74},{pos:["LB","RB"],ovr:64,pac:74,sho:36,pas:59,dri:63,def:61,phy:58},
 {pos:["CM","DM"],ovr:66,pac:61,sho:57,pas:69,dri:64,def:64,phy:67},{pos:["AM","CM"],ovr:66,pac:69,sho:64,pas:70,dri:71,def:38,phy:55},
 {pos:["ST","LW"],ovr:66,pac:72,sho:70,pas:53,dri:65,def:24,phy:69},{pos:["RW","AM"],ovr:65,pac:79,sho:61,pas:63,dri:72,def:27,phy:52}
];
const marketTemplates:any[]=[
 {pos:["ST","RW"],ovr:73,pac:79,sho:78,pas:62,dri:74,def:27,phy:70,price:8e7},{pos:["CM","AM"],ovr:75,pac:70,sho:69,pas:81,dri:79,def:58,phy:65,price:12e7},
 {pos:["CB"],ovr:76,pac:67,sho:31,pas:66,dri:57,def:82,phy:81,price:15e7},{pos:["LW","RW"],ovr:77,pac:91,sho:75,pas:70,dri:84,def:29,phy:67,price:17e7},
 {pos:["AM","RW"],ovr:72,pac:82,sho:69,pas:75,dri:83,def:30,phy:55,price:7.2e7},{pos:["GK"],ovr:74,pac:44,sho:11,pas:68,dri:49,def:19,phy:76,price:9e7},
 {pos:["DM","CM"],ovr:74,pac:66,sho:54,pas:78,dri:72,def:75,phy:73,price:10.5e7},{pos:["ST"],ovr:71,pac:78,sho:75,pas:55,dri:73,def:20,phy:66,price:6e7},
 {pos:["CB","DM"],ovr:72,pac:58,sho:35,pas:66,dri:55,def:77,phy:80,price:6.5e7},{pos:["RB","RWB"],ovr:73,pac:86,sho:46,pas:69,dri:74,def:70,phy:71,price:8.8e7},
 {pos:["LB","LWB"],ovr:72,pac:84,sho:43,pas:70,dri:75,def:68,phy:64,price:7.8e7},{pos:["ST"],ovr:75,pac:69,sho:83,pas:58,dri:69,def:23,phy:82,price:11e7},
 {pos:["CM","AM"],ovr:69,pac:74,sho:64,pas:73,dri:76,def:50,phy:54,price:4.8e7},{pos:["RW","LW","AM"],ovr:74,pac:85,sho:72,pas:73,dri:81,def:32,phy:61,price:9.8e7},
 {pos:["CB","RB"],ovr:74,pac:72,sho:32,pas:65,dri:61,def:78,phy:77,price:10.2e7},{pos:["DM","CB"],ovr:73,pac:63,sho:48,pas:72,dri:66,def:77,phy:78,price:8.5e7},
 {pos:["AM","CM"],ovr:76,pac:72,sho:74,pas:82,dri:80,def:44,phy:60,price:14.5e7},{pos:["ST","LW"],ovr:72,pac:88,sho:74,pas:59,dri:76,def:25,phy:72,price:7.6e7},
 {pos:["GK"],ovr:71,pac:40,sho:9,pas:64,dri:44,def:18,phy:74,price:5.5e7},{pos:["CB","DM"],ovr:71,pac:69,sho:38,pas:67,dri:61,def:75,phy:75,price:6.8e7}
];
const firstNames=["Ren","Haru","Sota","Kai","Leo","Noah","Luca","Mateo","Elias","Theo","Finn","Milan","Hugo","Niko","Emil","Rui","Jun","Kei","Toma","Yuki","Alex","Oscar","Bruno","Dario","Samir","Louis","Marco","Daniel","Jin","Aiden","Riku","Kota","Enzo","Ivan","Mika","Luis"];
const lastNames=["Arai","Kudo","Mori","Tanaka","Sato","Kobayashi","Ito","Seo","Park","Vale","Finch","Marin","Ward","Bauer","Costa","Keller","Navarro","Diaz","Okafor","Leclerc","Petrov","Reyes","Ferreira","Hansen","Rossi","Silva","Mendes","Lund","Bennett","Varga","Nwosu","Adebayo","Moretti","Dubois","Santos","Kim","Garcia","Fischer","Novak","Andersen"];
const nations=["🇯🇵","🇰🇷","🇬🇧","🇪🇸","🇵🇹","🇩🇪","🇫🇷","🇮🇹","🇧🇷","🇦🇷","🇳🇬","🇬🇭","🇩🇰","🇸🇪","🇷🇸","🇲🇽","🇺🇸","🇨🇦","🇦🇺","🇭🇺"];
const formations:any={
 "433":[["GK",7,44],["LB",23,12],["CB",23,35],["CB",23,59],["RB",23,82],["CM",49,22],["CM",49,49],["CM",49,76],["LW",78,14],["ST",83,49],["RW",78,84]],
 "4231":[["GK",7,44],["LB",23,12],["CB",23,35],["CB",23,59],["RB",23,82],["DM",45,34],["DM",45,64],["LW",66,15],["AM",63,49],["RW",66,83],["ST",84,49]],
 "343":[["GK",7,44],["CB",24,22],["CB",24,49],["CB",24,76],["LM",49,9],["CM",49,38],["CM",49,62],["RM",49,90],["LW",78,16],["ST",83,49],["RW",78,82]],
 "532":[["GK",7,44],["LWB",22,6],["CB",22,27],["CB",22,49],["CB",22,71],["RWB",22,92],["CM",51,23],["CM",51,49],["CM",51,75],["ST",82,35],["ST",82,65]]
};
const teams=[{name:"Harbor City FC",ovr:68},{name:"Northbridge United",ovr:69},{name:"Blue Coast FC",ovr:71},{name:"Redwood Athletic",ovr:66},{name:"Metro Stars",ovr:74},{name:"Riverside 04",ovr:65},{name:"Crown Town",ovr:70},{name:"West Bay",ovr:68}],schedule=[1,2,3,4,5,6,7,7,6,5,4,3,2,1],facilityCosts:any={training:1e8,recovery:8e7,academy:12e7,stadium:15e7};

function seeded(seed:number){return()=>{seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function newSeed(){try{const a=new Uint32Array(1);crypto.getRandomValues(a);return a[0]||Date.now()}catch{return Date.now()+Math.floor(Math.random()*1e7)}}
function traitFor(p:any){if(p.pac>=86)return"スピードスター";if(p.sho>=80)return"フィニッシャー";if(p.pas>=80)return"司令塔";if(p.def>=79)return"ボールハンター";if(p.phy>=80)return"フィジカル";if(p.dri>=80)return"ドリブラー";return"万能型"}
function marketValue(p:any){const age= p.age<=21?1.18:p.age>=31?.72:1;const potBonus=1+Math.max(0,p.pot-p.ovr)*.035;return Math.round(Math.max(12000000,(p.ovr-55)**2*650000*age*potBonus)/1000000)*1000000}
function wageFor(p:any){return Math.round((250000+Math.max(0,p.ovr-62)*55000+(p.ovr>=78?300000:0))/10000)*10000}
function makePlayer(t:any,id:string,rnd:()=>number,isMarket:boolean,forceWonder=false):Player{
 const rr=(a:number,b:number)=>Math.floor(a+rnd()*(b-a+1)),pick=<T,>(a:T[])=>a[Math.floor(rnd()*a.length)];
 const age=forceWonder?rr(18,20):rr(isMarket?19:20,isMarket?32:33),ovr=clamp(t.ovr+rr(-2,2),60,82);
 let pot=ovr+(age<=20?rr(8,16):age<=23?rr(5,13):age<=27?rr(2,8):rr(0,3));if(forceWonder)pot=Math.max(86,ovr+rr(12,18));pot=clamp(pot,ovr,92);
 const vary=(v:number)=>clamp(v+rr(-4,4),8,95);const p:any={id,name:pick(firstNames)+" "+pick(lastNames),nation:pick(nations),age,pos:[...t.pos],ovr,pot,pac:vary(t.pac),sho:vary(t.sho),pas:vary(t.pas),dri:vary(t.dri),def:vary(t.def),phy:vary(t.phy),price:0,value:0,wage:0,form:3,fit:rr(86,100),dev:rr(0,35),apps:0,starts:0,goals:0,assists:0,mom:0,injury:0,scouted:!isMarket,trait:""};
 p.trait=traitFor(p);p.value=marketValue(p);p.price=isMarket?Math.round((p.value*(.93+rnd()*.2))/1000000)*1000000:0;p.wage=wageFor(p);return p;
}
function generateSquad(seed:number){const rnd=seeded(seed),used=new Set<string>();return baseTemplates.map((t,i)=>{let p=makePlayer(t,"s"+i,rnd,false);while(used.has(p.name))p=makePlayer(t,"s"+i,rnd,false);used.add(p.name);return p})}
function generateMarket(seed:number,season:number,window:number){const rnd=seeded(seed+season*7919+window*104729),used=new Set<string>();return marketTemplates.map((t,i)=>{let p=makePlayer(t,`m${season}_${window}_${i}`,rnd,true,i===12);while(used.has(p.name))p=makePlayer(t,`m${season}_${window}_${i}`,rnd,true,i===12);used.add(p.name);p.scouted=i<3||i===12;return p})}
