 qb("[data-match]").textContent=s.match?.phase==="halftime"?"後半開始 → FULL TIME":"キックオフ → 前半";qb("[data-match]").disabled=s.complete;
 q("[data-game-over]").hidden=!s.complete;if(s.complete){root.dataset.state="complete";const last=s.history[s.history.length-1];if(last){q("[data-final-points]").textContent=last.points+" pt / "+last.rank+"位";q("[data-final-comment]").textContent=last.rank===1?"リーグ制覇。次は王者として連覇を狙えます。":last.rank<=3?"TOP3達成。若手育成と補強でタイトルへ。":"シーズン完走。オフの補強と世代交代が次の勝負です。";q("[data-season-reward]").textContent="順位賞金 "+yen(last.prize)+" ＋ 来季スポンサー収入"}}else root.dataset.state="running";
 renderPitch();renderLineupEditor();renderBench();renderSquad();renderMarket();renderLeaders();renderHalftime();renderHistory();playerProfile(playerById(s.selectedPlayer)||s.squad[0]);
}
function start(load=false){s=load&&read()?read():fresh();if(!s.squad||!s.lineup||!s.market||!s.seed||!s.bench){s=fresh()}intro.hidden=true;play.hidden=false;render();save(s)}
function applyTraining(){const tr=qs("[data-training]").value;for(const p of s.squad){if(p.injury>0)p.injury--;if(tr==="recovery")p.fit+=12;else if(tr==="fitness")p.fit+=7;else p.fit+=3;const ageBonus=p.age<=21?5:p.age<=24?3:1;develop(p,ageBonus+(tr==="balanced"?3:tr==="recovery"?0:4));if(tr==="attack"){p.sho=clamp(p.sho+.08,1,99);p.pas=clamp(p.pas+.05,1,99)}if(tr==="defense"){p.def=clamp(p.def+.08,1,99);p.phy=clamp(p.phy+.05,1,99)}recalcPlayer(p)}}
function tacticalNumbers(){const oi=schedule[Math.min(s.week-1,13)],oppOvr=teams[oi].ovr,ls=lineStats(),tactic=qs("[data-tactic]").value;let att=ls.attack,mid=ls.mid,def=ls.def,drain=8;const oppStyle=["balanced","press","counter","possession","block"][oi%5],edges:any={counter:{press:.8,possession:.3},possession:{block:.5,balanced:.2},press:{possession:.5,balanced:.15},block:{counter:.4,press:-.15},balanced:{}};const edge=edges[tactic]?.[oppStyle]??0;if(tactic==="press"){att+=1;mid+=.8;drain=12}else if(tactic==="counter"){att+=.5;def+=.35;drain=7}else if(tactic==="possession"){mid+=1;drain=9}else if(tactic==="block"){def+=1.1;att-=.35;drain=6}att+=edge;def+=edge*.6;return{att,mid,def,drain,oppOvr,ls}}
function recordGoal(minute:number){const outfield=s.lineup.map((id:string)=>playerById(id)).filter((p:Player)=>!p.pos.includes("GK")),scorer=weighted(outfield,(p:Player)=>p.sho+p.pac*.18+p.form*7+(p.pos.includes("ST")?25:0)),others=outfield.filter((p:Player)=>p.id!==scorer.id),assist=Math.random()<.82?weighted(others,(p:Player)=>p.pas+p.dri*.35):null;scorer.goals++;scorer.form=clamp(scorer.form+.22,1,5);s.match.contrib[scorer.id]=(s.match.contrib[scorer.id]||0)+3;if(assist){assist.assists++;assist.form=clamp(assist.form+.12,1,5);s.match.contrib[assist.id]=(s.match.contrib[assist.id]||0)+2}s.feed.push(`<b>${minute}'</b> ⚽ ${scorer.name}${assist?"（A: "+assist.name+"）":""}`)}
function simulateHalf(half:number){const n=tacticalNumbers(),condition=(n.ls.fitness-70)*.025+(n.ls.form-3)*.38,ourXg=clamp((1.18+(n.att*.55+n.mid*.22+condition-n.oppOvr*.75)/13)/2,.08,1.9),theirXg=clamp((1.08+(n.oppOvr*.78-(n.def*.58+n.mid*.18+condition))/14)/2,.08,1.8),goals=poisson(ourXg),opp=poisson(theirXg),start=half===1?5:50,end=half===1?44:89;for(let i=0;i<goals;i++)recordGoal(ri(start,end));if(opp>0)for(let i=0;i<opp;i++)s.feed.push(`<b>${ri(start,end)}'</b> ⚠️ ${teams[schedule[s.week-1]].name} が得点`);s.match.our+=goals;s.match.their+=opp;for(const id of s.lineup){const p=playerById(id);p.fit-=n.drain/2;recalcPlayer(p)}return{ourXg,theirXg}}
function kickoff(){const injured=s.lineup.map((id:string)=>playerById(id)).filter((p:Player)=>p.injury>0);if(injured.length){q("[data-result]").textContent="負傷中の選手がスタメンです。ベストXI自動選出か手動変更をしてください。";return}applyTraining();const participants=[...s.lineup];for(const id of participants){const p=playerById(id);p.apps++;p.starts++}s.match={phase:"first",our:0,their:0,usedSubs:0,participants,contrib:{},xgFor:0,xgAgainst:0};s.feed=[`<b>0'</b> KICK OFF　${s.formation} / ${qs("[data-tactic]").selectedOptions[0].textContent}`];const x=simulateHalf(1);s.match.xgFor+=x.ourXg;s.match.xgAgainst+=x.theirXg;s.match.phase="halftime";s.feed.push(`<b>45'</b> HALF TIME　Harbor City ${s.match.our} - ${s.match.their} ${teams[schedule[s.week-1]].name}`);q("[data-scoreline]").textContent=s.match.our+" - "+s.match.their;q("[data-result]").textContent=`HALF TIME ${s.match.our} - ${s.match.their}｜交代・戦術変更ができます。`;save(s);render()}
function makeSub(){if(!s.match||s.match.phase!=="halftime"||s.match.usedSubs>=3)return;const outId=qs("[data-sub-out]").value,inId=qs("[data-sub-in]").value,li=s.lineup.indexOf(outId),bi=s.bench.indexOf(inId);if(li<0||bi<0||!healthy(playerById(inId)))return;s.lineup[li]=inId;s.bench[bi]=outId;s.match.usedSubs++;if(!s.match.participants.includes(inId)){s.match.participants.push(inId);playerById(inId).apps++}s.feed.push(`<b>HT</b> 🔄 ${playerById(outId).name} → ${playerById(inId).name}`);save(s);render()}
function finishMatch(){const x=simulateHalf(2);s.match.xgFor+=x.ourXg;s.match.xgAgainst+=x.theirXg;const our=s.match.our,their=s.match.their,oi=schedule[s.week-1],opp=s.table[oi];applyResult(s.table[0],opp,our,their);const remaining=s.table.filter((_:any,i:number)=>i!==0&&i!==oi).sort(()=>Math.random()-.5);for(let i=0;i<remaining.length;i+=2){const a=remaining[i],b=remaining[i+1],ag=poisson(clamp(1.2+(a.ovr-b.ovr)/18,.35,2.8)),bg=poisson(clamp(1.2+(b.ovr-a.ovr)/18,.35,2.8));applyResult(a,b,ag,bg)}
 const won=our>their,draw=our===their,res=won?"W":draw?"D":"L";s.form.push(res);if(s.form.length>5)s.form.shift();for(const id of s.match.participants){const p=playerById(id);p.form=clamp(p.form+(won?.12:draw?.03:-.1),1,5);develop(p,8+(p.age<=23?5:0)+(s.match.contrib[id]||0)*3);recalcPlayer(p)}const momId=[...s.match.participants].sort((a,b)=>(s.match.contrib[b]||0)-(s.match.contrib[a]||0)||playerById(b).form-playerById(a).form)[0],mom=playerById(momId);mom.mom++;mom.form=clamp(mom.form+.15,1,5);
 const home=s.week<=7,attendance=Math.round(s.fans*(home?(.75+Math.random()*.2):.25)),income=Math.round(attendance*(s.facilities.stadium?4200:3200)+(won?1.4e7:draw?7e6:3e6)),pay=payroll(),net=income-pay;s.lastNet=net;s.budget+=net;s.fans=clamp(s.fans+(won?ri(700,1700):draw?ri(100,500):-ri(100,600)),7000,60000);for(const p of s.squad)p.fit+=s.facilities.recovery?6:2;
 const lowFit=s.lineup.map((id:string)=>playerById(id)).filter((p:Player)=>p.fit<62&&p.injury===0);if(lowFit.length&&Math.random()<.16){const injured=lowFit[ri(0,lowFit.length-1)];injured.injury=ri(1,3);s.feed.push(`<b>90'</b> 🚑 ${injured.name} が負傷。離脱 ${injured.injury}節`)}
 s.feed.push(`<b>90'</b> FULL TIME　Harbor City ${our} - ${their} ${teams[oi].name}`);s.feed.push(`⭐ MOM: ${mom.name}`);q("[data-scoreline]").textContent=our+" - "+their;s.log.push(`S${s.season} 第${s.week}節 ${res} ${our}-${their} / 収支 ${net>=0?"+":""}${yen(net)}`);q("[data-result]").textContent=`${our} - ${their}　${won?"WIN":draw?"DRAW":"LOSE"}｜xG ${s.match.xgFor.toFixed(1)}-${s.match.xgAgainst.toFixed(1)}｜MOM ${mom.name}`;s.match=null;s.week++;
 if([5,9,13].includes(s.week)){s.marketWindow++;s.market=generateMarket(s.seed,s.season,s.marketWindow);s.log.push("移籍市場が自動更新：WINDOW "+s.marketWindow)}
 if(s.week>14)finishSeason();else{save(s);render()}}
function finishSeason(){const row=s.table[0],rank=sortedTable().findIndex((x:any)=>x.id===0)+1,prize=rank===1?15e7:rank<=3?10e7:rank<=5?6e7:4e7;saveBest(row.pts);s.complete=true;s.history.push({season:s.season,rank,points:row.pts,record:`${row.w}勝${row.d}分${row.l}敗`,prize});q("[data-final-points]").textContent=row.pts+" pt / "+rank+"位";q("[data-final-comment]").textContent=rank===1?"リーグ制覇。次は王者として連覇を狙えます。":rank<=3?"TOP3達成。若手育成と補強でタイトルへ。":"シーズン完走。オフの補強と世代交代が次の勝負です。";q("[data-season-reward]").textContent="順位賞金 "+yen(prize)+" ＋ 来季スポンサー収入";q("[data-result]").textContent+=`｜シーズン終了：${rank}位 ${row.pts}pt`;save(s);render()}
function nextSeason(){if(!s.complete)return;const last=s.history[s.history.length-1],sponsor=last.rank===1?8e7:last.rank<=3?6e7:4e7;s.budget+=last.prize+sponsor;s.season++;for(const p of s.squad){p.age++;if(p.age>=31){const drop=p.age>=34?2:1;p.ovr=clamp(p.ovr-drop,45,p.pot);p.pac=clamp(p.pac-drop*2,20,99);p.phy=clamp(p.phy-drop,20,99)}else if(p.age<=24)develop(p,35+(s.facilities.academy?25:0));p.apps=0;p.starts=0;p.goals=0;p.assists=0;p.mom=0;p.form=3;p.fit=92;p.injury=0;recalcPlayer(p)}
 const retired=s.squad.filter((p:Player)=>p.age>=36&&Math.random()<.55).map((p:Player)=>p.id);if(retired.length){s.squad=s.squad.filter((p:Player)=>!retired.includes(p.id));s.log.push(retired.length+"名が引退")}
 const youthCount=s.facilities.academy?2:1;for(let i=0;i<youthCount;i++)s.squad.push(makeYouth(s.seed+s.season*12347,i));while(s.squad.length<18)s.squad.push(makeYouth(newSeed(),s.squad.length));
 s.week=1;s.table=tableFresh();s.form=[];s.feed=[];s.lastNet=0;s.match=null;s.complete=false;s.marketWindow=1;s.market=generateMarket(s.seed,s.season,1);autoLineup();s.selectedPlayer=s.lineup[0];root.dataset.state="running";s.log.push("SEASON "+s.season+" 開幕：スポンサー "+yen(sponsor)+" / ユース "+youthCount+"名加入");save(s);render()}
function activateTab(name:string){root.querySelectorAll<HTMLElement>("[data-football-panel]").forEach(el=>el.hidden=el.dataset.footballPanel!==name);root.querySelectorAll<HTMLButtonElement>("[data-football-tab]").forEach(b=>b.classList.toggle("active",b.dataset.footballTab===name))}
root.querySelectorAll<HTMLButtonElement>("[data-football-tab]").forEach(b=>b.onclick=()=>activateTab(b.dataset.footballTab!));activateTab("squad");
qb("[data-start]").onclick=()=>start(false);const cont=qb("[data-continue]");cont.hidden=!read();cont.onclick=()=>start(true);qb("[data-restart]").onclick=()=>{clear();start(false)};qb("[data-next-season]").onclick=nextSeason;
qs("[data-formation]").onchange=()=>{s.formation=qs("[data-formation]").value;autoLineup();save(s);render()};qb("[data-auto-lineup]").onclick=()=>{autoLineup();save(s);render()};qs("[data-market-filter]").onchange=renderMarket;qs("[data-market-sort]").onchange=renderMarket;qb("[data-market-refresh]").onclick=()=>refreshMarket(false);qb("[data-make-sub]").onclick=makeSub;
root.querySelectorAll<HTMLButtonElement>("[data-facility]").forEach(b=>b.onclick=()=>{const k=b.dataset.facility!;if(s.facilities[k]||s.budget<facilityCosts[k]||s.match)return;s.budget-=facilityCosts[k];s.facilities[k]=true;s.log.push("施設完成："+k);save(s);render()});
qb("[data-match]").onclick=()=>{if(s.complete)return;if(s.match?.phase==="halftime")finishMatch();else if(!s.match)kickoff()};
</script>
