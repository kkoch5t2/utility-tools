let s:any=fresh();

function positionGroup(pos:string){if(pos==="GK")return"GK";if(["LB","CB","RB","LWB","RWB"].includes(pos))return"DF";if(["DM","CM","AM","LM","RM"].includes(pos))return"MF";return"FW"}
function compatibility(p:Player,slot:string){if(p.pos.includes(slot))return 1;const sg=positionGroup(slot),groups=p.pos.map(positionGroup);if(sg==="GK"||groups.includes("GK"))return .55;if(groups.includes(sg))return .9;if((["LWB","RWB"].includes(slot)&&groups.includes("MF"))||(["LM","RM"].includes(slot)&&groups.includes("DF")))return .82;return .7}
function rawRoleRating(p:Player,slot:string){if(slot==="GK")return p.ovr;const g=positionGroup(slot);if(slot==="ST")return p.pac*.12+p.sho*.43+p.pas*.09+p.dri*.16+p.def*.02+p.phy*.18;if(["LW","RW"].includes(slot))return p.pac*.27+p.sho*.22+p.pas*.18+p.dri*.24+p.def*.02+p.phy*.07;if(slot==="AM")return p.pac*.13+p.sho*.18+p.pas*.31+p.dri*.28+p.def*.03+p.phy*.07;if(["DM"].includes(slot))return p.pac*.06+p.sho*.04+p.pas*.27+p.dri*.11+p.def*.33+p.phy*.19;if(["CM","LM","RM"].includes(slot))return p.pac*.11+p.sho*.1+p.pas*.32+p.dri*.21+p.def*.15+p.phy*.11;if(["LB","RB","LWB","RWB"].includes(slot))return p.pac*.18+p.sho*.03+p.pas*.17+p.dri*.11+p.def*.34+p.phy*.17;if(g==="DF")return p.pac*.06+p.sho*.01+p.pas*.08+p.dri*.03+p.def*.5+p.phy*.32;return p.ovr}
function slotRating(p:Player,slot:string){return rawRoleRating(p,slot)*compatibility(p,slot)}
function playerById(id:string){return s.squad.find((p:Player)=>p.id===id)||s.market.find((p:Player)=>p.id===id)}
function slots(){return formations[s.formation] as [string,number,number][]}
function autoLineup(){const used=new Set<string>(),out:string[]=[];for(const [slot] of slots()){const candidates=[...s.squad].filter((p:Player)=>!used.has(p.id)).sort((a:Player,b:Player)=>slotRating(b,slot)-slotRating(a,slot));const pick=candidates[0];out.push(pick.id);used.add(pick.id)}s.lineup=out}
function lineStats(){let attack:number[]=[],mid:number[]=[],def:number[]=[],fit=0;slots().forEach(([slot],i)=>{const p=playerById(s.lineup[i]);if(!p)return;const r=slotRating(p,slot);fit+=compatibility(p,slot);const g=positionGroup(slot);if(g==="FW")attack.push(r);else if(g==="MF")mid.push(r);else def.push(r)});const avg=(a:number[])=>a.length?a.reduce((x,y)=>x+y,0)/a.length:50;const a=avg(attack),m=avg(mid),d=avg(def);return{attack:a*.8+m*.2,mid:m*.75+(a+d)*.125,def:d*.82+m*.18,ovr:(a+m+d)/3,fit:fit/11*100}}
function sortedTable(){return[...s.table].sort((a:any,b:any)=>b.pts-a.pts||(b.gf-b.ga)-(a.gf-a.ga)||b.gf-a.gf)}
function applyResult(a:any,b:any,ga:number,gb:number){a.p++;b.p++;a.gf+=ga;a.ga+=gb;b.gf+=gb;b.ga+=ga;if(ga>gb){a.w++;b.l++;a.pts+=3}else if(ga<gb){b.w++;a.l++;b.pts+=3}else{a.d++;b.d++;a.pts++;b.pts++}}
function poisson(lambda:number){let L=Math.exp(-lambda),p=1,k=0;do{k++;p*=Math.random()}while(p>L&&k<9);return k-1}
function statBar(label:string,v:number){return`<div class="player-stat"><span>${label}</span><progress max="100" value="${v}"></progress><b>${v}</b></div>`}
function playerProfile(p:Player){
 const owned=s.squad.some((x:Player)=>x.id===p.id);q("[data-player-owned]").textContent=owned?"所属選手":"移籍候補";
 q("[data-player-detail]").innerHTML=`<div class="profile-hero"><div><span class="profile-flag">${p.nation}</span><h4>${p.name}</h4><p>${p.pos.join(" / ")} ・ ${p.age}歳</p></div><strong class="profile-ovr">${p.ovr}<small>OVR</small></strong></div><div class="profile-stats">${statBar("PAC",p.pac)}${statBar("SHO",p.sho)}${statBar("PAS",p.pas)}${statBar("DRI",p.dri)}${statBar("DEF",p.def)}${statBar("PHY",p.phy)}</div>${owned?"":`<p class="profile-price">移籍金 <b>${yen(p.price)}</b></p>`}`;
}
function renderPitch(){
 q("[data-pitch-lineup]").innerHTML=slots().map(([slot,x,y],i)=>{const p=playerById(s.lineup[i]);const fit=Math.round(compatibility(p,slot)*100);return`<button class="pitch-lineup-player ${fit<90?"out-position":""}" type="button" style="left:${x}%;top:${y}%" data-profile="${p.id}" title="${p.name} / ${slot}適性 ${fit}%"><span>${slot}</span><b>${p.name.split(" ").slice(-1)[0]}</b><small>${Math.round(slotRating(p,slot))}</small></button>`}).join("");
}
function renderLineupEditor(){
 q("[data-lineup-editor]").innerHTML=slots().map(([slot],i)=>{const current=s.lineup[i];const opts=[...s.squad].sort((a:Player,b:Player)=>slotRating(b,slot)-slotRating(a,slot)).map((p:Player)=>`<option value="${p.id}" ${p.id===current?"selected":""}>${p.name}｜${p.pos.join("/")}｜${Math.round(slotRating(p,slot))}</option>`).join("");const cp=playerById(current),fit=Math.round(compatibility(cp,slot)*100);return`<div class="lineup-row"><b>${slot}</b><select data-lineup-slot="${i}">${opts}</select><span class="${fit<90?"bad-fit":"good-fit"}">${fit}%</span></div>`}).join("");
 root.querySelectorAll<HTMLSelectElement>("[data-lineup-slot]").forEach(el=>el.addEventListener("change",()=>{const i=Number(el.dataset.lineupSlot),old=s.lineup[i],next=el.value,other=s.lineup.indexOf(next);if(other>=0&&other!==i)s.lineup[other]=old;s.lineup[i]=next;s.selectedPlayer=next;save(s);render()}));
}
function marketGroup(p:Player){const gs=new Set(p.pos.map(positionGroup));if(gs.has("GK"))return"GK";if(gs.has("DF"))return"DF";if(gs.has("MF"))return"MF";return"FW"}
function renderMarket(){
 const filter=qs("[data-market-filter]").value,sort=qs("[data-market-sort]").value;let list=s.market.filter((p:Player)=>filter==="ALL"||marketGroup(p)===filter);list=[...list].sort((a,b)=>sort==="price"?a.price-b.price:sort==="age"?a.age-b.age:b.ovr-a.ovr);
 q("[data-transfer-market]").innerHTML=list.map((p:Player)=>{const bought=s.marketBought.includes(p.id),afford=s.budget>=p.price;return`<article class="market-player-card"><button class="market-profile-open" type="button" data-profile="${p.id}"><span>${p.nation}</span><div><strong>${p.name}</strong><small>${p.pos.join(" / ")} ・ ${p.age}歳</small></div><em>${p.ovr}<small>OVR</small></em></button><div class="market-mini-stats"><span>PAC <b>${p.pac}</b></span><span>SHO <b>${p.sho}</b></span><span>PAS <b>${p.pas}</b></span><span>DRI <b>${p.dri}</b></span><span>DEF <b>${p.def}</b></span><span>PHY <b>${p.phy}</b></span></div><button class="market-buy" type="button" data-buy-player="${p.id}" ${bought||!afford?"disabled":""}>${bought?"獲得済み":yen(p.price)+"で獲得"}</button></article>`}).join("");
 root.querySelectorAll<HTMLButtonElement>("[data-buy-player]").forEach(b=>b.addEventListener("click",()=>buyPlayer(b.dataset.buyPlayer!)));
 bindProfileButtons();
}
function renderSquad(){
 q("[data-squad-count]").textContent=s.squad.length+" players";q("[data-squad-table]").innerHTML=[...s.squad].sort((a:Player,b:Player)=>b.ovr-a.ovr).map((p:Player)=>`<tr><td><button type="button" class="player-name-button" data-profile="${p.id}">${p.nation} ${p.name}</button></td><td>${p.pos.join("/")}</td><td>${p.age}</td><td><b>${p.ovr}</b></td><td>${p.pac}</td><td>${p.sho}</td><td>${p.pas}</td><td>${p.dri}</td><td>${p.def}</td><td>${p.phy}</td><td>${s.lineup.includes(p.id)?"<span class='starting-badge'>XI</span>":""}</td></tr>`).join("");bindProfileButtons();
}
function bindProfileButtons(){root.querySelectorAll<HTMLButtonElement>("[data-profile]").forEach(b=>b.onclick=()=>{s.selectedPlayer=b.dataset.profile!;playerProfile(playerById(s.selectedPlayer));save(s)})}
function buyPlayer(id:string){const p=s.market.find((x:Player)=>x.id===id);if(!p||s.marketBought.includes(id)||s.budget<p.price)return;s.budget-=p.price;s.squad.push({...p});s.marketBought.push(id);s.morale=clamp(s.morale+2,0,100);s.selectedPlayer=id;s.log.push("移籍成立："+p.name+" "+yen(p.price));save(s);render()}
function render(){
 const row=s.table[0],rank=sortedTable().findIndex((x:any)=>x.id===0)+1,ls=lineStats(),best=readBest();root.dataset.seasonId=String(s.seasonId);q("[data-best]").textContent=best?best+" pt":"0 pt";q("[data-week]").textContent=Math.min(s.week,14)+" / 14";q("[data-home-away]").textContent=s.week<=14?(s.week<=7?"HOME":"AWAY"):"FINAL";q("[data-points]").textContent=row.pts+"";q("[data-rank]").textContent=s.week===1&&row.p===0?"順位 --":rank+"位";q("[data-budget]").textContent=yen(s.budget);q("[data-income]").textContent="前節収入 "+yen(s.lastIncome);q("[data-quality]").textContent=ls.ovr.toFixed(1);q("[data-chemistry]").textContent="適性 "+Math.round(ls.fit)+"%";q("[data-fans]").textContent=Math.round(s.fans).toLocaleString("ja-JP");q("[data-record]").textContent=`${row.w}勝 ${row.d}分 ${row.l}敗`;q("[data-attack]").textContent=ls.attack.toFixed(1);q("[data-midfield]").textContent=ls.mid.toFixed(1);q("[data-defense]").textContent=ls.def.toFixed(1);
 (root.querySelector<HTMLProgressElement>("[data-fitness]")!).value=s.fitness;(root.querySelector<HTMLProgressElement>("[data-morale]")!).value=s.morale;q("[data-fitness-text]").textContent=Math.round(s.fitness)+"";q("[data-morale-text]").textContent=Math.round(s.morale)+"";
 const oi=s.week<=14?schedule[s.week-1]:1,opp=teams[oi];q("[data-opponent-badge]").textContent="vs "+opp.name;q("[data-opponent-level]").textContent="相手 OVR "+opp.ovr;q("[data-scout]").textContent=opp.ovr>=72?"相手分析：個の力が高い強敵。守備の安定かカウンターが有効。":opp.ovr<=66?"相手分析：格下。主導権を握って押し込みたい。":"相手分析：互角。スタメン適性とコンディションが重要。";
 const tbl=sortedTable();q("[data-league-table]").innerHTML=tbl.map((r:any,i:number)=>`<tr class="${r.id===0?"user-team":""}"><td>${i+1}</td><td>${r.name}</td><td>${r.p}</td><td>${r.gf-r.ga>=0?"+":""}${r.gf-r.ga}</td><td><b>${r.pts}</b></td></tr>`).join("");q("[data-table-note]").textContent="第"+Math.min(14,s.week-1)+"節終了";let fc=0;Object.keys(facilityCosts).forEach(k=>{const b=qb(`[data-facility="${k}"]`);if(s.facilities[k]){fc++;b.disabled=true;b.textContent="完成"}else{b.disabled=s.budget<facilityCosts[k];b.textContent=yen(facilityCosts[k])}});q("[data-facility-count]").textContent=fc+" / 4";q("[data-injury]").textContent=s.injuryWeeks>0?"主力1名 負傷あと"+s.injuryWeeks+"節":"負傷者なし";q("[data-injury]").className="sim-pill "+(s.injuryWeeks>0?"bad":"good");q("[data-log]").innerHTML=s.log.slice(-6).reverse().map((x:string)=>"<li>"+x+"</li>").join("");q("[data-match-feed]").innerHTML=s.feed.length?s.feed.map((x:string)=>"<div>"+x+"</div>").join(""):"<div>キックオフすると試合の流れが表示されます。</div>";
 qs("[data-formation]").value=s.formation;renderPitch();renderLineupEditor();renderSquad();renderMarket();playerProfile(playerById(s.selectedPlayer)||s.squad[0]);
}
function start(load=false){s=load&&read()?read():fresh();if(!s.squad||!s.lineup||!s.market||!s.seasonId){s=fresh()}intro.hidden=true;play.hidden=false;root.dataset.state="running";save(s);render()}
qb("[data-start]").addEventListener("click",()=>start(false));const cont=qb("[data-continue]");cont.hidden=!read();cont.addEventListener("click",()=>start(true));qb("[data-restart]").addEventListener("click",()=>{clear();start(false)});
qs("[data-formation]").addEventListener("change",()=>{s.formation=qs("[data-formation]").value;autoLineup();save(s);render()});qb("[data-auto-lineup]").addEventListener("click",()=>{autoLineup();save(s);render()});qs("[data-market-filter]").addEventListener("change",renderMarket);qs("[data-market-sort]").addEventListener("change",renderMarket);
root.querySelectorAll<HTMLButtonElement>("[data-facility]").forEach(b=>b.addEventListener("click",()=>{const k=b.dataset.facility!;if(s.facilities[k]||s.budget<facilityCosts[k])return;s.budget-=facilityCosts[k];s.facilities[k]=true;s.log.push("施設完成："+k);save(s);render()}));
qb("[data-match]").addEventListener("click",()=>{if(s.week>14)return;const tactic=qs("[data-tactic]").value,training=qs("[data-training]").value,growth=s.facilities.training?1.4:1;if(training==="attack"){for(const p of s.squad){p.sho=clamp(p.sho+.12*growth,1,99);p.pas=clamp(p.pas+.08*growth,1,99)}s.fitness-=5}else if(training==="defense"){for(const p of s.squad){p.def=clamp(p.def+.13*growth,1,99);p.phy=clamp(p.phy+.07*growth,1,99)}s.fitness-=4}else if(training==="fitness"){for(const p of s.squad)p.phy=clamp(p.phy+.07*growth,1,99);s.fitness+=5;s.morale-=1}else if(training==="recovery"){s.fitness+=12;s.morale+=1}else{for(const p of s.squad){p.pas=clamp(p.pas+.04*growth,1,99);p.dri=clamp(p.dri+.04*growth,1,99)}s.fitness-=2}if(s.facilities.academy){for(const p of s.squad.filter((x:Player)=>x.age<=23)){p.ovr=clamp(p.ovr+.03,1,99);p.pac=clamp(p.pac+.03,1,99);p.pas=clamp(p.pas+.03,1,99)}}s.fitness=clamp(s.fitness,30,100);s.morale=clamp(s.morale,20,100);
 const oi=schedule[s.week-1],opp=s.table[oi],oppOvr=teams[oi].ovr,ls=lineStats();let att=ls.attack,mid=ls.mid,def=ls.def,energyCost=7;const oppStyle=["balanced","press","counter","possession","block"][oi%5],edges:any={counter:{press:.8,possession:.3},possession:{block:.5,balanced:.2},press:{possession:.5,balanced:.15},block:{counter:.4,press:-.15},balanced:{}};const edge=edges[tactic]?.[oppStyle]??0;if(tactic==="press"){att+=1;mid+=.8;energyCost=12}else if(tactic==="counter"){att+=.5;def+=.35;energyCost=6}else if(tactic==="possession"){mid+=1;energyCost=8}else if(tactic==="block"){def+=1.1;att-=.35;energyCost=5}att+=edge;def+=edge*.6;
 const condition=(s.fitness-70)*.025+(s.morale-60)*.018-(s.injuryWeeks>0?1.2:0),ourXg=clamp(1.2+(att*.55+mid*.22+condition-oppOvr*.75)/13,.2,3.5),theirXg=clamp(1.1+(oppOvr*.78-(def*.58+mid*.18+condition))/14,.2,3.2),our=poisson(ourXg),their=poisson(theirXg);applyResult(s.table[0],opp,our,their);const remaining=s.table.filter((_:any,i:number)=>i!==0&&i!==oi).sort(()=>Math.random()-.5);for(let i=0;i<remaining.length;i+=2){const a=remaining[i],b=remaining[i+1],ag=poisson(clamp(1.2+(a.ovr-b.ovr)/18,.35,2.8)),bg=poisson(clamp(1.2+(b.ovr-a.ovr)/18,.35,2.8));applyResult(a,b,ag,bg)}
 const won=our>their,draw=our===their,res=won?"W":draw?"D":"L";s.form.push(res);if(s.form.length>5)s.form.shift();s.morale=clamp(s.morale+(won?6:draw?1:-5),20,100);const home=s.week<=7,attendance=Math.round(s.fans*(home?(.75+Math.random()*.2):.25)),income=Math.round(attendance*(s.facilities.stadium?4200:3200)+(won?1.4e7:draw?7e6:3e6));s.lastIncome=income;s.budget+=income;s.fans=clamp(s.fans+(won?ri(700,1700):draw?ri(100,500):-ri(100,600)),7000,50000);s.fitness=clamp(s.fitness-energyCost+(s.facilities.recovery?4:0),25,100);if(s.injuryWeeks>0)s.injuryWeeks--;else if(Math.random()<(s.fitness<55?.16:.05))s.injuryWeeks=ri(1,3);
 const striker=playerById(s.lineup[slots().findIndex(([x])=>x==="ST")>=0?slots().findIndex(([x])=>x==="ST"):10]);s.feed=[`<b>12'</b> ${s.formation}で試合を開始。中盤の主導権を探る。`,our>0?`<b>${ri(20,45)}'</b> GOAL! ${striker?.name||"Harbor City"}を中心に攻撃が結実。`:`<b>34'</b> 相手守備を崩し切れず、決定機は少ない。`,their>0?`<b>${ri(48,72)}'</b> 相手の反撃。守備陣が対応を迫られる。`:`<b>63'</b> 守備ブロックが機能。相手に決定機を与えない。`,`<b>90'</b> FULL TIME　Harbor City ${our} - ${their} ${teams[oi].name}`];q("[data-scoreline]").textContent=our+" - "+their;s.log.push(`第${s.week}節 ${res} ${our}-${their} vs ${teams[oi].name} / +${yen(income)}`);q("[data-result]").textContent=`${our} - ${their}　${won?"WIN":draw?"DRAW":"LOSE"}｜XI OVR ${ls.ovr.toFixed(1)}・適性 ${Math.round(ls.fit)}%｜入場者 ${attendance.toLocaleString("ja-JP")}人`;s.week++;
 if(s.week>14){const pts=s.table[0].pts;saveBest(pts);root.dataset.state="complete";q("[data-game-over]").hidden=false;q("[data-final-points]").textContent=pts+" pt / "+(sortedTable().findIndex((x:any)=>x.id===0)+1)+"位";q("[data-final-comment]").textContent=pts>=30?"優勝争い級のシーズン。補強と起用が高水準で噛み合いました。":pts>=23?"上位フィニッシュ。選手配置と戦術を詰めればさらに上を狙えます。":"シーズン完走。移籍市場とポジション適性を見直して再挑戦できます。";q("[data-result]").textContent+="｜シーズン終了";clear()}else save(s);render()});
render();
</script>
