---
import ToolLayout from "../layout/ToolLayout.astro";
import type { ExtraToolMeta } from "../../config/extra-tools";
import "../../styles/tool.css";
interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
const store = meta.mode === "convenience-store-sim";
const football = meta.mode === "football-club-sim";
const invest = meta.mode === "investment-sim";
---

<ToolLayout title={meta.title} description={meta.description} name={meta.name} category={meta.category} faqs={meta.faqs}>
  {store && (
    <section class="sim-shell store-sim" data-sim-game data-mode="convenience-store-sim" data-state="ready">
      <div class="sim-head">
        <div><p class="sim-kicker">30 DAYS STORE MANAGEMENT</p><h2>コンビニ経営シミュレーション</h2><p>仕入れ・価格・設備投資を決めて、30日後の店舗価値を伸ばそう。</p></div>
        <div class="sim-badge"><span>BEST VALUE</span><strong data-best>---</strong></div>
      </div>
      <div class="sim-metrics">
        <div><span>DAY</span><strong data-day>1 / 30</strong></div>
        <div><span>CASH</span><strong data-cash>¥1,000,000</strong></div>
        <div><span>REPUTATION</span><strong data-rep>50</strong></div>
        <div><span>STORE VALUE</span><strong data-value>¥1,000,000</strong></div>
      </div>
      <div class="sim-start" data-intro>
        <div><p>最初は小さな駅前コンビニ。値上げしすぎると客足が落ち、在庫不足でも評判が下がります。</p>
          <div class="sim-start-actions"><button class="button button-primary" type="button" data-start>新しく始める</button><button class="button button-secondary" type="button" data-continue hidden>続きから</button></div>
        </div>
      </div>
      <div class="sim-play" data-play hidden>
        <div class="sim-grid">
          <section class="sim-card"><div class="panel-title"><h3>商品と価格</h3><span>仕入数 <select data-order-qty><option>10</option><option selected>25</option><option>50</option></select></span></div>
            <div class="product-table">
              <div class="product-row" data-product="bento"><div><strong>弁当</strong><small>仕入 ¥360 / 標準 ¥580</small></div><b data-stock="bento">0</b><select data-price="bento"><option value=".8">80%</option><option value="1" selected>100%</option><option value="1.2">120%</option><option value="1.4">140%</option></select><button type="button" data-order="bento">仕入</button></div>
              <div class="product-row" data-product="drink"><div><strong>飲料</strong><small>仕入 ¥95 / 標準 ¥160</small></div><b data-stock="drink">0</b><select data-price="drink"><option value=".8">80%</option><option value="1" selected>100%</option><option value="1.2">120%</option><option value="1.4">140%</option></select><button type="button" data-order="drink">仕入</button></div>
              <div class="product-row" data-product="snack"><div><strong>お菓子</strong><small>仕入 ¥120 / 標準 ¥220</small></div><b data-stock="snack">0</b><select data-price="snack"><option value=".8">80%</option><option value="1" selected>100%</option><option value="1.2">120%</option><option value="1.4">140%</option></select><button type="button" data-order="snack">仕入</button></div>
              <div class="product-row" data-product="umbrella"><div><strong>傘</strong><small>仕入 ¥420 / 標準 ¥780</small></div><b data-stock="umbrella">0</b><select data-price="umbrella"><option value=".8">80%</option><option value="1" selected>100%</option><option value="1.2">120%</option><option value="1.4">140%</option></select><button type="button" data-order="umbrella">仕入</button></div>
            </div>
          </section>
          <section class="sim-card"><h3>店舗運営</h3><p class="event-box" data-event>今日の街の様子を見て営業しよう。</p>
            <button class="button button-primary wide" type="button" data-open>営業開始 → 1日進める</button>
            <button class="button button-secondary wide" type="button" data-upgrade>冷蔵ショーケース導入 ¥80,000</button>
            <div class="turn-result" data-result>まだ営業していません。</div>
          </section>
        </div>
        <section class="sim-card log-card"><div class="panel-title"><h3>経営ログ</h3><span data-profit>累計損益 ¥0</span></div><ul data-log></ul></section>
        <div class="sim-bottom"><button class="button button-secondary" type="button" data-restart>最初からやり直す</button></div>
      </div>
    </section>
  )}

  {football && (
    <section class="sim-shell football-sim" data-sim-game data-mode="football-club-sim" data-state="ready">
      <div class="sim-head">
        <div><p class="sim-kicker">12 MATCH CLUB MANAGEMENT</p><h2>Harbor City FC</h2><p>補強・練習・戦術を決めて、12試合のリーグ戦を戦い抜こう。</p></div>
        <div class="sim-badge"><span>BEST POINTS</span><strong data-best>0</strong></div>
      </div>
      <div class="sim-metrics">
        <div><span>MATCH</span><strong data-week>1 / 12</strong></div><div><span>POINTS</span><strong data-points>0</strong></div>
        <div><span>BUDGET</span><strong data-budget>¥500,000,000</strong></div><div><span>TEAM</span><strong data-quality>68.0</strong></div>
      </div>
      <div class="sim-start" data-intro><div><p>架空クラブを率いる1シーズン。攻めるか、守るか、育てるか。資金を使い切る必要はありません。</p><div class="sim-start-actions"><button class="button button-primary" type="button" data-start>新シーズン開始</button><button class="button button-secondary" type="button" data-continue hidden>続きから</button></div></div></div>
      <div class="sim-play" data-play hidden>
        <div class="sim-grid">
          <section class="sim-card"><h3>試合準備</h3>
            <div class="field-row"><label>戦術<select data-tactic><option value="balanced">バランス</option><option value="attack">攻撃重視</option><option value="counter">カウンター</option><option value="defense">守備重視</option></select></label><label>トレーニング<select data-training><option value="balanced">総合練習</option><option value="attack">攻撃練習</option><option value="defense">守備練習</option><option value="recovery">リカバリー</option></select></label></div>
            <div class="club-bars"><div><span>FITNESS</span><progress data-fitness max="100" value="85"></progress><b data-fitness-text>85</b></div><div><span>MORALE</span><progress data-morale max="100" value="70"></progress><b data-morale-text>70</b></div><div><span>FANS</span><strong data-fans>18,000</strong></div></div>
            <p class="event-box" data-next-opponent>次戦の相手を確認中...</p><button class="button button-primary wide" type="button" data-match>試合をする</button><div class="turn-result" data-result>開幕前です。</div>
          </section>
          <section class="sim-card"><div class="panel-title"><h3>移籍市場</h3><span>買い切り</span></div>
            <div class="transfer-list">
              <button type="button" data-buy-player="0"><strong>R. Sato</strong><span>FW / +1.2</span><small>¥80,000,000</small></button>
              <button type="button" data-buy-player="1"><strong>L. Costa</strong><span>MF / +1.8</span><small>¥120,000,000</small></button>
              <button type="button" data-buy-player="2"><strong>M. Keller</strong><span>DF / +2.4</span><small>¥180,000,000</small></button>
            </div>
          </section>
        </div>
        <section class="sim-card"><div class="panel-title"><h3>リーグ成績</h3><span data-record>0勝 0分 0敗</span></div><div class="season-line"><span>得点 <b data-gf>0</b></span><span>失点 <b data-ga>0</b></span><span>得失点差 <b data-gd>0</b></span></div><ul data-log></ul></section>
        <div class="sim-bottom"><button class="button button-secondary" type="button" data-restart>新シーズンでやり直す</button></div>
      </div>
    </section>
  )}

  {invest && (
    <section class="sim-shell invest-sim" data-sim-game data-mode="investment-sim" data-state="ready">
      <div class="sim-head">
        <div><p class="sim-kicker">36 MONTH FICTIONAL MARKET</p><h2>Market Lab</h2><p>完全架空の4資産を売買して、36か月後の資産額を競う投資シミュレーション。</p></div>
        <div class="sim-badge"><span>BEST ASSETS</span><strong data-best>---</strong></div>
      </div>
      <div class="sim-notice">このゲームの銘柄・価格・ニュースはすべて架空です。実際の投資判断には使用できません。</div>
      <div class="sim-metrics"><div><span>MONTH</span><strong data-month>1 / 36</strong></div><div><span>CASH</span><strong data-cash>¥1,000,000</strong></div><div><span>ASSETS</span><strong data-assets>¥1,000,000</strong></div><div><span>RETURN</span><strong data-return>0.0%</strong></div></div>
      <div class="sim-start" data-intro><div><p>現金100万円から開始。毎月ニュースで値動きが変わります。集中投資も分散投資も自由です。</p><div class="sim-start-actions"><button class="button button-primary" type="button" data-start>新しく始める</button><button class="button button-secondary" type="button" data-continue hidden>続きから</button></div></div></div>
      <div class="sim-play" data-play hidden>
        <section class="sim-card"><div class="panel-title"><h3>架空マーケット</h3><label>売買単位 <select data-qty><option value="1">1口</option><option value="5" selected>5口</option><option value="10">10口</option></select></label></div>
          <div class="market-table">
            <div class="market-row" data-asset-row="nova"><div><strong>NOVA</strong><small>テクノロジー</small></div><b data-price="nova">¥1,200</b><span data-holding="nova">0口</span><div><button type="button" data-buy="nova">買う</button><button type="button" data-sell="nova">売る</button></div></div>
            <div class="market-row" data-asset-row="harbor"><div><strong>HARBOR</strong><small>生活・小売</small></div><b data-price="harbor">¥820</b><span data-holding="harbor">0口</span><div><button type="button" data-buy="harbor">買う</button><button type="button" data-sell="harbor">売る</button></div></div>
            <div class="market-row" data-asset-row="green"><div><strong>GREEN</strong><small>エネルギー</small></div><b data-price="green">¥1,480</b><span data-holding="green">0口</span><div><button type="button" data-buy="green">買う</button><button type="button" data-sell="green">売る</button></div></div>
            <div class="market-row" data-asset-row="bond"><div><strong>STABLE</strong><small>安定資産</small></div><b data-price="bond">¥1,000</b><span data-holding="bond">0口</span><div><button type="button" data-buy="bond">買う</button><button type="button" data-sell="bond">売る</button></div></div>
          </div>
        </section>
        <div class="sim-grid">
          <section class="sim-card"><h3>今月のニュース</h3><p class="event-box" data-news>市場は静かなスタート。</p><button class="button button-primary wide" type="button" data-next-month>1か月進める</button><div class="turn-result" data-result>売買してから月を進めよう。</div></section>
          <section class="sim-card"><h3>ポートフォリオ</h3><div class="portfolio-bars" data-allocation></div><ul data-log></ul></section>
        </div>
        <div class="sim-bottom"><button class="button button-secondary" type="button" data-restart>最初からやり直す</button></div>
      </div>
    </section>
  )}
</ToolLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-sim-game]")!;
  const mode = root.dataset.mode!;
  const intro = root.querySelector<HTMLElement>("[data-intro]")!;
  const play = root.querySelector<HTMLElement>("[data-play]")!;
  const startBtn = root.querySelector<HTMLButtonElement>("[data-start]")!;
  const continueBtn = root.querySelector<HTMLButtonElement>("[data-continue]")!;
  const restartBtn = root.querySelector<HTMLButtonElement>("[data-restart]")!;
  const KEY = "utility-tools:sim:" + mode;
  const BEST = KEY + ":best";
  const yen = (n:number) => "¥" + Math.round(n).toLocaleString("ja-JP");
  const clamp = (n:number,a:number,b:number) => Math.max(a,Math.min(b,n));
  const ri = (a:number,b:number) => Math.floor(a + Math.random()*(b-a+1));
  const read = () => { try { return JSON.parse(localStorage.getItem(KEY) || "null"); } catch { return null; } };
  const save = (state:any) => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} };
  const clear = () => { try { localStorage.removeItem(KEY); } catch {} };
  const readBest = () => { try { return Number(localStorage.getItem(BEST)||"0")||0; } catch { return 0; } };
  const saveBest = (n:number) => { if(n>readBest()) try { localStorage.setItem(BEST,String(Math.round(n))); } catch {} };
  const showPlay = () => { intro.hidden=true;play.hidden=false;root.dataset.state="running"; };
  continueBtn.hidden = !read();

  if(mode==="convenience-store-sim"){
    const products:any={bento:{cost:360,price:580,base:24},drink:{cost:95,price:160,base:34},snack:{cost:120,price:220,base:22},umbrella:{cost:420,price:780,base:5}};
    const fresh=()=>({day:1,cash:1000000,rep:50,inventory:{bento:25,drink:35,snack:25,umbrella:8},prices:{bento:1,drink:1,snack:1,umbrella:1},upgrade:false,initial:1000000,eventIndex:ri(0,4),log:[]});
    let s:any=fresh();
    const bestEl=root.querySelector<HTMLElement>("[data-best]")!,dayEl=root.querySelector<HTMLElement>("[data-day]")!,cashEl=root.querySelector<HTMLElement>("[data-cash]")!,repEl=root.querySelector<HTMLElement>("[data-rep]")!,valueEl=root.querySelector<HTMLElement>("[data-value]")!,profitEl=root.querySelector<HTMLElement>("[data-profit]")!,logEl=root.querySelector<HTMLElement>("[data-log]")!,eventEl=root.querySelector<HTMLElement>("[data-event]")!,resultEl=root.querySelector<HTMLElement>("[data-result]")!,upgradeBtn=root.querySelector<HTMLButtonElement>("[data-upgrade]")!;
    const value=()=>s.cash+Object.keys(products).reduce((a,k)=>a+s.inventory[k]*products[k].cost,0)+s.rep*1800+(s.upgrade?50000:0);
    function render(){bestEl.textContent=readBest()?yen(readBest()):"---";dayEl.textContent=Math.min(s.day,30)+" / 30";cashEl.textContent=yen(s.cash);repEl.textContent=String(Math.round(s.rep));valueEl.textContent=yen(value());profitEl.textContent="店舗価値差 "+yen(value()-s.initial);Object.keys(products).forEach(k=>{root.querySelector<HTMLElement>(`[data-stock="${k}"]`)!.textContent=s.inventory[k]+"個";(root.querySelector<HTMLSelectElement>(`[data-price="${k}"]`)!).value=String(s.prices[k]);});upgradeBtn.disabled=s.upgrade;upgradeBtn.textContent=s.upgrade?"冷蔵ショーケース導入済み":"冷蔵ショーケース導入 ¥80,000";eventEl.textContent=events[s.eventIndex]?.t||events[0].t;logEl.innerHTML=s.log.slice(-6).reverse().map((x:string)=>"<li>"+x+"</li>").join("");}
    function start(load=false){s=load&&read()?read():fresh();showPlay();render();save(s);}
    startBtn.addEventListener("click",()=>start(false));continueBtn.addEventListener("click",()=>start(true));restartBtn.addEventListener("click",()=>{clear();start(false)});
    root.querySelectorAll<HTMLSelectElement>("[data-price]").forEach(el=>el.addEventListener("change",()=>{s.prices[el.dataset.price!]=Number(el.value);save(s);render()}));
    root.querySelectorAll<HTMLButtonElement>("[data-order]").forEach(btn=>btn.addEventListener("click",()=>{const k=btn.dataset.order!,q=Number(root.querySelector<HTMLSelectElement>("[data-order-qty]")!.value),cost=products[k].cost*q;if(s.cash<cost){resultEl.textContent="資金不足で仕入れできません。";return}s.cash-=cost;s.inventory[k]+=q;s.log.push("DAY "+s.day+"："+k+"を"+q+"個仕入れ");save(s);render()}));
    upgradeBtn.addEventListener("click",()=>{if(s.upgrade)return;if(s.cash<80000){resultEl.textContent="設備資金が足りません。";return}s.cash-=80000;s.upgrade=true;s.rep=clamp(s.rep+4,0,100);s.log.push("冷蔵ショーケースを導入。");save(s);render()});
    const events:any[]=[{t:"☀ 晴天。飲料がよく売れそう。",m:{drink:1.45}},{t:"☔ 雨予報。傘の需要が急増。",m:{umbrella:3.2,drink:.8}},{t:"🏫 近所でイベント。弁当とお菓子が人気。",m:{bento:1.4,snack:1.5}},{t:"📱 SNSで話題。全体的に客足増。",m:{all:1.3}},{t:"😴 静かな平日。大きな変化なし。",m:{all:.9}}];
    root.querySelector<HTMLButtonElement>("[data-open]")!.addEventListener("click",()=>{if(s.day>30)return;const ev=events[s.eventIndex]||events[0];let revenue=0,cogs=0,stockouts=0;for(const k of Object.keys(products)){const p=products[k],pm=s.prices[k],elastic=clamp(1.35-(pm-1)*1.35,.55,1.45),ef=(ev.m[k]??ev.m.all??1),uf=s.upgrade?1.08:1,rf=.78+s.rep/220;const demand=Math.max(1,Math.round(p.base*elastic*ef*uf*rf*(.82+Math.random()*.36)));const qty=Math.min(s.inventory[k],demand);s.inventory[k]-=qty;revenue+=qty*p.price*pm;cogs+=qty*p.cost;if(qty<demand)stockouts++;}const waste=Math.floor(s.inventory.bento*.12);s.inventory.bento-=waste;s.cash+=revenue;s.rep=clamp(s.rep+(stockouts? -stockouts*.8:1.1)-(Object.values(s.prices).filter((x:any)=>x>=1.4).length*.4),0,100);const gross=revenue-cogs;s.log.push("DAY "+s.day+" 売上 "+yen(revenue)+" / 粗利 "+yen(gross));resultEl.textContent=`${ev.t}　売上 ${yen(revenue)}・粗利 ${yen(gross)}・弁当廃棄 ${waste}個`;s.day++;s.eventIndex=ri(0,events.length-1);if(s.day>30){const final=value();saveBest(final);root.dataset.state="complete";resultEl.textContent=`30日終了！ 最終店舗価値 ${yen(final)}（開始時比 ${yen(final-s.initial)}）`;clear();}else save(s);render();});
    render();
  }

  if(mode==="football-club-sim"){
    const fresh=()=>({week:1,budget:500000000,quality:68,fitness:85,morale:70,fans:18000,points:0,w:0,d:0,l:0,gf:0,ga:0,bought:[false,false,false],log:[]});
    let s:any=fresh();const players=[{cost:80000000,boost:1.2},{cost:120000000,boost:1.8},{cost:180000000,boost:2.4}],opponents=["Northbridge United","Blue Coast FC","Redwood Athletic","Metro Stars","Riverside 04","East Port FC","Crown Town","Lake City","Union Vale","Silver Wings","Old Castle","West Bay"];
    const bestEl=root.querySelector<HTMLElement>("[data-best]")!,weekEl=root.querySelector<HTMLElement>("[data-week]")!,pointsEl=root.querySelector<HTMLElement>("[data-points]")!,budgetEl=root.querySelector<HTMLElement>("[data-budget]")!,qualityEl=root.querySelector<HTMLElement>("[data-quality]")!,fitness=root.querySelector<HTMLProgressElement>("[data-fitness]")!,morale=root.querySelector<HTMLProgressElement>("[data-morale]")!,fitnessText=root.querySelector<HTMLElement>("[data-fitness-text]")!,moraleText=root.querySelector<HTMLElement>("[data-morale-text]")!,fansEl=root.querySelector<HTMLElement>("[data-fans]")!,oppEl=root.querySelector<HTMLElement>("[data-next-opponent]")!,record=root.querySelector<HTMLElement>("[data-record]")!,gf=root.querySelector<HTMLElement>("[data-gf]")!,ga=root.querySelector<HTMLElement>("[data-ga]")!,gd=root.querySelector<HTMLElement>("[data-gd]")!,logEl=root.querySelector<HTMLElement>("[data-log]")!,result=root.querySelector<HTMLElement>("[data-result]")!;
    function render(){bestEl.textContent=String(readBest());weekEl.textContent=Math.min(s.week,12)+" / 12";pointsEl.textContent=String(s.points);budgetEl.textContent=yen(s.budget);qualityEl.textContent=s.quality.toFixed(1);fitness.value=s.fitness;morale.value=s.morale;fitnessText.textContent=Math.round(s.fitness)+"";moraleText.textContent=Math.round(s.morale)+"";fansEl.textContent=Math.round(s.fans).toLocaleString("ja-JP");oppEl.textContent=s.week<=12?`次戦：${opponents[s.week-1]}（第${s.week}節）`:"シーズン終了";record.textContent=`${s.w}勝 ${s.d}分 ${s.l}敗`;gf.textContent=String(s.gf);ga.textContent=String(s.ga);gd.textContent=String(s.gf-s.ga);logEl.innerHTML=s.log.slice(-7).reverse().map((x:string)=>"<li>"+x+"</li>").join("");root.querySelectorAll<HTMLButtonElement>("[data-buy-player]").forEach((b,i)=>{b.disabled=s.bought[i]||s.budget<players[i].cost;b.classList.toggle("bought",s.bought[i]);});}
    function start(load=false){s=load&&read()?read():fresh();showPlay();render();save(s)}startBtn.addEventListener("click",()=>start(false));continueBtn.addEventListener("click",()=>start(true));restartBtn.addEventListener("click",()=>{clear();start(false)});
    root.querySelectorAll<HTMLButtonElement>("[data-buy-player]").forEach((b,i)=>b.addEventListener("click",()=>{const p=players[i];if(s.bought[i]||s.budget<p.cost)return;s.budget-=p.cost;s.quality+=p.boost;s.morale=clamp(s.morale+3,0,100);s.bought[i]=true;s.log.push("補強成功：チーム力 +"+p.boost.toFixed(1));save(s);render()}));
    const poisson=(lambda:number)=>{let L=Math.exp(-lambda),p=1,k=0;do{k++;p*=Math.random()}while(p>L&&k<9);return k-1};
    root.querySelector<HTMLButtonElement>("[data-match]")!.addEventListener("click",()=>{if(s.week>12)return;const tactic=root.querySelector<HTMLSelectElement>("[data-tactic]")!.value,train=root.querySelector<HTMLSelectElement>("[data-training]")!.value;if(train==="attack"){s.quality+=.25;s.fitness-=5}else if(train==="defense"){s.quality+=.2;s.fitness-=4}else if(train==="recovery"){s.fitness+=10;s.morale+=1}else{s.quality+=.1;s.fitness-=2;s.morale+=1}s.fitness=clamp(s.fitness,35,100);s.morale=clamp(s.morale,25,100);const opp=64+Math.random()*12+s.week*.15,power=s.quality+s.morale*.055+s.fitness*.035;let att=0,def=0;if(tactic==="attack"){att=.35;def=.25}else if(tactic==="defense"){att=-.2;def=-.32}else if(tactic==="counter"){att=.12;def=-.12}const our=poisson(clamp(1.15+(power-opp)/15+att,.25,3.2)),their=poisson(clamp(1.05+(opp-power)/17+def,.2,2.8));s.gf+=our;s.ga+=their;let pts=0;if(our>their){s.w++;pts=3;s.morale+=5;s.fans+=ri(500,1500)}else if(our===their){s.d++;pts=1;s.morale+=1;s.fans+=ri(0,400)}else{s.l++;s.morale-=5;s.fans-=ri(100,700)}s.points+=pts;s.budget+=Math.round(s.fans*900);s.fitness=clamp(s.fitness-6,30,100);s.morale=clamp(s.morale,20,100);result.textContent=`${opponents[s.week-1]}戦：${our} - ${their}　${pts===3?"WIN":pts===1?"DRAW":"LOSE"}`;s.log.push(`第${s.week}節 ${our}-${their} vs ${opponents[s.week-1]}`);s.week++;if(s.week>12){saveBest(s.points);root.dataset.state="complete";const grade=s.points>=26?"優勝争い級":s.points>=20?"上位フィニッシュ":s.points>=14?"中位フィニッシュ":"残留争い";result.textContent+=`｜シーズン終了：${s.points}pt・${grade}`;clear()}else save(s);render()});render();
  }

  if(mode==="investment-sim"){
    const defs:any={nova:{name:"NOVA",base:1200,vol:.12},harbor:{name:"HARBOR",base:820,vol:.07},green:{name:"GREEN",base:1480,vol:.1},bond:{name:"STABLE",base:1000,vol:.025}};
    const fresh=()=>({month:1,cash:1000000,prices:{nova:1200,harbor:820,green:1480,bond:1000},holdings:{nova:0,harbor:0,green:0,bond:0},log:[],news:"市場は静かなスタート。"});
    let s:any=fresh();const bestEl=root.querySelector<HTMLElement>("[data-best]")!,monthEl=root.querySelector<HTMLElement>("[data-month]")!,cashEl=root.querySelector<HTMLElement>("[data-cash]")!,assetsEl=root.querySelector<HTMLElement>("[data-assets]")!,returnEl=root.querySelector<HTMLElement>("[data-return]")!,newsEl=root.querySelector<HTMLElement>("[data-news]")!,result=root.querySelector<HTMLElement>("[data-result]")!,allocation=root.querySelector<HTMLElement>("[data-allocation]")!,logEl=root.querySelector<HTMLElement>("[data-log]")!;
    const total=()=>s.cash+Object.keys(defs).reduce((a,k)=>a+s.holdings[k]*s.prices[k],0);
    function render(){const t=total();bestEl.textContent=readBest()?yen(readBest()):"---";monthEl.textContent=Math.min(s.month,36)+" / 36";cashEl.textContent=yen(s.cash);assetsEl.textContent=yen(t);const rr=(t/1000000-1)*100;returnEl.textContent=(rr>=0?"+":"")+rr.toFixed(1)+"%";returnEl.classList.toggle("negative",rr<0);newsEl.textContent=s.news;Object.keys(defs).forEach(k=>{root.querySelector<HTMLElement>(`[data-price="${k}"]`)!.textContent=yen(s.prices[k]);root.querySelector<HTMLElement>(`[data-holding="${k}"]`)!.textContent=s.holdings[k]+"口";});const parts=Object.keys(defs).map(k=>({k,v:s.holdings[k]*s.prices[k]})).filter(x=>x.v>0);allocation.innerHTML=parts.length?parts.map(x=>`<div><span>${defs[x.k].name}</span><progress max="${t}" value="${x.v}"></progress><b>${Math.round(x.v/t*100)}%</b></div>`).join(""):"<p>保有資産なし（現金100%）</p>";logEl.innerHTML=s.log.slice(-6).reverse().map((x:string)=>"<li>"+x+"</li>").join("");}
    function start(load=false){s=load&&read()?read():fresh();showPlay();render();save(s)}startBtn.addEventListener("click",()=>start(false));continueBtn.addEventListener("click",()=>start(true));restartBtn.addEventListener("click",()=>{clear();start(false)});
    root.querySelectorAll<HTMLButtonElement>("[data-buy]").forEach(b=>b.addEventListener("click",()=>{const k=b.dataset.buy!,q=Number(root.querySelector<HTMLSelectElement>("[data-qty]")!.value),cost=s.prices[k]*q;if(cost>s.cash){result.textContent="現金が足りません。";return}s.cash-=cost;s.holdings[k]+=q;result.textContent=`${defs[k].name}を${q}口購入 ${yen(cost)}`;save(s);render()}));
    root.querySelectorAll<HTMLButtonElement>("[data-sell]").forEach(b=>b.addEventListener("click",()=>{const k=b.dataset.sell!,q=Number(root.querySelector<HTMLSelectElement>("[data-qty]")!.value);if(q>s.holdings[k]){result.textContent="保有口数が足りません。";return}const val=s.prices[k]*q;s.cash+=val;s.holdings[k]-=q;result.textContent=`${defs[k].name}を${q}口売却 ${yen(val)}`;save(s);render()}));
    const events:any[]=[{t:"AI需要が拡大。NOVAに追い風。",x:{nova:.12}},{t:"消費マインド改善。HARBORが堅調。",x:{harbor:.08}},{t:"再エネ投資拡大。GREENに資金流入。",x:{green:.11}},{t:"景気不安。安定資産へ資金逃避。",x:{bond:.035,nova:-.06,green:-.04}},{t:"市場全体に利益確定売り。",x:{all:-.045}},{t:"企業業績が予想を上回る。リスク資産上昇。",x:{nova:.05,harbor:.04,green:.05}}];
    root.querySelector<HTMLButtonElement>("[data-next-month]")!.addEventListener("click",()=>{if(s.month>=36){const t=total();saveBest(t);root.dataset.state="complete";result.textContent=`36か月終了！ 最終資産 ${yen(t)}（${((t/1000000-1)*100).toFixed(1)}%）`;clear();render();return}const ev=events[ri(0,events.length-1)];for(const k of Object.keys(defs)){const drift=k==="bond"?.003:.006,shock=(Math.random()-.5)*2*defs[k].vol+(ev.x[k]??ev.x.all??0);s.prices[k]=Math.max(100,Math.round(s.prices[k]*(1+drift+shock)))}s.month++;s.news=ev.t;s.log.push(`M${s.month} ${ev.t} 資産 ${yen(total())}`);result.textContent="価格が更新されました。次の売買を考えよう。";save(s);render()});render();
  }
</script>

<style>
  .sim-shell{display:grid;gap:14px;padding:20px;border:1px solid #dbe5f0;border-radius:22px;background:linear-gradient(180deg,#07111f,#0b1220);box-shadow:0 18px 48px rgba(15,23,42,.17);color:#f8fafc}
  .sim-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.sim-head h2{margin:0;color:#fff;font-size:clamp(27px,4.5vw,42px);line-height:1.05}.sim-head p:not(.sim-kicker){max-width:680px;margin:8px 0 0;color:#a8bdd2;line-height:1.65}.sim-kicker{margin:0 0 5px;color:#67e8f9;font-size:10px;font-weight:900;letter-spacing:.14em}.sim-badge{flex:0 0 128px;padding:11px;border:1px solid rgba(103,232,249,.24);border-radius:14px;background:rgba(15,23,42,.65);text-align:center}.sim-badge span{display:block;color:#7dd3fc;font-size:8px;font-weight:900}.sim-badge strong{font-size:18px}
  .sim-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.sim-metrics>div{padding:9px 10px;border:1px solid rgba(148,163,184,.14);border-radius:11px;background:rgba(15,23,42,.62)}.sim-metrics span{display:block;color:#7f95ad;font-size:8px;font-weight:900;letter-spacing:.1em}.sim-metrics strong{font-size:18px;font-variant-numeric:tabular-nums}.sim-metrics strong.negative{color:#fda4af}
  .sim-start{display:grid;place-items:center;min-height:260px;padding:28px;border:1px solid rgba(103,232,249,.18);border-radius:18px;background:radial-gradient(circle at 50% 0,rgba(14,165,233,.13),transparent 60%),rgba(2,8,23,.6);text-align:center}.sim-start>div{max-width:620px}.sim-start p{color:#c3d2e3;line-height:1.8}.sim-start-actions{display:flex;justify-content:center;gap:9px;flex-wrap:wrap}
  .sim-play{display:grid;gap:12px}.sim-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.85fr);gap:12px}.sim-card{padding:15px;border:1px solid rgba(148,163,184,.14);border-radius:15px;background:rgba(15,23,42,.58)}.sim-card h3{margin:0 0 11px;color:#fff;font-size:16px}.panel-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.panel-title h3{margin:0}.panel-title span,.panel-title label{color:#9db1c7;font-size:11px}.sim-card select{min-height:34px;border:1px solid #334155;border-radius:8px;background:#0f172a;color:#fff;padding:0 8px}.wide{width:100%;margin-top:9px}.event-box,.turn-result{margin:10px 0;padding:11px 12px;border-radius:11px;background:rgba(2,8,23,.7);color:#c8d8e8;font-size:12px;line-height:1.6}.turn-result{border-left:3px solid #22d3ee}.sim-bottom{display:flex;justify-content:center}
  .product-table,.market-table,.transfer-list{display:grid;gap:7px}.product-row,.market-row{display:grid;grid-template-columns:minmax(110px,1fr) 72px 78px 62px;align-items:center;gap:7px;padding:8px;border:1px solid rgba(148,163,184,.12);border-radius:10px;background:rgba(2,8,23,.48)}.product-row strong,.market-row strong{display:block}.product-row small,.market-row small{display:block;color:#7890a8;font-size:9px}.product-row b,.market-row b{font-size:12px}.product-row button,.market-row button,.transfer-list button{min-height:34px;border:1px solid #334155;border-radius:8px;background:#172033;color:#fff;font-weight:800;cursor:pointer}.market-row{grid-template-columns:minmax(90px,1fr) 90px 58px 128px}.market-row>div:last-child{display:flex;gap:4px}.market-row>div:last-child button{flex:1}.transfer-list button{display:grid;grid-template-columns:1fr auto;gap:3px;padding:10px;text-align:left}.transfer-list button span{color:#7dd3fc;font-size:10px}.transfer-list button small{grid-column:1/-1;color:#9eb3c8}.transfer-list button.bought{opacity:.5}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.field-row label{display:grid;gap:5px;color:#9db1c7;font-size:11px}.club-bars,.portfolio-bars{display:grid;gap:8px;margin-top:12px}.club-bars>div,.portfolio-bars>div{display:grid;grid-template-columns:70px 1fr 48px;gap:8px;align-items:center}.club-bars span,.portfolio-bars span{color:#91a8bf;font-size:9px;font-weight:900}.club-bars progress,.portfolio-bars progress{width:100%}.season-line{display:flex;gap:16px;flex-wrap:wrap;color:#a8bdd2;font-size:12px}.sim-card ul{margin:10px 0 0;padding-left:18px;color:#9fb4c9;font-size:11px;line-height:1.65}.sim-notice{padding:9px 11px;border:1px solid rgba(250,204,21,.22);border-radius:10px;background:rgba(120,53,15,.18);color:#fde68a;font-size:11px}
  @media(max-width:720px){.sim-shell{padding:12px;border-radius:16px}.sim-head{align-items:center}.sim-head p:not(.sim-kicker){font-size:12px}.sim-badge{flex-basis:98px}.sim-metrics{gap:4px}.sim-metrics>div{padding:7px 5px}.sim-metrics strong{font-size:13px}.sim-metrics span{font-size:7px}.sim-grid{grid-template-columns:1fr}.product-row{grid-template-columns:minmax(95px,1fr) 62px 70px 58px}.market-row{grid-template-columns:1fr 82px 52px}.market-row>div:last-child{grid-column:1/-1}.sim-start{min-height:220px;padding:18px}.field-row{grid-template-columns:1fr 1fr}.sim-badge strong{font-size:14px}}
  @media(max-width:430px){.sim-badge{display:none}.sim-head h2{font-size:27px}.product-row{grid-template-columns:1fr 55px 66px}.product-row button{grid-column:1/-1}.field-row{grid-template-columns:1fr}.sim-metrics strong{font-size:12px}}
</style>
