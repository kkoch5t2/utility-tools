---
import type { ExtraToolMeta } from "../../config/extra-tools";
import StoreSimulation from "./StoreSimulation.astro";
import FootballClubSimulation from "./FootballClubSimulation.astro";
import InvestmentSimulation from "./InvestmentSimulation.astro";
import "../../styles/simulation-game.css";
interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
---

{meta.mode === "convenience-store-sim" && <StoreSimulation meta={meta} />}
{meta.mode === "football-club-sim" && <FootballClubSimulation meta={meta} />}
{meta.mode === "investment-sim" && <InvestmentSimulation meta={meta} />}
