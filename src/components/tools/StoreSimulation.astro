---
import ToolLayout from "../layout/ToolLayout.astro";
import type { ExtraToolMeta } from "../../config/extra-tools";
interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
---

<ToolLayout title={meta.title} description={meta.description} name={meta.name} category={meta.category} faqs={meta.faqs}>
<section class="sim-shell store-sim store-deep" data-sim-game data-mode="convenience-store-sim" data-state="ready">
  <header class="sim-top"><div><p class="sim-kicker">MULTI MONTH / STORE MANAGEMENT</p><h2>LOCAL 24</h2><p class="sim-sub">商品構成、棚割り、価格、客層、スタッフ、シフト、販促、競合、借入、店舗拡張まで管理するコンビニ経営。30日で終わらず、次月へ引き継いで成長できます。</p></div><div class="sim-best"><span>BEST STORE VALUE</span><strong data-best>---</strong></div></header>
  <div class="sim-kpis">
    <div class="sim-kpi"><span>MONTH / DAY</span><strong data-month>1か月目</strong><small data-day>1 / 30</small></div>
    <div class="sim-kpi"><span>CASH</span><strong data-cash>¥1,000,000</strong><small data-daily-profit>本日 ±¥0</small></div>
    <div class="sim-kpi"><span>REPUTATION</span><strong data-rep>50</strong><small data-rating>口コミ ★3.0</small></div>
    <div class="sim-kpi"><span>CUSTOMERS</span><strong data-customers>0</strong><small data-lost>機会損失 0人</small></div>
    <div class="sim-kpi"><span>STORE VALUE</span><strong data-value>¥1,000,000</strong><small data-profit>開始時比 ±¥0</small></div>
  </div>

  <div class="sim-intro" data-intro>
    <div><h3>小さな1号店から、街のチェーンへ</h3><p>朝・昼・夕・夜で客層と売れ筋が変わります。商品を棚に置き、スタッフをシフトに割り当て、競合店や季節イベントに対応。月末にはPLを確認し、次月へ進むか2号店へ投資できます。</p><div class="sim-actions"><button class="button button-primary" type="button" data-start>新規経営を始める</button><button class="button button-secondary" type="button" data-continue hidden>保存データから続ける</button></div></div>
    <ul><li>10商品 × 客層 × 4時間帯の需要</li><li>6枠の棚割りと入口・中央・レジ前の配置効果</li><li>個性の違うスタッフ、採用、シフト、疲労、接客力</li><li>競合店・口コミ・季節・ランダムイベント</li><li>月次PL、借入返済、設備投資、2号店・3号店</li></ul>
  </div>

  <div class="sim-play" data-play hidden>
    <div class="store-scene" aria-label="店舗の簡易ビジュアル"><div class="store-sign">LOCAL 24</div><div class="store-shelf s1"></div><div class="store-shelf s2"></div><div class="store-shelf s3"></div><div class="store-people" data-store-people>🧍 🧍</div><div class="store-status-strip"><span data-weather>☀ 晴れ</span><span data-scene-note>1号店 / スタッフ3名</span></div></div>

    <div class="sim-grid">
      <section class="sim-card">
        <div class="sim-card-head"><h3>今日の街</h3><span data-weekday>MON</span></div>
        <div class="sim-event" data-event>今日の商圏情報を確認中…</div>
        <div class="store-segments" data-segments></div>
        <div class="weekly-goal"><span data-goal>DAY 7までに評判55</span><strong data-goal-status>進行中</strong></div>
        <div class="store-competition"><span>COMPETITOR</span><progress data-competitor max="100" value="45"></progress><b data-competitor-text>45</b></div>
        <label class="store-promo-label">本日の販促<select data-promo><option value="none">なし ¥0</option><option value="flyer">チラシ ¥12,000</option><option value="sns">SNS広告 ¥25,000</option><option value="coupon">10%クーポン ¥18,000</option><option value="student">学生キャンペーン ¥20,000</option></select></label>
        <button class="sim-primary" type="button" data-open>営業開始 → 1日進める</button>
        <div class="sim-result" data-result>商品・棚・シフトを整えて営業しよう。</div>
      </section>
      <section class="sim-card"><div class="sim-card-head"><h3>時間帯別予測</h3><span data-day-type>平日</span></div><div class="time-demand" data-time-demand></div><div class="sim-card-head" style="margin-top:12px"><h3>昨日の来店構成</h3><span data-top-segment>---</span></div><div class="segment-bars" data-segment-bars></div></section>
    </div>

    <nav class="store-tabs" data-store-tabs aria-label="店舗管理メニュー">
      <button type="button" class="active" data-store-tab="products">商品・棚</button><button type="button" data-store-tab="staff">スタッフ</button><button type="button" data-store-tab="store">店舗・設備</button><button type="button" data-store-tab="finance">財務・実績</button>
    </nav>

    <section class="sim-card store-panel" data-store-panel="products">
      <div class="sim-card-head"><h3>商品・在庫・価格</h3><label>一括仕入数 <select data-order-qty><option value="10">10個</option><option value="25" selected>25個</option><option value="50">50個</option><option value="100">100個</option></select></label></div>
      <div class="product-grid deep-products" data-product-grid></div>
      <div class="sim-card-head shelf-heading"><h3>棚割り</h3><span>配置した商品は需要UP。同一商品を複数配置すると効果は少し逓減。</span></div>
      <div class="shelf-layout" data-shelf-layout></div>
    </section>

    <section class="sim-card store-panel" data-store-panel="staff" hidden>
      <div class="sim-card-head"><h3>スタッフ・シフト</h3><span data-payroll>人件費/日 ¥0</span></div>
      <div class="staff-roster" data-staff-roster></div>
      <div class="sim-card-head" style="margin-top:14px"><h3>採用候補</h3><button class="sim-secondary compact" type="button" data-refresh-candidates>候補更新 ¥5,000</button></div>
      <div class="staff-candidates" data-staff-candidates></div>
    </section>

    <section class="store-panel" data-store-panel="store" hidden>
      <div class="sim-grid equal">
        <section class="sim-card"><div class="sim-card-head"><h3>店舗設備</h3><span data-upgrade-count>0 / 6</span></div><div class="upgrade-grid store-upgrades">
          <div class="upgrade-card"><strong>大型冷蔵ケース</strong><small>弁当・飲料・アイス需要 +10%</small><button type="button" data-upgrade="fridge">¥90,000</button></div>
          <div class="upgrade-card"><strong>コーヒーマシン</strong><small>コーヒー解禁、高粗利</small><button type="button" data-upgrade="coffee">¥130,000</button></div>
          <div class="upgrade-card"><strong>ホットスナック什器</strong><small>ホットスナック解禁</small><button type="button" data-upgrade="hot">¥150,000</button></div>
          <div class="upgrade-card"><strong>セルフレジ</strong><small>処理能力 +35%</small><button type="button" data-upgrade="self">¥220,000</button></div>
          <div class="upgrade-card"><strong>店内改装</strong><small>清潔度上限・評判 +5</small><button type="button" data-upgrade="renovation">¥300,000</button></div>
          <div class="upgrade-card"><strong>デジタルサイネージ</strong><small>販促効果 +20%</small><button type="button" data-upgrade="signage">¥180,000</button></div>
        </div><button class="sim-secondary wide" type="button" data-clean-action>店内清掃 ¥8,000</button></section>
        <section class="sim-card"><div class="sim-card-head"><h3>店舗展開</h3><span data-branch-count>1店舗</span></div><div class="branch-list" data-branch-list></div><button class="sim-primary" type="button" data-open-branch>2号店を出店</button><p class="football-help">2号店以降はマネージャー運営の簡易店舗。毎日、評判と景気に応じた利益を本店へ送ります。</p></section>
      </div>
    </section>

    <section class="store-panel" data-store-panel="finance" hidden>
      <div class="sim-grid equal">
        <section class="sim-card"><div class="sim-card-head"><h3>月次PL</h3><span data-pl-month>1か月目</span></div><div class="pl-grid"><div><span>売上</span><b data-pl-sales>¥0</b></div><div><span>仕入原価</span><b data-pl-cogs>¥0</b></div><div><span>人件費</span><b data-pl-wages>¥0</b></div><div><span>家賃・光熱</span><b data-pl-fixed>¥0</b></div><div><span>販促・その他</span><b data-pl-other>¥0</b></div><div class="pl-profit"><span>営業利益</span><b data-pl-profit>¥0</b></div></div><div class="history-bars" data-history-bars></div></section>
        <section class="sim-card"><div class="sim-card-head"><h3>資金調達</h3><span data-debt>借入 ¥0</span></div><div class="loan-actions"><button class="sim-secondary" type="button" data-borrow>¥500,000 借りる</button><button class="sim-secondary" type="button" data-repay>¥100,000 返済</button></div><p class="sim-event">借入残高には月末1%の利息が発生します。資金ショート回避や出店投資に使えます。</p><div class="sim-card-head"><h3>経営履歴</h3><span data-history-count>0 months</span></div><div class="month-history" data-month-history></div></section>
      </div>
    </section>

    <div class="sim-grid equal"><section class="sim-card"><div class="sim-card-head"><h3>直近7日の売上</h3><span data-seven-total>¥0</span></div><div class="history-bars" data-seven-bars></div><ul class="sim-log" data-log></ul></section><section class="sim-card"><div class="sim-card-head"><h3>昨日の営業レポート</h3><span data-report-grade>---</span></div><div class="sim-pills"><span class="sim-pill" data-report-sales>売上 ¥0</span><span class="sim-pill" data-report-cost>経費 ¥0</span><span class="sim-pill" data-report-waste>廃棄 0</span><span class="sim-pill" data-report-stockout>欠品 0</span></div><p class="sim-event" data-report-note>営業後に詳しいレポートが表示されます。</p></section></div>

    <div class="game-over" data-game-over hidden><span>MONTH COMPLETE</span><strong data-final-value>---</strong><p data-final-comment></p><div class="season-reward" data-month-summary></div><button class="button button-primary" type="button" data-next-month>店舗を引き継いで次月へ</button></div>
    <div class="sim-bottom"><button type="button" data-restart>経営を完全リセット</button></div>
  </div>
</section>
</ToolLayout>

<script>
type Staff={id:string;name:string;speed:number;service:number;fresh:number;wage:number;stamina:number;shift:string};
const root=document.querySelector<HTMLElement>('[data-mode="convenience-store-sim"]')!,intro=root.querySelector<HTMLElement>("[data-intro]")!,play=root.querySelector<HTMLElement>("[data-play]")!;
const KEY="utility-tools:sim:convenience-store-sim:v2",BEST="utility-tools:sim:convenience-store-sim:best";
const yen=(n:number)=>"¥"+Math.round(n).toLocaleString("ja-JP"),clamp=(n:number,a:number,b:number)=>Math.max(a,Math.min(b,n)),ri=(a:number,b:number)=>Math.floor(a+Math.random()*(b-a+1));
const q=(x:string)=>root.querySelector<HTMLElement>(x)!,qb=(x:string)=>root.querySelector<HTMLButtonElement>(x)!,qs=(x:string)=>root.querySelector<HTMLSelectElement>(x)!;
const productDefs:any={
 bento:{name:"🍱 弁当",cost:360,price:580,base:24,waste:.16,segments:{office:1.4,student:1.15,senior:.8},times:{lunch:1.7,evening:1.25}},onigiri:{name:"🍙 おにぎり",cost:105,price:180,base:38,waste:.1,segments:{student:1.3,office:1.2},times:{morning:1.35,lunch:1.3}},drink:{name:"🥤 飲料",cost:95,price:160,base:45,waste:0,segments:{student:1.25,office:1.1},times:{lunch:1.2,evening:1.15}},snack:{name:"🍪 お菓子",cost:120,price:220,base:28,waste:0,segments:{student:1.5,family:1.3},times:{evening:1.25,night:1.2}},daily:{name:"🧴 日用品",cost:230,price:390,base:12,waste:0,segments:{family:1.5,senior:1.25},times:{evening:1.2}},umbrella:{name:"☂️ 傘",cost:420,price:780,base:5,waste:0,segments:{all:1},times:{all:1}},ice:{name:"🍦 アイス",cost:110,price:220,base:16,waste:0,segments:{student:1.4,family:1.25},times:{evening:1.3}},coffee:{name:"☕ コーヒー",cost:55,price:180,base:24,waste:0,unlock:"coffee",segments:{office:1.55,senior:1.1},times:{morning:1.7}},hot:{name:"🍗 ホットスナック",cost:110,price:260,base:20,waste:.18,unlock:"hot",segments:{student:1.35,office:1.15},times:{evening:1.4,night:1.3}},magazine:{name:"📚 雑誌",cost:300,price:480,base:7,waste:0,segments:{senior:1.3,office:1.1},times:{morning:1.15,night:1.1}}
};
const keys=Object.keys(productDefs),times=["morning","lunch","evening","night"],timeNames:any={morning:"朝 6-10",lunch:"昼 10-14",evening:"夕 14-20",night:"夜 20-24"};
const segments:any={student:{name:"学生",icon:"🎒"},office:{name:"会社員",icon:"💼"},family:{name:"家族",icon:"👪"},senior:{name:"シニア",icon:"🧓"}};
const seasons:any[]=[{name:"春",m:{onigiri:1.15,bento:1.1},seg:{student:1.12,family:1.08}},{name:"夏",m:{drink:1.35,ice:1.5,coffee:.75,hot:.7},seg:{student:1.12}},{name:"秋",m:{bento:1.18,snack:1.15,coffee:1.08},seg:{family:1.08,senior:1.08}},{name:"冬",m:{coffee:1.45,hot:1.4,ice:.55,drink:.85},seg:{office:1.1,senior:1.12}}];
const events:any[]=[{icon:"☀",weather:"晴れ",text:"気温高め。飲料とアイスが伸びそう。",m:{drink:1.35,ice:1.55}},{icon:"☔",weather:"雨",text:"雨。傘需要が急増、全体客足は少し減少。",m:{umbrella:4,all:.88}},{icon:"🏫",weather:"晴れ",text:"近所で学校行事。学生と家族の来店増。",seg:{student:1.35,family:1.25}},{icon:"🏢",weather:"晴れ",text:"近隣オフィスが繁忙期。昼の会社員が増加。",seg:{office:1.38},tm:{lunch:1.25}},{icon:"📱",weather:"くもり",text:"SNSで店舗が話題。全客層が増加。",m:{all:1.25}},{icon:"🥶",weather:"寒い",text:"冷え込み。コーヒー・ホットスナック好調。",m:{coffee:1.6,hot:1.45,ice:.55}},{icon:"🎆",weather:"晴れ",text:"地域イベント開催。夕方から学生・家族が集中。",seg:{student:1.3,family:1.35},tm:{evening:1.5}},{icon:"😴",weather:"くもり",text:"静かな平日。大きな変化なし。",m:{all:.94}}];
const names=["Aoi","Haru","Mio","Ren","Yuna","Sota","Mei","Riku","Nao","Kai","Sara","Kota","Rin","Yuto"],weekdays=["MON","TUE","WED","THU","FRI","SAT","SUN"];
const read=()=>{try{return JSON.parse(localStorage.getItem(KEY)||"null")}catch{return null}},save=(x:any)=>{try{localStorage.setItem(KEY,JSON.stringify(x))}catch{}},clear=()=>{try{localStorage.removeItem(KEY)}catch{}},readBest=()=>{try{return Number(localStorage.getItem(BEST)||0)||0}catch{return 0}},saveBest=(n:number)=>{if(n>readBest())try{localStorage.setItem(BEST,String(Math.round(n)))}catch{}};
function makeStaff(id:string):Staff{return{id,name:names[ri(0,names.length-1)]+" "+String.fromCharCode(65+ri(0,25))+".",speed:ri(55,88),service:ri(55,88),fresh:ri(50,88),wage:ri(9500,14500),stamina:100,shift:times[ri(0,3)]}}
function candidates(){return[makeStaff("c"+Date.now()+"a"),makeStaff("c"+Date.now()+"b"),makeStaff("c"+Date.now()+"c")]}
function fresh(){const staff=[makeStaff("st1"),makeStaff("st2"),makeStaff("st3")];staff[0].shift="morning";staff[1].shift="lunch";staff[2].shift="evening";return{month:1,day:1,cash:1000000,debt:0,rep:50,rating:3,clean:82,competitor:45,inventory:{bento:35,onigiri:45,drink:55,snack:35,daily:15,umbrella:10,ice:20,coffee:0,hot:0,magazine:12},prices:Object.fromEntries(keys.map(k=>[k,1])),upgrades:{fridge:false,coffee:false,hot:false,self:false,renovation:false,signage:false},shelves:["bento","onigiri","drink","snack","daily","ice"],staff,candidates:candidates(),promo:"none",eventIndex:ri(0,events.length-1),customers:0,lost:0,lastProfit:0,lastReport:null,segmentLast:{student:0,office:0,family:0,senior:0},history:[],monthPL:{sales:0,cogs:0,wages:0,fixed:0,other:0,profit:0},monthHistory:[],branches:[{name:"駅前1号店",level:1,profit:0}],complete:false,initial:1000000,log:[]}}
let s:any=fresh();
const unlocked=(k:string)=>!productDefs[k].unlock||s.upgrades[productDefs[k].unlock];
const branchCost=()=>s.branches.length===1?800000:s.branches.length===2?1500000:99999999;
const storeValue=()=>s.cash-s.debt+keys.reduce((a,k)=>a+s.inventory[k]*productDefs[k].cost,0)+s.rep*2500+s.rating*50000+Object.values(s.upgrades).filter(Boolean).length*80000+(s.branches.length-1)*650000;
function demandHint(k:string){const ev=events[s.eventIndex],m=(ev.m?.[k]??ev.m?.all??1),shelf=s.shelves.filter((x:string)=>x===k).length;return!unlocked(k)?["LOCK",""]:m>=1.3||shelf>0?["需要 ↑","good"]:m<=.75?["需要 ↓","bad"]:["需要 →",""]}
function payroll(){return s.staff.reduce((a:number,x:Staff)=>a+x.wage,0)}
function renderProducts(){q("[data-product-grid]").innerHTML=keys.map(k=>{const p=productDefs[k],[txt,cls]=demandHint(k),lock=!unlocked(k);return`<article class="product-card ${lock?"locked":""}" data-product-card="${k}"><div><strong>${p.name}</strong><small>仕入 ${yen(p.cost)} / 基準 ${yen(p.price)}${p.waste?" / 廃棄あり":""}</small></div><div class="stock"><b data-stock="${k}">${s.inventory[k]}個</b><small>在庫</small></div><div class="product-controls"><select data-price="${k}" ${lock?"disabled":""}><option value=".85">安売 85%</option><option value="1">標準 100%</option><option value="1.15">強気 115%</option><option value="1.3">高値 130%</option></select><button type="button" data-order="${k}" ${lock?"disabled":""}>${lock?"未解禁":"仕入"}</button><span class="sim-pill ${cls}">${txt}</span></div></article>`}).join("");keys.forEach(k=>{const el=root.querySelector<HTMLSelectElement>(`[data-price="${k}"]`);if(el){el.value=String(s.prices[k]);el.onchange=()=>{s.prices[k]=Number(el.value);save(s);render()}}});root.querySelectorAll<HTMLButtonElement>("[data-order]").forEach(b=>b.onclick=()=>{const k=b.dataset.order!,n=Number(qs("[data-order-qty]").value),cost=productDefs[k].cost*n;if(s.cash<cost)return void(q("[data-result]").textContent="仕入資金が不足しています。");s.cash-=cost;s.inventory[k]+=n;s.log.push(`${productDefs[k].name}を${n}個仕入れ`);save(s);render()})}
function renderShelves(){const zones=["入口","入口","中央","中央","レジ前","レジ前"];q("[data-shelf-layout]").innerHTML=s.shelves.map((k:string,i:number)=>`<label><span>${zones[i]} ${i+1}</span><select data-shelf="${i}">${keys.filter(unlocked).map(x=>`<option value="${x}" ${x===k?"selected":""}>${productDefs[x].name}</option>`).join("")}</select></label>`).join("");root.querySelectorAll<HTMLSelectElement>("[data-shelf]").forEach(el=>el.onchange=()=>{s.shelves[Number(el.dataset.shelf)]=el.value;save(s);render()})}
function renderStaff(){q("[data-payroll]").textContent="人件費/日 "+yen(payroll());q("[data-staff-roster]").innerHTML=s.staff.map((x:Staff)=>`<article class="staff-card"><div><strong>${x.name}</strong><small>給与 ${yen(x.wage)}/日</small></div><div class="staff-stats"><span>処理 <b>${x.speed}</b></span><span>接客 <b>${x.service}</b></span><span>鮮度 <b>${x.fresh}</b></span><span>体力 <b>${Math.round(x.stamina)}</b></span></div><select data-shift="${x.id}">${times.map(t=>`<option value="${t}" ${x.shift===t?"selected":""}>${timeNames[t]}</option>`).join("")}</select><button type="button" data-fire-staff="${x.id}" ${s.staff.length<=2?"disabled":""}>退職</button></article>`).join("");root.querySelectorAll<HTMLSelectElement>("[data-shift]").forEach(el=>el.onchange=()=>{s.staff.find((x:Staff)=>x.id===el.dataset.shift).shift=el.value;save(s);render()});root.querySelectorAll<HTMLButtonElement>("[data-fire-staff]").forEach(b=>b.onclick=()=>{if(s.staff.length<=2)return;s.staff=s.staff.filter((x:Staff)=>x.id!==b.dataset.fireStaff);save(s);render()});q("[data-staff-candidates]").innerHTML=s.candidates.map((x:Staff)=>`<article class="candidate-card"><strong>${x.name}</strong><div><span>処理 ${x.speed}</span><span>接客 ${x.service}</span><span>鮮度 ${x.fresh}</span></div><small>${yen(x.wage)}/日</small><button type="button" data-hire-staff="${x.id}" ${s.staff.length>=8||s.cash<35000?"disabled":""}>採用 ¥35,000</button></article>`).join("");root.querySelectorAll<HTMLButtonElement>("[data-hire-staff]").forEach(b=>b.onclick=()=>{const x=s.candidates.find((y:Staff)=>y.id===b.dataset.hireStaff);if(!x||s.cash<35000||s.staff.length>=8)return;s.cash-=35000;s.monthPL.other+=35000;s.staff.push(x);s.candidates=s.candidates.filter((y:Staff)=>y.id!==x.id);save(s);render()})}
function render(){q("[data-best]").textContent=readBest()?yen(readBest()):"---";q("[data-month]").textContent=s.month+"か月目";q("[data-day]").textContent=Math.min(s.day,30)+" / 30";q("[data-weekday]").textContent=weekdays[(s.day-1)%7];q("[data-cash]").textContent=yen(s.cash);q("[data-daily-profit]").textContent="本日 "+(s.lastProfit>=0?"+":"")+yen(s.lastProfit);q("[data-rep]").textContent=Math.round(s.rep)+"";q("[data-rating]").textContent="口コミ ★"+s.rating.toFixed(1);q("[data-customers]").textContent=s.customers+"";q("[data-lost]").textContent="機会損失 "+s.lost+"人";q("[data-value]").textContent=yen(storeValue());q("[data-profit]").textContent="開始時比 "+(storeValue()-s.initial>=0?"+":"")+yen(storeValue()-s.initial);const ev=events[s.eventIndex],season=seasons[(s.month-1)%4];q("[data-weather]").textContent=ev.icon+" "+ev.weather+" / "+season.name;q("[data-event]").textContent=season.name+"｜"+ev.text;q("[data-day-type]").textContent=((s.day-1)%7>=5?"週末":"平日");q("[data-scene-note]").textContent=`${s.branches.length}店舗 / スタッフ${s.staff.length}名`;q("[data-store-people]").textContent="🧍 ".repeat(Math.max(1,Math.min(8,Math.round((s.customers||20)/15)))).trim();(root.querySelector<HTMLProgressElement>("[data-competitor]")!).value=s.competitor;q("[data-competitor-text]").textContent=Math.round(s.competitor)+"";
 const segBase:any={student:28,office:34,family:20,senior:18};q("[data-segments]").innerHTML=Object.keys(segments).map(k=>`<span>${segments[k].icon} ${segments[k].name} <b>${Math.round(segBase[k]*(ev.seg?.[k]??1))}</b></span>`).join("");q("[data-time-demand]").innerHTML=times.map(t=>{const count=s.staff.filter((x:Staff)=>x.shift===t).length,boost=ev.tm?.[t]??1;return`<div><span>${timeNames[t]}</span><b>${boost>=1.25?"🔥":boost<.9?"↓":"→"}</b><small>配置 ${count}名</small></div>`}).join("");const segEntries=Object.entries(s.segmentLast) as [string,number][];segEntries.sort((a,b)=>b[1]-a[1]);q("[data-top-segment]").textContent=segEntries[0]&&segEntries[0][1]>0?segments[segEntries[0][0]].name:"---";const segMax=Math.max(1,...Object.values(s.segmentLast).map(Number));q("[data-segment-bars]").innerHTML=Object.keys(segments).map(k=>`<div><span>${segments[k].icon}${segments[k].name}</span><progress max="${segMax}" value="${s.segmentLast[k]}"></progress><b>${s.segmentLast[k]}</b></div>`).join("");const goalDay=s.day<=7?7:s.day<=14?14:s.day<=21?21:30,goal=goalDay===7?["評判55",s.rep>=55]:goalDay===14?["口コミ★3.5",s.rating>=3.5]:goalDay===21?["現金120万円",s.cash>=1200000]:["店舗価値180万円",storeValue()>=1800000];q("[data-goal]").textContent=`DAY ${goalDay}までに${goal[0]}`;q("[data-goal-status]").textContent=goal[1]?"達成":"進行中";qs("[data-promo]").value=s.promo;
 renderProducts();renderShelves();renderStaff();const ups:any={fridge:90000,coffee:130000,hot:150000,self:220000,renovation:300000,signage:180000};let uc=0;Object.keys(ups).forEach(k=>{const b=qb(`[data-upgrade="${k}"]`);if(s.upgrades[k]){uc++;b.disabled=true;b.textContent="導入済み"}else{b.disabled=s.cash<ups[k]||s.complete;b.textContent=yen(ups[k])}});q("[data-upgrade-count]").textContent=uc+" / 6";q("[data-branch-count]").textContent=s.branches.length+"店舗";q("[data-branch-list]").innerHTML=s.branches.map((b:any,i:number)=>`<div><strong>${b.name}</strong><span>${i===0?"直営":"マネージャー運営"}</span><b>${i===0?"本店":`前日 ${yen(b.profit)}`}</b></div>`).join("");const bc=branchCost(),bb=qb("[data-open-branch]");bb.disabled=s.branches.length>=3||s.cash<bc||s.rep<(s.branches.length===1?55:65);bb.textContent=s.branches.length>=3?"3店舗展開済み":`${s.branches.length+1}号店を出店 ${yen(bc)}（評判${s.branches.length===1?55:65}必要）`;q("[data-debt]").textContent="借入 "+yen(s.debt);qb("[data-repay]").disabled=s.debt<=0||s.cash<100000;qb("[data-borrow]").disabled=s.debt>=1500000;
 const pl=s.monthPL;q("[data-pl-month]").textContent=s.month+"か月目";q("[data-pl-sales]").textContent=yen(pl.sales);q("[data-pl-cogs]").textContent=yen(pl.cogs);q("[data-pl-wages]").textContent=yen(pl.wages);q("[data-pl-fixed]").textContent=yen(pl.fixed);q("[data-pl-other]").textContent=yen(pl.other);q("[data-pl-profit]").textContent=(pl.profit>=0?"+":"")+yen(pl.profit);const maxHist=Math.max(1,...s.history.slice(-30).map((x:any)=>x.sales));q("[data-history-bars]").innerHTML=s.history.slice(-30).map((x:any)=>`<span style="height:${Math.max(6,x.sales/maxHist*100)}%"></span>`).join("");q("[data-history-count]").textContent=s.monthHistory.length+" months";q("[data-month-history]").innerHTML=s.monthHistory.length?s.monthHistory.slice().reverse().map((h:any)=>`<div><b>M${h.month}</b><span>売上 ${yen(h.sales)}</span><span class="${h.profit>=0?"up":"down"}">${h.profit>=0?"+":""}${yen(h.profit)}</span><span>${h.branches}店舗 / ★${h.rating.toFixed(1)}</span></div>`).join(""):"<p>まだ完了した月はありません。</p>";
 const hist=s.history.slice(-7),mx=Math.max(1,...hist.map((x:any)=>x.sales));q("[data-seven-bars]").innerHTML=hist.length?hist.map((x:any)=>`<span style="height:${Math.max(8,x.sales/mx*100)}%"></span>`).join(""):"<span style='height:8%'></span>";q("[data-seven-total]").textContent=yen(hist.reduce((a:number,x:any)=>a+x.sales,0));q("[data-log]").innerHTML=s.log.slice(-7).reverse().map((x:string)=>"<li>"+x+"</li>").join("");if(s.lastReport){const r=s.lastReport;q("[data-report-grade]").textContent=r.grade;q("[data-report-sales]").textContent="売上 "+yen(r.sales);q("[data-report-cost]").textContent="経費 "+yen(r.costs);q("[data-report-waste]").textContent="廃棄 "+r.waste+"個";q("[data-report-stockout]").textContent="欠品 "+r.stockouts+"品";q("[data-report-note]").textContent=r.note}q("[data-game-over]").hidden=!s.complete;if(s.complete)root.dataset.state="complete";else root.dataset.state="running";bindTabs()}
function bindTabs(){root.querySelectorAll<HTMLButtonElement>("[data-store-tab]").forEach(b=>b.onclick=()=>{const key=b.dataset.storeTab;root.querySelectorAll<HTMLElement>("[data-store-panel]").forEach(p=>p.hidden=p.dataset.storePanel!==key);root.querySelectorAll<HTMLButtonElement>("[data-store-tab]").forEach(x=>x.classList.toggle("active",x===b))})}
function start(load=false){s=load&&read()?read():fresh();intro.hidden=true;play.hidden=false;save(s);render()}
qb("[data-start]").onclick=()=>start(false);const cont=qb("[data-continue]");cont.hidden=!read();cont.onclick=()=>start(true);qb("[data-restart]").onclick=()=>{clear();start(false)};qs("[data-promo]").onchange=()=>{s.promo=qs("[data-promo]").value;save(s);render()};qb("[data-refresh-candidates]").onclick=()=>{if(s.cash<5000)return;s.cash-=5000;s.monthPL.other+=5000;s.candidates=candidates();save(s);render()};qb("[data-clean-action]").onclick=()=>{if(s.cash<8000)return;s.cash-=8000;s.monthPL.other+=8000;s.clean=clamp(s.clean+24,0,s.upgrades.renovation?110:100);save(s);render()};
const upCosts:any={fridge:90000,coffee:130000,hot:150000,self:220000,renovation:300000,signage:180000};root.querySelectorAll<HTMLButtonElement>("[data-upgrade]").forEach(b=>b.onclick=()=>{const k=b.dataset.upgrade!;if(s.upgrades[k]||s.cash<upCosts[k])return;s.cash-=upCosts[k];s.monthPL.other+=upCosts[k];s.upgrades[k]=true;s.rep+=k==="renovation"?5:2;if(k==="coffee")s.inventory.coffee=20;if(k==="hot")s.inventory.hot=20;save(s);render()});qb("[data-open-branch]").onclick=()=>{const c=branchCost(),need=s.branches.length===1?55:65;if(s.branches.length>=3||s.cash<c||s.rep<need)return;s.cash-=c;s.monthPL.other+=c;s.branches.push({name:`${s.branches.length+1}号店`,level:1,profit:0});s.log.push(`${s.branches.length}号店を出店`);save(s);render()};qb("[data-borrow]").onclick=()=>{if(s.debt>=1500000)return;s.debt+=500000;s.cash+=500000;s.log.push("融資 ¥500,000");save(s);render()};qb("[data-repay]").onclick=()=>{const n=Math.min(100000,s.debt);if(s.cash<n||n<=0)return;s.cash-=n;s.debt-=n;save(s);render()};
function shelfBoost(k:string){const slots=s.shelves.map((x:string,i:number)=>x===k?i:-1).filter((i:number)=>i>=0);return slots.reduce((a:number,i:number,n:number)=>a+(i>=4?.16:i<2?.12:.09)*Math.pow(.65,n),1)}
function runDay(){if(s.complete)return;const season=seasons[(s.month-1)%4],promoCost:any={none:0,flyer:12000,sns:25000,coupon:18000,student:20000},promoMult:any={none:1,flyer:1.12,sns:1.23,coupon:1.17,student:1.1};const pc=promoCost[s.promo];if(pc>0&&s.cash<pc)return void(q("[data-result]").textContent="販促費を払える現金がありません。販促を「なし」にするか融資を利用してください。");const ev=events[s.eventIndex],weekend=(s.day-1)%7>=5?1.16:1,segCounts:any={student:0,office:0,family:0,senior:0};let sales=0,cogsSold=0,waste=0,stockouts=0,lost=0,served=0;for(const t of times){const workers=s.staff.filter((x:Staff)=>x.shift===t&&x.stamina>20),speed=workers.reduce((a:number,x:Staff)=>a+x.speed,0),service=workers.length?workers.reduce((a:number,x:Staff)=>a+x.service,0)/workers.length:25,capacity=(speed*.55+15)*(s.upgrades.self?1.35:1);let timeDemand=0;for(const seg of Object.keys(segments)){let segBase={student:18,office:22,family:13,senior:12}[seg]||10;segBase*=ev.seg?.[seg]??1;segBase*=season.seg?.[seg]??1;segBase*=weekend*(ev.tm?.[t]??1);if(t==="morning"&&seg==="office")segBase*=1.35;if(t==="lunch"&&(seg==="office"||seg==="student"))segBase*=1.3;if(t==="evening"&&seg==="family")segBase*=1.35;if(t==="night"&&seg==="student")segBase*=1.18;const promoFactor=s.promo==="student"?(seg==="student"?1.45:1):promoMult[s.promo];const people=Math.max(0,Math.round(segBase*(.8+s.rep/250)*(1-s.competitor/260)*promoFactor*(s.upgrades.signage?1.08:1)));segCounts[seg]+=people;timeDemand+=people}const servedTime=Math.min(Math.round(timeDemand),Math.round(capacity)),ratio=servedTime/Math.max(1,timeDemand);served+=servedTime;lost+=Math.max(0,Math.round(timeDemand-servedTime));for(const k of keys){if(!unlocked(k))continue;const p=productDefs[k],pm=s.prices[k],elastic=clamp(1.35-(pm-1)*1.5,.5,1.5),weather=(ev.m?.[k]??ev.m?.all??1)*(season.m?.[k]??1),timeMult=p.times?.[t]??p.times?.all??1;let segMult=0,totalSeg=0;for(const seg of Object.keys(segments)){const n=segCounts[seg];segMult+=n*(p.segments?.[seg]??p.segments?.all??1);totalSeg+=n}segMult=totalSeg?segMult/totalSeg:1;const demand=Math.max(0,Math.round(p.base*.25*elastic*weather*timeMult*segMult*shelfBoost(k)*ratio*(.88+Math.random()*.24)));const qty=Math.min(s.inventory[k],demand);if(qty<demand)stockouts++;s.inventory[k]-=qty;sales+=qty*p.price*pm*(s.promo==="coupon"?.9:1);cogsSold+=qty*p.cost}for(const w of workers)w.stamina=clamp(w.stamina-ri(7,13),0,100);s.rep=clamp(s.rep+(service-60)/220,0,100)}for(const k of keys){const p=productDefs[k];if(p.waste&&unlocked(k)){const avgFresh=s.staff.reduce((a:number,x:Staff)=>a+x.fresh,0)/Math.max(1,s.staff.length),rate=p.waste*(1-(avgFresh-50)/250),w=Math.floor(s.inventory[k]*rate);s.inventory[k]-=w;waste+=w}}const wages=payroll(),fixed=17500+s.branches.length*2500+Object.values(s.upgrades).filter(Boolean).length*900,branchProfit=s.branches.slice(1).reduce((a:number,b:any)=>{b.profit=Math.round((18000+s.rep*450)*(1-s.competitor/180)*(.8+Math.random()*.4));return a+b.profit},0),costs=wages+fixed+pc,cashFlow=sales+branchProfit-costs,profit=cashFlow-cogsSold;s.cash+=cashFlow;if(s.cash<0&&s.debt<1500000){const rescue=Math.min(500000,1500000-s.debt);s.debt+=rescue;s.cash+=rescue;s.log.push("資金ショート：緊急融資 "+yen(rescue))}s.monthPL.sales+=sales+branchProfit;s.monthPL.cogs+=cogsSold;s.monthPL.wages+=wages;s.monthPL.fixed+=fixed;s.monthPL.other+=pc;s.monthPL.profit+=profit;s.customers=served;s.lost=lost;s.segmentLast=segCounts;s.lastProfit=profit;s.clean=clamp(s.clean-5-served/80,15,s.upgrades.renovation?110:100);s.rating=clamp(s.rating+(s.clean>75?.025:-.04)+(lost>15?-.035:.015)-(stockouts*.008)+(s.rep-50)/6000,1,5);s.rep=clamp(s.rep+(s.rating-3)*.08-(stockouts*.12),0,100);s.competitor=clamp(s.competitor+(Math.random()-.48)*3,25,82);for(const w of s.staff)w.stamina=clamp(w.stamina+10,0,100);const grade=profit>90000?"S":profit>50000?"A":profit>15000?"B":profit>=0?"C":"D";s.lastReport={sales:sales+branchProfit,costs,waste,stockouts,grade,note:`来店 ${served}人 / 機会損失 ${lost}人。支店利益 ${yen(branchProfit)}、営業利益 ${yen(profit)}。`};s.history.push({month:s.month,day:s.day,sales:sales+branchProfit,profit});s.log.push(`M${s.month} DAY${s.day} 売上 ${yen(sales+branchProfit)} / 利益 ${profit>=0?"+":""}${yen(profit)}`);s.day++;s.eventIndex=ri(0,events.length-1);s.promo="none";if(s.day>30)finishMonth();else save(s);render()}
function finishMonth(){const interest=Math.round(s.debt*.01);s.cash-=interest;s.monthPL.other+=interest;s.monthPL.profit-=interest;const v=storeValue();saveBest(v);s.monthHistory.push({month:s.month,sales:s.monthPL.sales,profit:s.monthPL.profit,rating:s.rating,branches:s.branches.length,value:v});s.complete=true;q("[data-final-value]").textContent=yen(v);q("[data-final-comment]").textContent=s.monthPL.profit>300000?"高収益月。出店・設備投資で次の成長を狙えます。":s.monthPL.profit>=0?"黒字を確保。棚割りとシフトを詰めればさらに伸ばせます。":"赤字月。固定費・人員・廃棄・価格を見直しましょう。";q("[data-month-summary]").textContent=`月間売上 ${yen(s.monthPL.sales)} / 営業利益 ${s.monthPL.profit>=0?"+":""}${yen(s.monthPL.profit)} / 利息 ${yen(interest)}`;save(s);render()}
function nextMonth(){if(!s.complete)return;s.month++;s.day=1;s.complete=false;s.monthPL={sales:0,cogs:0,wages:0,fixed:0,other:0,profit:0};s.lastProfit=0;s.candidates=candidates();s.competitor=clamp(s.competitor+ri(-5,5),25,82);s.inventory.bento=Math.max(s.inventory.bento,15);s.inventory.onigiri=Math.max(s.inventory.onigiri,20);root.dataset.state="running";save(s);render()}
qb("[data-open]").onclick=runDay;qb("[data-next-month]").onclick=nextMonth;
