---
import ToolLayout from "../layout/ToolLayout.astro";
import type { ExtraToolMeta } from "../../config/extra-tools";
interface Props { meta: ExtraToolMeta; }
const { meta } = Astro.props;
---

<ToolLayout title={meta.title} description={meta.description} name={meta.name} category={meta.category} faqs={meta.faqs}>
<section class="sim-shell invest-sim invest-deep" data-sim-game data-mode="investment-sim" data-state="ready">
  <header class="sim-top"><div><p class="sim-kicker">5 YEARS / FICTIONAL MARKET</p><h2>Market Lab</h2><p class="sim-sub">架空企業の決算・金利・景気・配当・IPO・ニュースを読み、60か月で資産を育てる投資シミュレーション。企業価値と相場環境の両方を見て判断します。</p></div><div class="sim-best"><span>BEST ASSETS</span><strong data-best>---</strong></div></header>
  <div class="sim-disclaimer">このゲームの企業・価格・指標・ニュースはすべて架空です。実際の金融商品や投資判断には利用できません。</div>
  <div class="sim-kpis">
    <div class="sim-kpi"><span>YEAR / MONTH</span><strong data-year>1年目</strong><small data-month>1 / 60</small></div>
    <div class="sim-kpi"><span>ASSETS</span><strong data-assets>¥1,000,000</strong><small data-return>+0.0%</small></div>
    <div class="sim-kpi"><span>CASH</span><strong data-cash>¥1,000,000</strong><small data-cash-ratio>現金 100%</small></div>
    <div class="sim-kpi"><span>P/L</span><strong data-unrealized>±¥0</strong><small data-realized>実現 ±¥0</small></div>
    <div class="sim-kpi"><span>INCOME</span><strong data-dividend>¥0</strong><small data-fee>手数料 ¥0</small></div>
  </div>

  <div class="sim-intro" data-intro>
    <div><h3>チャートだけでは勝てない市場へ</h3><p>企業ごとのPER・PBR・利益成長・財務、四半期決算、政策金利、インフレ、景気局面、IPOを確認して売買します。5年間の資産成長とリスク管理を競います。</p><div class="sim-actions"><button class="button button-primary" type="button" data-start>新規運用を始める</button><button class="button button-secondary" type="button" data-continue hidden>保存データから続ける</button></div></div>
    <ul><li>8社＋途中上場するIPO銘柄</li><li>3か月ごとの決算と配当</li><li>金利・インフレ・景気循環がセクターへ波及</li><li>暴落・バブル・政策転換などの市場イベント</li><li>ベンチマーク・最大DD・分散度・実現損益を評価</li></ul>
  </div>

  <div class="sim-play" data-play hidden>
    <section class="macro-board">
      <div><span>POLICY RATE</span><strong data-rate>1.0%</strong><small data-rate-arrow>→</small></div>
      <div><span>INFLATION</span><strong data-inflation>2.0%</strong><small>CPI</small></div>
      <div><span>GROWTH</span><strong data-growth>1.5%</strong><small>GDP</small></div>
      <div><span>CYCLE</span><strong data-cycle>拡大</strong><small data-regime>通常相場</small></div>
      <div><span>BENCHMARK</span><strong data-benchmark>100.0</strong><small data-alpha>α +0.0%</small></div>
    </section>

    <div class="sim-grid">
      <section class="sim-card">
        <div class="sim-card-head"><h3>PORTFOLIO CHART</h3><label>表示<select data-chart-select><option value="portfolio">総資産</option><option value="benchmark">市場指数</option></select></label></div>
        <div class="chart-wrap"><svg viewBox="0 0 600 190" role="img" aria-label="資産推移チャート"><line class="chart-grid" x1="0" x2="600" y1="47" y2="47"/><line class="chart-grid" x1="0" x2="600" y1="95" y2="95"/><line class="chart-grid" x1="0" x2="600" y1="143" y2="143"/><polyline class="chart-line" data-chart-points points="0,95 600,95"/></svg></div>
        <div class="performance-pills"><span data-peak>最高 ¥1,000,000</span><span data-drawdown>最大DD 0.0%</span><span data-volatility>変動率 0.0%</span><span data-diversification>分散 100</span></div>
      </section>
      <section class="sim-card market-news-card">
        <div class="sim-card-head"><h3>今月のマーケット</h3><span data-sentiment>NEUTRAL</span></div>
        <div class="sim-event" data-news>市場は静かなスタート。</div>
        <div class="macro-impact" data-macro-impact></div>
        <div class="risk-meter"><span>RISK</span><meter data-risk-meter min="0" max="100" value="0"></meter><b data-risk-score>0</b></div>
        <div class="sim-event" data-outlook>次月見通し：企業業績と政策金利に注目。</div>
        <button class="sim-primary" type="button" data-next-month>1か月進める</button>
        <div class="sim-result" data-result>ニュース、決算、企業価値を見て売買しよう。</div>
      </section>
    </div>

    <nav class="investment-tabs" aria-label="投資管理メニュー">
      <button class="active" type="button" data-invest-tab="market">マーケット</button>
      <button type="button" data-invest-tab="research">企業分析</button>
      <button type="button" data-invest-tab="portfolio">ポートフォリオ</button>
      <button type="button" data-invest-tab="records">実績</button>
    </nav>

    <section class="sim-card invest-panel" data-invest-panel="market">
      <div class="sim-card-head"><h3>架空マーケット</h3><div class="market-controls"><label>売買単位<select data-qty><option value="1">1口</option><option value="5" selected>5口</option><option value="10">10口</option><option value="25">25口</option><option value="50">50口</option><option value="100">100口</option></select></label><label>並び順<select data-sort><option value="ticker">銘柄</option><option value="change">騰落率</option><option value="pe">PER</option><option value="yield">配当利回り</option><option value="growth">成長率</option></select></label></div></div>
      <div class="market-grid investment-market" data-market-grid></div>
      <div class="ipo-strip"><div><span>NEXT IPO</span><strong data-ipo-name>---</strong><small data-ipo-info>上場予定を待っています</small></div><button class="sim-secondary" type="button" data-ipo-reserve disabled>IPO申込</button></div>
    </section>

    <section class="sim-card invest-panel" data-invest-panel="research" hidden>
      <div class="sim-card-head"><h3>企業分析</h3><label>企業<select data-research-select></select></label></div>
      <div class="company-research" data-company-research></div>
      <div class="earnings-board"><div class="sim-card-head"><h3>直近決算</h3><span data-earnings-quarter>まだありません</span></div><div data-earnings-detail class="earnings-detail">3か月ごとに決算が更新されます。</div></div>
    </section>

    <section class="invest-panel" data-invest-panel="portfolio" hidden>
      <div class="sim-grid equal">
        <section class="sim-card"><div class="sim-card-head"><h3>資産配分</h3><span data-trade-count>取引 0回</span></div><div class="allocation-list" data-allocation></div></section>
        <section class="sim-card"><div class="sim-card-head"><h3>ポートフォリオ診断</h3><span data-risk-label>LOW</span></div><div class="portfolio-diagnosis" data-diagnosis></div><div class="preset-actions"><button type="button" data-rebalance="defensive">守備型へ</button><button type="button" data-rebalance="balanced">分散型へ</button><button type="button" data-rebalance="growth">成長型へ</button></div></section>
      </div>
      <section class="sim-card holdings-card"><div class="sim-card-head"><h3>保有銘柄</h3><span data-holdings-count>0銘柄</span></div><div class="holdings-table-wrap"><table class="holdings-table"><thead><tr><th>銘柄</th><th>口数</th><th>平均取得</th><th>現在値</th><th>評価額</th><th>含み損益</th><th>配当利回り</th></tr></thead><tbody data-holdings-table></tbody></table></div></section>
    </section>

    <section class="invest-panel" data-invest-panel="records" hidden>
      <div class="sim-grid equal">
        <section class="sim-card"><div class="sim-card-head"><h3>運用実績</h3><span data-score>0 pt</span></div><div class="record-grid" data-record-grid></div></section>
        <section class="sim-card"><div class="sim-card-head"><h3>運用ログ</h3><span data-log-month>YEAR 1</span></div><ul class="sim-log investment-log" data-log></ul></section>
      </div>
      <section class="sim-card"><div class="sim-card-head"><h3>年次リターン</h3><span>vs MARKET 100</span></div><div class="year-history" data-year-history></div></section>
    </section>

    <div class="game-over" data-game-over hidden><span>5 YEARS COMPLETE</span><strong data-final-assets>---</strong><p data-final-comment></p><div class="final-invest-stats" data-final-stats></div><button class="button button-primary" type="button" data-new-cycle>資産を引き継いで次の5年へ</button></div>
    <div class="sim-bottom"><button type="button" data-restart>運用を完全リセット</button></div>
  </div>
</section>
</ToolLayout>

<script>
type Asset={id:string;name:string;sector:string;listed:boolean;ipoMonth:number;ipoPrice:number;price:number;prev:number;holding:number;avg:number;revenue:number;growth:number;margin:number;eps:number;book:number;debt:number;divYield:number;beta:number;quality:number;quarter:number;surprise:number;history:number[]};
const root=document.querySelector<HTMLElement>('[data-mode="investment-sim"]')!,intro=root.querySelector<HTMLElement>("[data-intro]")!,play=root.querySelector<HTMLElement>("[data-play]")!;
const KEY="utility-tools:sim:investment-sim:v2",BEST="utility-tools:sim:investment-sim:best",yen=(n:number)=>"¥"+Math.round(n).toLocaleString("ja-JP"),clamp=(n:number,a:number,b:number)=>Math.max(a,Math.min(b,n)),ri=(a:number,b:number)=>Math.floor(a+Math.random()*(b-a+1));
const q=(x:string)=>root.querySelector<HTMLElement>(x)!,qb=(x:string)=>root.querySelector<HTMLButtonElement>(x)!,qs=(x:string)=>root.querySelector<HTMLSelectElement>(x)!;
const templates:any[]=[
 {id:"nova",name:"NOVA",sector:"テクノロジー",price:1200,revenue:1280,growth:18,margin:22,eps:62,book:420,debt:18,divYield:0,beta:1.45,quality:78},
 {id:"harbor",name:"HARBOR",sector:"生活・小売",price:820,revenue:2210,growth:5,margin:9,eps:48,book:510,debt:34,divYield:2.8,beta:.78,quality:76},
 {id:"green",name:"GREEN",sector:"エネルギー",price:1480,revenue:1640,growth:12,margin:15,eps:72,book:690,debt:41,divYield:1.1,beta:1.28,quality:69},
 {id:"med",name:"MEDICA",sector:"ヘルスケア",price:1050,revenue:1780,growth:8,margin:18,eps:66,book:560,debt:21,divYield:2.1,beta:.72,quality:84},
 {id:"estate",name:"ESTATE",sector:"不動産",price:940,revenue:910,growth:4,margin:28,eps:54,book:760,debt:62,divYield:4.5,beta:.92,quality:65},
 {id:"bond",name:"STABLE",sector:"債券",price:1000,revenue:0,growth:0,margin:0,eps:42,book:1000,debt:0,divYield:3.2,beta:.22,quality:92},
 {id:"atlas",name:"ATLAS",sector:"製造",price:760,revenue:2460,growth:7,margin:11,eps:44,book:490,debt:37,divYield:2.4,beta:.96,quality:73},
 {id:"finx",name:"FINX",sector:"金融",price:890,revenue:2010,growth:6,margin:17,eps:58,book:620,debt:29,divYield:3.1,beta:1.02,quality:75},
 {id:"orbit",name:"ORBIT",sector:"宇宙・通信",price:0,revenue:410,growth:38,margin:-6,eps:-8,book:260,debt:48,divYield:0,beta:1.8,quality:58,ipoMonth:7,ipoPrice:680},
 {id:"quant",name:"QUANT",sector:"AI・金融",price:0,revenue:520,growth:31,margin:12,eps:18,book:310,debt:12,divYield:0,beta:1.65,quality:71,ipoMonth:25,ipoPrice:920}
];
const sectorMap:any={"テクノロジー":"tech","生活・小売":"consumer","エネルギー":"energy","ヘルスケア":"health","不動産":"estate","債券":"bond","製造":"industry","金融":"finance","宇宙・通信":"tech","AI・金融":"tech"};
const events:any[]=[
 {sent:"BULL",name:"AI投資ブーム",text:"設備投資が加速。成長企業へ資金流入。",fx:{tech:.065,industry:.018},macro:{growth:.18,inflation:.04}},
 {sent:"HAWKISH",name:"利上げ警戒",text:"インフレ再燃。金利敏感株に逆風。",fx:{estate:-.055,tech:-.03,finance:.025,bond:-.018},macro:{rate:.25,inflation:.18,growth:-.08}},
 {sent:"RISK OFF",name:"景気減速",text:"消費と製造が弱含み。守備セクターへ資金移動。",fx:{consumer:-.028,industry:-.045,health:.028,bond:.025},macro:{growth:-.28,inflation:-.08}},
 {sent:"ENERGY",name:"資源価格上昇",text:"エネルギー企業の採算改善期待。",fx:{energy:.075,consumer:-.012},macro:{inflation:.14}},
 {sent:"RECOVERY",name:"景気回復期待",text:"幅広い企業の業績改善期待が高まる。",fx:{all:.028,industry:.025,finance:.018},macro:{growth:.24}},
 {sent:"SELL OFF",name:"市場急落",text:"信用不安で全面安。高ベータ株を中心に売り。",fx:{all:-.075,tech:-.055,energy:-.035,finance:-.04},macro:{growth:-.18}},
 {sent:"CALM",name:"方向感なし",text:"材料不足。企業ごとの決算が株価を左右。",fx:{all:0},macro:{}},
 {sent:"DOVISH",name:"金融緩和観測",text:"金利低下期待。成長株と不動産に追い風。",fx:{tech:.045,estate:.052,bond:.018},macro:{rate:-.25,growth:.1}},
 {sent:"CRASH",name:"市場クラッシュ",text:"金融市場で信用不安が拡大。全面安となり、高ベータ株に強い売り。",fx:{all:-.14,tech:-.055,finance:-.04,energy:-.025,bond:.025},macro:{rate:-.25,growth:-.65,inflation:-.2}},
 {sent:"MANIA",name:"投機バブル",text:"リスク選好が急拡大。成長株を中心に短期資金が殺到。",fx:{all:.085,tech:.055,energy:.025,bond:-.015},macro:{growth:.28,inflation:.12}}
];
const read=()=>{try{return JSON.parse(localStorage.getItem(KEY)||"null")}catch{return null}},save=(x:any)=>{try{localStorage.setItem(KEY,JSON.stringify(x))}catch{}},clear=()=>{try{localStorage.removeItem(KEY)}catch{}},readBest=()=>{try{return Number(localStorage.getItem(BEST)||0)||0}catch{return 0}},saveBest=(n:number)=>{if(n>readBest())try{localStorage.setItem(BEST,String(Math.round(n)))}catch{}};
function makeAssets(){return templates.map(t=>({...t,listed:!t.ipoMonth,price:t.price||t.ipoPrice,prev:t.price||t.ipoPrice,holding:0,avg:0,quarter:0,surprise:0,history:[t.price||t.ipoPrice]})) as Asset[]}
const fresh=()=>({month:1,cycle:1,initialCapital:1000000,cash:1000000,assets:makeAssets(),rate:1,inflation:2,growth:1.5,regime:"拡大",eventIndex:6,benchmark:100,benchmarkHistory:[100],portfolioHistory:[1000000],dividend:0,fees:0,realized:0,trades:0,ipoReservations:[],log:[],yearHistory:[],lastYearValue:1000000,complete:false,selected:"nova"});
let s:any=fresh();
const listed=()=>s.assets.filter((a:Asset)=>a.listed),asset=(id:string)=>s.assets.find((a:Asset)=>a.id===id),total=()=>s.cash+listed().reduce((x:number,a:Asset)=>x+a.holding*a.price,0),marketValue=(a:Asset)=>a.holding*a.price;
function pe(a:Asset){return a.eps>0?a.price/a.eps:99.9}function pbr(a:Asset){return a.book>0?a.price/a.book:0}function unrealized(a:Asset){return a.holding*(a.price-a.avg)}function totalUnrealized(){return listed().reduce((x:number,a:Asset)=>x+unrealized(a),0)}
function riskScore(){const t=total();if(t<=0)return 0;const invested=listed().some((a:Asset)=>a.holding>0),score=Math.round(listed().reduce((x:number,a:Asset)=>x+(marketValue(a)/t)*a.beta*45,0));return invested?Math.max(1,score):0}
function diversification(){const t=listed().reduce((x:number,a:Asset)=>x+marketValue(a),0);if(!t)return 100;const hhi=listed().reduce((x:number,a:Asset)=>x+(marketValue(a)/t)**2,0);return Math.round(clamp((1-hhi)*135,0,100))}
function volatility(){const h=s.portfolioHistory;if(h.length<3)return 0;const r=h.slice(1).map((v:number,i:number)=>v/h[i]-1),m=r.reduce((x:number,v:number)=>x+v,0)/r.length;return Math.sqrt(r.reduce((x:number,v:number)=>x+(v-m)**2,0)/r.length)*Math.sqrt(12)*100}
function maxDrawdown(){let peak=s.portfolioHistory[0],dd=0;for(const v of s.portfolioHistory){peak=Math.max(peak,v);dd=Math.min(dd,(v/peak-1)*100)}return dd}
function benchmarkReturn(){return (s.benchmark/100-1)*100}function portfolioReturn(){return (total()/(s.initialCapital||1000000)-1)*100}function alpha(){return portfolioReturn()-benchmarkReturn()}
function eventImpact(a:Asset,ev:any){const key=sectorMap[a.sector],base=ev.fx[key]??ev.fx.all??0;let macro=0;if(a.sector==="不動産")macro-=Math.max(0,s.rate-1)*.008;if(a.sector==="金融")macro+=(s.rate-1)*.005;if(a.sector==="債券")macro-=(s.rate-1)*.004;if(["テクノロジー","宇宙・通信","AI・金融"].includes(a.sector))macro+=s.growth*.003-s.rate*.0025;return base+macro}
function updateRegime(){s.regime=s.growth>2.2?"好況":s.growth<.2?"後退":s.inflation>3.2?"インフレ":s.rate>=2.5?"引締め":"拡大"}
function nextIpo(){return s.assets.filter((a:Asset)=>!a.listed&&a.ipoMonth>=s.month).sort((a:Asset,b:Asset)=>a.ipoMonth-b.ipoMonth)[0]}function pickEvent(){const r=Math.random();if(r<.035)return 8;if(r<.075)return 9;return ri(0,7)}
function renderMarket(){const sort=qs("[data-sort]").value;let arr=[...listed()];arr.sort((a:Asset,b:Asset)=>sort==="change"?(b.price/b.prev-a.price/a.prev):sort==="pe"?pe(a)-pe(b):sort==="yield"?b.divYield-a.divYield:sort==="growth"?b.growth-a.growth:a.name.localeCompare(b.name));q("[data-market-grid]").innerHTML=arr.map((a:Asset)=>{const ch=(a.price/a.prev-1)*100,pl=unrealized(a),cheap=pe(a)<14&&a.eps>0;return '<article class="asset-card deep-asset" data-asset-row="'+a.id+'"><div class="asset-head"><button type="button" data-open-research="'+a.id+'"><strong>'+a.name+'</strong><small>'+a.sector+'</small></button><span class="'+(ch>=0?'up':'down')+'">'+(ch>=0?'+':'')+ch.toFixed(1)+'%</span></div><div class="asset-price"><b data-price="'+a.id+'">'+yen(a.price)+'</b><span data-holding="'+a.id+'">'+a.holding+'口</span></div><div class="asset-fundamentals"><span>PER <b>'+pe(a).toFixed(1)+'</b></span><span>PBR <b>'+pbr(a).toFixed(1)+'</b></span><span>成長 <b>'+a.growth.toFixed(1)+'%</b></span><span>配当 <b>'+a.divYield.toFixed(1)+'%</b></span></div><div class="asset-tags"><span>'+(a.quality>=80?'QUALITY':a.beta>=1.4?'HIGH β':cheap?'VALUE':'CORE')+'</span><b class="'+(pl>=0?'up':'down')+'">'+(a.holding?((pl>=0?'+':'')+yen(pl)):'未保有')+'</b></div><div class="asset-actions"><button type="button" data-buy="'+a.id+'">買う</button><button type="button" data-sell="'+a.id+'" '+(!a.holding?'disabled':'')+'>売る</button></div></article>'}).join("");bindTrades();root.querySelectorAll<HTMLButtonElement>("[data-open-research]").forEach(b=>b.onclick=()=>{s.selected=b.dataset.openResearch!;qs("[data-research-select]").value=s.selected;setTab("research");renderResearch()})}
function renderResearch(){const a=asset(s.selected)||listed()[0];if(!a)return;const valuation=pe(a)<13?"割安":pe(a)>28?"割高":"中立",balance=a.debt<25?"健全":a.debt>55?"重い":"標準";q("[data-company-research]").innerHTML='<div class="research-hero"><div><span>'+a.sector+'</span><h4>'+a.name+'</h4><p>品質スコア '+a.quality+' / β '+a.beta.toFixed(2)+'</p></div><strong>'+yen(a.price)+'</strong></div><div class="research-grid"><div><span>売上</span><b>'+a.revenue.toFixed(0)+'億</b></div><div><span>売上成長</span><b>'+a.growth.toFixed(1)+'%</b></div><div><span>営業利益率</span><b>'+a.margin.toFixed(1)+'%</b></div><div><span>EPS</span><b>'+a.eps.toFixed(1)+'</b></div><div><span>PER</span><b>'+pe(a).toFixed(1)+'倍</b><small>'+valuation+'</small></div><div><span>PBR</span><b>'+pbr(a).toFixed(1)+'倍</b></div><div><span>負債比率</span><b>'+a.debt.toFixed(0)+'%</b><small>'+balance+'</small></div><div><span>配当利回り</span><b>'+a.divYield.toFixed(1)+'%</b></div></div>';
 if(a.quarter){q("[data-earnings-quarter]").textContent='Q'+a.quarter+' / '+(a.surprise>=0?'上振れ':'下振れ');q("[data-earnings-detail]").innerHTML='<strong class="'+(a.surprise>=0?'up':'down')+'">EPS surprise '+(a.surprise>=0?'+':'')+a.surprise.toFixed(1)+'%</strong><span>売上成長 '+a.growth.toFixed(1)+'%</span><span>利益率 '+a.margin.toFixed(1)+'%</span><span>次回決算まで '+(3-(s.month%3||3))+'か月</span>'}else{q("[data-earnings-quarter]").textContent="まだありません";q("[data-earnings-detail]").textContent="3か月ごとに決算が更新されます。"}}
function renderPortfolio(){const t=total(),rows=listed().filter((a:Asset)=>a.holding);q("[data-holdings-count]").textContent=rows.length+'銘柄';q("[data-holdings-table]").innerHTML=rows.length?rows.map((a:Asset)=>'<tr><td><b>'+a.name+'</b><small>'+a.sector+'</small></td><td>'+a.holding+'</td><td>'+yen(a.avg)+'</td><td>'+yen(a.price)+'</td><td>'+yen(marketValue(a))+'</td><td class="'+(unrealized(a)>=0?'up':'down')+'">'+(unrealized(a)>=0?'+':'')+yen(unrealized(a))+'</td><td>'+a.divYield.toFixed(1)+'%</td></tr>').join(''):'<tr><td colspan="7">まだ保有銘柄はありません。</td></tr>';const items=[{name:"現金",v:s.cash},...rows.map((a:Asset)=>({name:a.name,v:marketValue(a)}))].filter(x=>x.v>0);q("[data-allocation]").innerHTML=items.map(x=>'<div class="allocation-row"><span>'+x.name+'</span><progress max="'+t+'" value="'+x.v+'"></progress><b>'+Math.round(x.v/t*100)+'%</b></div>').join('');const risk=riskScore(),div=diversification();q("[data-risk-label]").textContent=risk<22?"LOW":risk<42?"MED":risk<62?"HIGH":"VERY HIGH";q("[data-diagnosis]").innerHTML='<div><span>リスク</span><b>'+risk+'/100</b></div><div><span>分散度</span><b>'+div+'/100</b></div><div><span>含み損益</span><b class="'+(totalUnrealized()>=0?'up':'down')+'">'+(totalUnrealized()>=0?'+':'')+yen(totalUnrealized())+'</b></div><div><span>現金比率</span><b>'+Math.round(s.cash/t*100)+'%</b></div>'}
function renderRecords(){const score=Math.round(portfolioReturn()*10+alpha()*8+diversification()*.8-Math.abs(maxDrawdown())*3+s.dividend/5000);q("[data-score]").textContent=score+' pt';q("[data-record-grid]").innerHTML='<div><span>総リターン</span><b>'+portfolioReturn().toFixed(1)+'%</b></div><div><span>市場指数</span><b>'+benchmarkReturn().toFixed(1)+'%</b></div><div><span>ALPHA</span><b class="'+(alpha()>=0?'up':'down')+'">'+(alpha()>=0?'+':'')+alpha().toFixed(1)+'%</b></div><div><span>実現損益</span><b>'+yen(s.realized)+'</b></div><div><span>配当累計</span><b>'+yen(s.dividend)+'</b></div><div><span>最大DD</span><b>'+maxDrawdown().toFixed(1)+'%</b></div>';q("[data-log]").innerHTML=s.log.slice(-12).reverse().map((x:string)=>'<li>'+x+'</li>').join('');q("[data-log-month]").textContent='YEAR '+Math.ceil(s.month/12);q("[data-year-history]").innerHTML=s.yearHistory.length?s.yearHistory.map((y:any)=>'<div><b>YEAR '+y.year+'</b><span>資産 '+yen(y.value)+'</span><span class="'+(y.ret>=0?'up':'down')+'">'+(y.ret>=0?'+':'')+y.ret.toFixed(1)+'%</span><span>指数 '+(y.bench>=0?'+':'')+y.bench.toFixed(1)+'%</span></div>').join(''):'<p>12か月経過すると年次成績が記録されます。</p>'}
function chartData(){return qs("[data-chart-select]").value==="benchmark"?s.benchmarkHistory:s.portfolioHistory}function drawChart(){const arr=chartData().slice(-36);if(arr.length<2){q("[data-chart-points]").setAttribute("points","0,95 600,95");return}const min=Math.min(...arr),max=Math.max(...arr),span=Math.max(1,max-min);q("[data-chart-points]").setAttribute("points",arr.map((v:number,i:number)=>(i/(arr.length-1)*600)+','+(175-(v-min)/span*160)).join(' '))}
function render(){const t=total(),ret=portfolioReturn(),ev=events[s.eventIndex],risk=riskScore(),ipo=nextIpo();q("[data-game-over]").hidden=!s.complete;if(s.complete){q("[data-final-assets]").textContent=yen(t)+" / "+portfolioReturn().toFixed(1)+"%";q("[data-final-comment]").textContent=alpha()>12?"市場平均を大きく上回りました。企業分析と配分が噛み合った5年間です。":alpha()>0?"市場平均を上回って完走。次は下落局面でのリスク管理を磨けます。":"5年間完走。企業価値・現金比率・分散を変えて再挑戦できます。";q("[data-final-stats]").innerHTML='<span>ALPHA <b>'+alpha().toFixed(1)+'%</b></span><span>最大DD <b>'+maxDrawdown().toFixed(1)+'%</b></span><span>配当 <b>'+yen(s.dividend)+'</b></span><span>実現損益 <b>'+yen(s.realized)+'</b></span>';}root.dataset.marketMonth=String(s.month);q("[data-best]").textContent=readBest()?yen(readBest()):"---";q("[data-year]").textContent=Math.ceil(s.month/12)+'年目';q("[data-month]").textContent=s.month+' / 60';q("[data-assets]").textContent=yen(t);q("[data-return]").textContent=(ret>=0?'+':'')+ret.toFixed(1)+'%';q("[data-return]").className=ret>=0?'up':'down';q("[data-cash]").textContent=yen(s.cash);q("[data-cash-ratio]").textContent='現金 '+Math.round(s.cash/t*100)+'%';q("[data-unrealized]").textContent=(totalUnrealized()>=0?'+':'')+yen(totalUnrealized());q("[data-realized]").textContent='実現 '+(s.realized>=0?'+':'')+yen(s.realized);q("[data-dividend]").textContent=yen(s.dividend);q("[data-fee]").textContent='手数料 '+yen(s.fees);q("[data-rate]").textContent=s.rate.toFixed(2)+'%';q("[data-inflation]").textContent=s.inflation.toFixed(1)+'%';q("[data-growth]").textContent=s.growth.toFixed(1)+'%';q("[data-cycle]").textContent=s.regime;q("[data-regime]").textContent=ev.name;q("[data-benchmark]").textContent=s.benchmark.toFixed(1);q("[data-alpha]").textContent='α '+(alpha()>=0?'+':'')+alpha().toFixed(1)+'%';q("[data-news]").textContent=ev.text;q("[data-sentiment]").textContent=ev.sent;q("[data-outlook]").textContent='次月見通し：'+(s.rate>=2.5?'金利高止まり。財務とバリュエーションを確認。':s.growth<.5?'景気減速。守備力と現金比率に注目。':'決算と景気データを見ながら配分を調整。');(root.querySelector<HTMLMeterElement>("[data-risk-meter]")!).value=risk;q("[data-risk-score]").textContent=String(risk);q("[data-macro-impact]").innerHTML='<span>金利 '+s.rate.toFixed(2)+'%</span><span>CPI '+s.inflation.toFixed(1)+'%</span><span>GDP '+s.growth.toFixed(1)+'%</span>';q("[data-peak]").textContent='最高 '+yen(Math.max(...s.portfolioHistory,t));q("[data-drawdown]").textContent='最大DD '+maxDrawdown().toFixed(1)+'%';q("[data-volatility]").textContent='変動率 '+volatility().toFixed(1)+'%';q("[data-diversification]").textContent='分散 '+diversification();q("[data-trade-count]").textContent='取引 '+s.trades+'回';if(ipo){q("[data-ipo-name]").textContent=ipo.name+' / '+ipo.sector;q("[data-ipo-info]").textContent='M'+ipo.ipoMonth+' 上場予定・公開価格 '+yen(ipo.ipoPrice);qb("[data-ipo-reserve]").disabled=s.ipoReservations.includes(ipo.id)||s.cash<ipo.ipoPrice*10;qb("[data-ipo-reserve]").textContent=s.ipoReservations.includes(ipo.id)?'申込済み':'10口申込 '+yen(ipo.ipoPrice*10)}else{q("[data-ipo-name]").textContent='予定なし';q("[data-ipo-info]").textContent='今後の上場予定はありません';qb("[data-ipo-reserve]").disabled=true}qs("[data-research-select]").innerHTML=listed().map((a:Asset)=>'<option value="'+a.id+'">'+a.name+'｜'+a.sector+'</option>').join('');if(!listed().some((a:Asset)=>a.id===s.selected))s.selected=listed()[0].id;qs("[data-research-select]").value=s.selected;renderMarket();renderResearch();renderPortfolio();renderRecords();drawChart()}
function setTab(tab:string){root.querySelectorAll<HTMLButtonElement>("[data-invest-tab]").forEach(b=>b.classList.toggle('active',b.dataset.investTab===tab));root.querySelectorAll<HTMLElement>("[data-invest-panel]").forEach(p=>p.hidden=p.dataset.investPanel!==tab)}
function bindTrades(){root.querySelectorAll<HTMLButtonElement>("[data-buy]").forEach(b=>b.onclick=()=>trade(b.dataset.buy!,1));root.querySelectorAll<HTMLButtonElement>("[data-sell]").forEach(b=>b.onclick=()=>trade(b.dataset.sell!,-1))}
function trade(id:string,side:number){const a=asset(id),qty=Number(qs("[data-qty]").value);if(!a||!a.listed)return;const gross=a.price*qty,fee=Math.max(20,Math.round(gross*.002));if(side>0){if(gross+fee>s.cash)return void(q("[data-result]").textContent="現金が足りません。手数料も含めて確認してください。");const old=a.holding;a.avg=(a.avg*old+gross)/(old+qty);a.holding+=qty;s.cash-=gross+fee;s.log.push(a.name+' '+qty+'口購入 / '+yen(gross+fee))}else{if(qty>a.holding)return void(q("[data-result]").textContent="保有口数が足りません。");const profit=(a.price-a.avg)*qty-fee;s.realized+=profit;a.holding-=qty;s.cash+=gross-fee;if(!a.holding)a.avg=0;s.log.push(a.name+' '+qty+'口売却 / 実現 '+(profit>=0?'+':'')+yen(profit))}s.fees+=fee;s.trades++;q("[data-result]").textContent=a.name+(side>0?'を購入':'を売却')+'。';save(s);render()}
function earnings(){for(const a of listed()){if(a.sector==="債券")continue;a.quarter=(a.quarter%4)+1;const cycle=s.growth*.9-s.inflation*.15,noise=ri(-9,9),sector=eventImpact(a,events[s.eventIndex])*80,surprise=clamp(cycle+noise+sector,-20,24);a.surprise=surprise;a.growth=clamp(a.growth+surprise*.08,-12,45);a.margin=clamp(a.margin+surprise*.035,-15,38);a.eps=clamp(a.eps*(1+surprise/100*.55),-30,180);a.revenue=Math.max(100,a.revenue*(1+(a.growth/100)/4));a.quality=clamp(a.quality+(surprise>7?1:surprise<-8?-1:0),40,95);a.price=Math.max(100,Math.round(a.price*(1+surprise/100*.12)));s.log.push(a.name+' Q'+a.quarter+' 決算 '+(surprise>=0?'+':'')+surprise.toFixed(1)+'%')}}
function processIpo(){for(const a of s.assets.filter((x:Asset)=>!x.listed&&x.ipoMonth===s.month)){a.listed=true;a.price=a.ipoPrice;a.prev=a.ipoPrice;a.history=[a.ipoPrice];if(s.ipoReservations.includes(a.id)){const qty=10,cost=a.ipoPrice*qty;if(s.cash>=cost){a.holding=qty;a.avg=a.ipoPrice;s.cash-=cost;s.log.push('IPO当選 '+a.name+' 10口 / '+yen(cost))}}s.log.push(a.name+' が新規上場')}}
function payDividends(){let d=0;for(const a of listed()){if(a.holding&&a.divYield>0){const x=a.holding*a.price*(a.divYield/100)/4;d+=x}}s.cash+=d;s.dividend+=d;if(d>0)s.log.push('四半期配当 '+yen(d));return d}
function stepMonth(){if(s.complete)return;if(s.month>=60){finish();return}for(const a of listed())a.prev=a.price;s.month++;const ev=events[pickEvent()];s.eventIndex=events.indexOf(ev);s.rate=clamp(s.rate+(ev.macro.rate||0),0,5);s.inflation=clamp(s.inflation+(ev.macro.inflation||0)+(Math.random()-.5)*.12,-.5,6);s.growth=clamp(s.growth+(ev.macro.growth||0)+(Math.random()-.5)*.18,-2.5,5);updateRegime();for(const a of listed()){const vol=.025*a.beta,noise=(Math.random()-.5)*2*vol,quality=(a.quality-70)*.0002,fund=(a.growth*.00008)+(a.margin*.000025)+(a.surprise*.00025),move=.001+eventImpact(a,ev)+noise+quality+fund;a.price=Math.max(100,Math.round(a.price*(1+move)));a.history.push(a.price)}if(s.month%3===0){earnings();payDividends()}processIpo();const benchMove=listed().reduce((x:number,a:Asset)=>x+(a.price/a.prev-1),0)/listed().length;s.benchmark=Math.max(30,s.benchmark*(1+benchMove));s.benchmarkHistory.push(s.benchmark);s.portfolioHistory.push(total());if(s.month%12===0){const value=total(),ret=(value/s.lastYearValue-1)*100,bench=(s.benchmark/(s.benchmarkHistory[Math.max(0,s.benchmarkHistory.length-13)]||100)-1)*100;s.yearHistory.push({year:s.month/12,value,ret,bench});s.lastYearValue=value;s.log.push('YEAR '+s.month/12+' 終了 / '+(ret>=0?'+':'')+ret.toFixed(1)+'%')}q("[data-result]").textContent=ev.name+'。総資産 '+yen(total());save(s);render()}
function rebalance(mode:string){const targets:any={defensive:{bond:.35,med:.18,harbor:.15,estate:.1,atlas:.07,finx:.05,nova:.05,green:.05},balanced:{bond:.18,med:.13,harbor:.12,estate:.1,atlas:.12,finx:.1,nova:.15,green:.1},growth:{bond:.06,med:.08,harbor:.07,estate:.06,atlas:.10,finx:.09,nova:.23,green:.13,orbit:.09,quant:.09}};const target=targets[mode],t=total();for(const a of listed()){if(a.holding){const gross=a.holding*a.price,fee=Math.max(20,Math.round(gross*.002));s.cash+=gross-fee;s.realized+=(a.price-a.avg)*a.holding-fee;s.fees+=fee;a.holding=0;a.avg=0;s.trades++}}for(const [id,pct] of Object.entries(target)){const a=asset(id);if(!a?.listed)continue;const budget=t*Number(pct),qty=Math.floor(budget/a.price);if(qty<=0)continue;const gross=qty*a.price,fee=Math.max(20,Math.round(gross*.002));if(gross+fee<=s.cash){a.holding=qty;a.avg=a.price;s.cash-=gross+fee;s.fees+=fee;s.trades++}}s.log.push((mode==='defensive'?'守備型':mode==='balanced'?'分散型':'成長型')+'へリバランス');save(s);render()}
function finish(){const t=total();s.complete=true;saveBest(t);root.dataset.state="complete";q("[data-game-over]").hidden=false;q("[data-final-assets]").textContent=yen(t)+' / '+portfolioReturn().toFixed(1)+'%';q("[data-final-comment]").textContent=alpha()>12?"市場平均を大きく上回りました。企業分析と配分が噛み合った5年間です。":alpha()>0?"市場平均を上回って完走。次は下落局面でのリスク管理を磨けます。":"5年間完走。企業価値・現金比率・分散を変えて再挑戦できます。";q("[data-final-stats]").innerHTML='<span>ALPHA <b>'+alpha().toFixed(1)+'%</b></span><span>最大DD <b>'+maxDrawdown().toFixed(1)+'%</b></span><span>配当 <b>'+yen(s.dividend)+'</b></span><span>実現損益 <b>'+yen(s.realized)+'</b></span>';q("[data-result]").textContent="5年間終了！ 最終資産 "+yen(t)+" / ALPHA "+alpha().toFixed(1)+"%";save(s);render()}
function start(load=false){s=load&&read()?read():fresh();intro.hidden=true;play.hidden=false;root.dataset.state=s.complete?'complete':'running';render();save(s)}
qb("[data-start]").onclick=()=>start(false);const cont=qb("[data-continue]");cont.hidden=!read();cont.onclick=()=>start(true);qb("[data-restart]").onclick=()=>{clear();start(false)};qb("[data-next-month]").onclick=stepMonth;qs("[data-chart-select]").onchange=drawChart;qs("[data-sort]").onchange=renderMarket;qs("[data-research-select]").onchange=()=>{s.selected=qs("[data-research-select]").value;save(s);renderResearch()};root.querySelectorAll<HTMLButtonElement>("[data-invest-tab]").forEach(b=>b.onclick=()=>setTab(b.dataset.investTab!));root.querySelectorAll<HTMLButtonElement>("[data-rebalance]").forEach(b=>b.onclick=()=>rebalance(b.dataset.rebalance!));qb("[data-ipo-reserve]").onclick=()=>{const ipo=nextIpo();if(!ipo||s.ipoReservations.includes(ipo.id)||s.cash<ipo.ipoPrice*10)return;s.ipoReservations.push(ipo.id);s.log.push('IPO申込 '+ipo.name+' 10口');save(s);render()};qb("[data-new-cycle]").onclick=()=>{const oldTotal=total();s=fresh();s.cycle=(s.cycle||1)+1;s.initialCapital=oldTotal;s.cash=oldTotal;s.portfolioHistory=[oldTotal];s.lastYearValue=oldTotal;root.dataset.state="running";q("[data-game-over]").hidden=true;save(s);render()};
render();
</script>
