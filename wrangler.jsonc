{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "utility-tools",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULES",
        "class_name": "ScheduleRoom"
      },
      {
        "name": "SHARED_TOOLS",
        "class_name": "SharedToolRoom"
      },
      {
        "name": "GAME_METRICS",
        "class_name": "GameMetrics"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ScheduleRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SharedToolRoom"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "GameMetrics"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "API_CREATE_RATE_LIMITER",
      "namespace_id": "731401",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "API_MUTATION_RATE_LIMITER",
      "namespace_id": "731402",
      "simple": {
        "limit": 180,
        "period": 60
      }
    },
    {
      "name": "API_REPORT_RATE_LIMITER",
      "namespace_id": "731405",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_GAME_RATE_LIMITER",
      "namespace_id": "731403",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "API_READ_RATE_LIMITER",
      "namespace_id": "731404",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
