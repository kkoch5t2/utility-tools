{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "utility-tools",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULES",
        "class_name": "ScheduleRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScheduleRoom"]
    }
  ]
}
